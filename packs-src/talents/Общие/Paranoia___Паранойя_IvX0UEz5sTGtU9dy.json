              "weaponPropNewValue": "1",
              "weaponPropNewValue2": "0",
              "label": "Тайный тест на угрозу (P или Awareness, видит только ГМ)",
              "code": "// Паранойя (стр. 62): «ГМ может тайно провести Тест на P или Awareness, чтобы узнать, ощутил ли персонаж скрытую угрозу».\n// Бросок за персонажа d100 против лучшего из P и Awareness; результат шепчется только ГМу.\nconst per = Number(actor.system?.characteristics?.per?.total) || 0;\nconst aw = Number(actor.system?.skills?.awareness?.total);\nconst useAw = Number.isFinite(aw) && aw > per;\nconst threshold = useAw ? aw : per;\nconst roll = await new Roll(\"1d100\").evaluate();\nconst ok = roll.total <= threshold;\nconst deg = ok ? Math.max(1, Math.floor((threshold - roll.total) / 10) + 1) : Math.floor((roll.total - threshold) / 10) + 1;\nawait ChatMessage.create({\n  speaker,\n  whisper: ChatMessage.getWhisperRecipients(\"GM\").map(u => u.id),\n  content: `<div class=\"wh-roll-result\">\n    <div class=\"roll-header\">Паранойя (тайно) — ${actor.name}</div>\n    <div class=\"roll-dice\">Бросок: <b>${roll.total}</b> против ${useAw ? \"Awareness\" : \"P\"} <b>${threshold}</b></div>\n    <div class=\"roll-outcome\">${ok ? `<span class=\"roll-success\">Успех — ${deg} ст.: персонаж ощутил скрытую угрозу</span>` : `<span class=\"roll-failure\">Провал — ${deg} ст.: ничего не почувствовал</span>`}</div>\n    <div class=\"roll-threshold\">Видно только ГМу: сообщите игроку результат сами.</div>\n  </div>`\n});",
              "when": {
                "negate": false,
                "conditions": []
              },
