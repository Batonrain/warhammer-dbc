              "label": "Неизлечимое расстройство «Ненависть»",
              "code": "// Мстительный (корбук, Ревенант): «Ненависть» на Тяжести 0, не ниже 0; предел растёт на 1 за каждую Стадию Пакта (rules/pact-disorder.mjs).\n// Повторный запуск расстройство не дублирует — только подтягивает нижний предел (sheets/tabs/disorders.mjs).\nconst res = await grantStartingDisorder(actor, item, { name: \"Ненависть\", severity: 0, severityMin: 0, incurable: true, pactScaled: true, label: \"Мстительный\" });\nif (!res.ok) ui.notifications?.info(res.reason);\nconst text = item.system?.benefit || item.system?.description || \"\";\nawait ChatMessage.create({ speaker: ChatMessage.getSpeaker({ actor }), content: `<div class=\"wh-roll-result\"><div class=\"roll-header\">${item.name}</div><div class=\"roll-threshold\">${text}</div></div>` });",
