              "label": "Сфокусированный взор (полное действие)",
              "code": "// Взор Неизбежности / Gaze of Inevitability (Дар Нургла, wdbc-1rno) —\n// ПОЛОВИНА «сфокусированного взора»: полное действие, одна цель, тест W−30,\n// провал — цель теряет все Реакции.\n// Пассивная половина («все, видящие глаза чемпиона, комбинируют Избегание с\n// W−10») здесь НЕ реализована: она требует второго теста внутри чужого\n// Избегания на каждую попытку, а это крюк в общем конвейере защиты, а не\n// кнопка. Остаток честно отмечен в реестре Возможностей.\nconst casterTokenDoc = token?.document ?? token;\nconst targetDoc = game.user.targets?.first?.() ?? [...(game.user.targets ?? [])][0];\nconst targetTokenDoc = targetDoc?.document ?? targetDoc;\n\nif (!casterTokenDoc?.parent) {\n  ui.notifications?.warn(\"Взор Неизбежности: у персонажа нет токена на текущей сцене.\");\n} else if (!targetTokenDoc?.actor) {\n  ui.notifications?.warn(\"Взор Неизбежности: выберите одну цель.\");\n} else {\n  const scene = casterTokenDoc.parent;\n  // Цель обязана ВИДЕТЬ глаза чемпиона — то же геометрическое приближение\n  // (дальность + сектор обзора токена), что у Иконы Богохульства: стены и\n  // темнота не учитываются, полноценный LoS вне отрендеренного canvas\n  // недоступен.\n  const sees = tokensThatCanSee(casterTokenDoc, [targetTokenDoc], scene.grid).length > 0;\n  if (!sees) {\n    ui.notifications?.warn(`Взор Неизбежности: ${targetTokenDoc.actor.name} не видит глаз чемпиона (дальность/сектор обзора).`);\n  } else {\n    const targetActor = targetTokenDoc.actor;\n    const wp = Number(targetActor.system?.characteristics?.wp?.total) || 0;\n    const threshold = wp - 30;\n    const roll = await new Roll(\"1d100\").evaluate();\n    const failed = roll.total > threshold;\n    let line;\n    if (failed) {\n      await targetActor.update({ \"system.reactions.value\": 0, \"system.reactions.defenseValue\": 0 });\n      line = `<span class=\"roll-failure\">Провал — все Реакции потеряны.</span>`;\n    } else {\n      line = `<span class=\"roll-success\">Успех — Реакции сохранены.</span>`;\n    }\n    await ChatMessage.create(ChatMessage.applyRollMode({\n      speaker,\n      content: `<div class=\"wh-roll-result\">\n        <div class=\"roll-header\">Взор Неизбежности — ${actor.name} → ${targetActor.name}</div>\n        <div class=\"roll-threshold\">Тест W−30 — порог <b>${threshold}</b> (W ${wp}), бросок <b>${roll.total}</b></div>\n        <div class=\"roll-threshold\">${line}</div>\n      </div>`,\n      rolls: [roll]\n    }, game.settings.get(\"core\", \"rollMode\")));\n  }\n}",
              "scriptThrottleUnit": "",
              "scriptThrottleMax": 0,
              "when": {
                "negate": false,
                "conditions": []
              }
            }
