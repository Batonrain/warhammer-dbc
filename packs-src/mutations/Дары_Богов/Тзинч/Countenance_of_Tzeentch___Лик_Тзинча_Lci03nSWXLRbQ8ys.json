              "weaponPropNewValue": "1",
              "weaponPropNewValue2": "0",
              "label": "Лик Тзинча — усиленное сходство (Страх 3)",
              "code": "const godKey = \"tzeentch\";\nif (actorInfamyValue(actor) < 1) {\n  ui.notifications.warn(\"Лик Тзинча: нет Очка Бесчестия для усиления сходства.\");\n} else {\n  await changeActorInfamy(actor, -1);\n  const flag = buildCountenanceFearFlag(godKey, Number(game.combat?.round) || null);\n  await actor.setFlag(\"warhammer-dbc\", \"countenanceOfGods\", flag);\n  await ChatMessage.create(ChatMessage.applyRollMode({\n    speaker,\n    content: `<div class=\"wh-roll-result\">\n      <div class=\"roll-header\">Лик Тзинча — ${actor.name}</div>\n      <div class=\"roll-threshold\">Свободное действие, −1 Очко Бесчестия: сходство усилено до предела — рейтинг Страха <b>3</b> ${flag.restriction}.</div>\n      <div class=\"roll-threshold\">Не действует на ${flag.excludeLabel}.</div>\n      <div class=\"roll-threshold\">${flag.specialLabel}, провалившие тест на Страх от него: ${flag.specialText}.</div>\n    </div>`\n  }, game.settings.get(\"core\", \"rollMode\")));\n}",
              "scriptThrottleUnit": "",
              "scriptThrottleMax": 1,
              "when": {
                "negate": false,
                "conditions": []
              }
            }
          ]
