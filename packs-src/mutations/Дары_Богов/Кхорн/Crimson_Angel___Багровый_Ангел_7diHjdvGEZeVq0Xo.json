              "label": "Получить Трейт Flyer (видит Ненавистную цель)",
              "code": "// Crimson Angel / Багровый Ангел (Дар Кхорна, wdbc-1rno) — половина\n// «выдача»: видимая Ненавистная цель → Трейт Flyer (A.b×2). Снятие —\n// отдельная кнопка «Снять Flyer» рядом (эта же запись, следующая в списке):\n// книжное условие потери («двигался к цели/атаковал её в рукопашной»)\n// система не умеет проверить программно — turn-flags.mjs не хранит ЦЕЛЬ\n// движения/атаки, только сам факт «двигался хоть куда-то»/«атаковал хоть\n// кем-то». Игрок/ГМ следят за условием сами и жмут «Снять Flyer».\nconst casterTokenDoc = token?.document ?? token;\nif (!casterTokenDoc?.parent) {\n  ui.notifications?.warn(\"Багровый Ангел: у персонажа нет токена на текущей сцене.\");\n} else {\n  const already = (actor.items ?? []).find(i => i.type === \"trait\" && i.getFlag?.(\"warhammer-dbc\", \"crimsonAngelGrant\"));\n  if (already) {\n    ui.notifications?.info(\"Багровый Ангел: Трейт Flyer уже выдан.\");\n  } else {\n    const nearest = nearestVisibleHatredTarget(casterTokenDoc, actor);\n    if (!nearest) {\n      ui.notifications?.warn(\"Багровый Ангел: нет видимой Ненавистной цели.\");\n    } else {\n      const agB = Number(actor.system?.characteristics?.ag?.bonus) || 0;\n      const rating = agB * 2;\n      await actor.createEmbeddedDocuments(\"Item\", [{\n        name: \"Flyer / Летун\", type: \"trait\", img: item.img,\n        system: {\n          hasRating: true, rating,\n          notes: \"Багровый Ангел: снимается, если в свой Ход не двигались к Ненавистному врагу и не атаковали его в рукопашной — следить самому/ГМ, кнопка «Снять Flyer» на этом же Даре.\"\n        },\n        flags: { \"warhammer-dbc\": { crimsonAngelGrant: true } }\n      }]);\n      await ChatMessage.create(ChatMessage.applyRollMode({\n        speaker,\n        content: `<div class=\"wh-roll-result\">\n          <div class=\"roll-header\">Багровый Ангел — ${actor.name}</div>\n          <div class=\"roll-threshold\">Видит Ненавистную цель (${nearest.token.actor?.name ?? \"?\"}) — получает Трейт Flyer (${rating}).</div>\n        </div>`\n      }, game.settings.get(\"core\", \"rollMode\")));\n    }\n  }\n}"
            },
