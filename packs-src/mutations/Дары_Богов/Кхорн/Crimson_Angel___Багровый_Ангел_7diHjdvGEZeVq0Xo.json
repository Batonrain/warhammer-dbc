              },
              "label": "Снять Трейт Flyer",
              "code": "// Багровый Ангел — половина «снятие»: убирает ТОЛЬКО Трейт, выданный этим\n// же Даром (флаг crimsonAngelGrant), не любой чужой Flyer персонажа.\nconst granted = (actor.items ?? []).filter(i => i.type === \"trait\" && i.getFlag?.(\"warhammer-dbc\", \"crimsonAngelGrant\"));\nif (!granted.length) {\n  ui.notifications?.info(\"Багровый Ангел: Трейт Flyer сейчас не выдан.\");\n} else {\n  await actor.deleteEmbeddedDocuments(\"Item\", granted.map(i => i.id));\n  await ChatMessage.create(ChatMessage.applyRollMode({\n    speaker,\n    content: `<div class=\"wh-roll-result\">\n      <div class=\"roll-header\">Багровый Ангел — ${actor.name}</div>\n      <div class=\"roll-threshold\">Трейт Flyer снят.</div>\n    </div>`\n  }, game.settings.get(\"core\", \"rollMode\")));\n}"
