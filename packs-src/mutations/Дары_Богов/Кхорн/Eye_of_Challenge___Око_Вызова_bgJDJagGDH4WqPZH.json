              "label": "Око Вызова — сконцентрироваться на цели",
              "code": "// Eye of Challenge / Око Вызова (Дар Кхорна, d100 92..94, wdbc-1rno).\n// Книга: «...сконцентрироваться на одном из них, чтобы узнать его WS, S,\n// уровень изучения Навыка Parry, а также владение Талантами группы\n// «Берсерк»..., но если в течение минуты он не бросит вызов этому персонажу,\n// чемпион получит 2d10+8 урона в W». Выбор 4 сильнейших воинов из всех\n// видимых — решение ГМа за столом (см. capability-запись этого же предмета);\n// эта кнопка начинается с того, что цель УЖЕ выбрана — обычным таргетингом\n// Foundry. Срок в 60 секунд читает module/combat/eye-of-challenge.mjs на\n// updateWorldTime/updateCombat (hooks.mjs) — тот же приём, что temp-grant.\nconst casterTokenDoc = token?.document ?? token;\nconst targetDoc = game.user.targets?.first?.() ?? [...(game.user.targets ?? [])][0];\nconst targetTokenDoc = targetDoc?.document ?? targetDoc;\n\nif (!casterTokenDoc?.parent) {\n  ui.notifications?.warn(\"Око Вызова: у персонажа нет токена на текущей сцене.\");\n} else if (!targetTokenDoc?.actor) {\n  ui.notifications?.warn(\"Око Вызова: выберите одну цель.\");\n} else {\n  const scene = casterTokenDoc.parent;\n  const sees = isTokenInSight(casterTokenDoc, targetTokenDoc, scene.grid);\n  if (!sees) {\n    ui.notifications?.warn(`Око Вызова: ${targetTokenDoc.actor.name} вне поля зрения чемпиона (дальность/сектор обзора).`);\n  } else {\n    const targetActor = targetTokenDoc.actor;\n    const RANK_LABELS = {\n      untrained: \"Нетренированное\", knows: \"Знает\", trained: \"Тренированное\",\n      veteran: \"Опытный\", expert: \"Ветеран\"\n    };\n    const ws = Number(targetActor.system?.characteristics?.ws?.total) || 0;\n    const s = Number(targetActor.system?.characteristics?.s?.total) || 0;\n    const parryRank = targetActor.system?.skills?.parry?.rank || \"untrained\";\n    const berserkTalents = (targetActor.items ?? [])\n      .filter(i => i.type === \"talent\" && talentGroupOf(i.name)?.folder === \"Берсерк\")\n      .map(i => i.name);\n\n    // Срок ставит модуль (combat/eye-of-challenge.mjs), а не этот скрипт:\n    // «минута» и её пересчёт в Раунды боя должны жить в одном месте — том же,\n    // где штраф за просрочку и считается (wdbc-lhd).\n    await startEyeOfChallenge(actor, {\n      targetUuid: targetActor.uuid,\n      targetName: targetActor.name,\n      worldTime: game.time.worldTime,\n      combat: game.combat\n    });\n\n    await ChatMessage.create(ChatMessage.applyRollMode({\n      speaker,\n      content: `<div class=\"wh-roll-result\">\n        <div class=\"roll-header\">Око Вызова — ${actor.name} → ${targetActor.name}</div>\n        <div class=\"roll-threshold\">WS <b>${ws}</b>, S <b>${s}</b>, Parry: <b>${RANK_LABELS[parryRank] || parryRank}</b></div>\n        <div class=\"roll-threshold\">Таланты группы «Берсерк»: ${berserkTalents.length ? berserkTalents.join(\", \") : \"нет\"}</div>\n        <div class=\"roll-threshold\">Если чемпион не бросит вызов ${targetActor.name} в течение минуты — 2d10+8 непоглощаемого урона в Раны.</div>\n      </div>`\n    }, game.settings.get(\"core\", \"rollMode\")));\n  }\n}",
              "scriptThrottleUnit": "",
