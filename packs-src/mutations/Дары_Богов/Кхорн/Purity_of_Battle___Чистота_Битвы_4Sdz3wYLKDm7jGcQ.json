              "weaponPropNewValue2": "0",
              "label": "Чистота Битвы",
              "code": "const casterTokenDoc = token?.document ?? token;\nif (!casterTokenDoc?.parent) {\n  ui.notifications?.warn(\"Чистота Битвы: у персонажа нет токена на текущей сцене.\");\n} else {\n  const radius = Number(actor.system?.corruptionBonus) || 0;\n  const summaries = await purityOfBattleWave(casterTokenDoc, radius);\n  const lines = summaries.map(s => {\n    const parts = [];\n    if (s.drugs.length) parts.push(\"наркотики: \" + s.drugs.join(\", \"));\n    if (s.powers.length) parts.push(\"психосилы: \" + s.powers.join(\", \"));\n    return s.name + \" — \" + parts.join(\"; \");\n  });\n  await ChatMessage.create(ChatMessage.applyRollMode({\n    speaker,\n    content: `<div class=\"wh-roll-result\">\n      <div class=\"roll-header\">Чистота Битвы — ${actor.name}</div>\n      <div class=\"roll-threshold\">Полное действие: сферическая волна радиусом ${radius}м.</div>\n      <div class=\"roll-threshold\">${lines.length ? lines.join(\"<br>\") : \"Ни у кого в радиусе не было активных наркотиков/психосил, снимать нечего.\"}</div>\n      <div class=\"roll-threshold\">Техночудеса эта волна не снимает — в системе у них нет отслеживаемого состояния «поддерживается». Затронутые не могут подвергаться снятым эффектам ПОВТОРНО до конца боя/сцены — отметьте это условие вручную.</div>\n    </div>`\n  }, game.settings.get(\"core\", \"rollMode\")));\n}",
              "scriptThrottleUnit": "",
              "scriptThrottleMax": 1,
              "when": {
                "negate": false,
                "conditions": []
              }
            }
