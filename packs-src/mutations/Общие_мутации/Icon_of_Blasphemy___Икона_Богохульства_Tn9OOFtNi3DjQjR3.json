              "label": "Проявить Икону Богохульства (1 Раунд)",
              "code": "// wdbc-1rno: ручная кнопка. Таргетинг — геометрический (дальность+сектор\n// обзора токена, rules/vision-target.mjs), БЕЗ стен/темноты — честное\n// приближение, не полный LoS (canvas.visibility недоступен вне отрендеренного\n// canvas). Канал «засекли Пси-чутьём/Ноосферным Сканированием» — отдельная\n// нецелевая детекция, не смоделирован (нет надёжного способа узнать, у кого\n// прямо сейчас активна такая проверка). «Считает только чемпиона врагом» —\n// поведение ИИ цели, не состояние актора — не автоматизируется, только чат-заметка.\nconst casterTokenDoc = token?.document ?? token;\nif (!casterTokenDoc || !casterTokenDoc.parent) {\n  ui.notifications?.warn(\"Икона Богохульства: у персонажа нет токена на текущей сцене.\");\n} else {\n  const scene = casterTokenDoc.parent;\n  const byKey = getFactionIndex();\n  const candidates = scene.tokens.contents.filter(t => t.id !== casterTokenDoc.id && t.actor\n    && anySameOrDescendant(actorFactionKeys(t.actor), \"imperium\", byKey));\n  const seers = tokensThatCanSee(casterTokenDoc, candidates, scene.grid);\n  const lines = [];\n  for (const seerDoc of seers) {\n    const seerActor = seerDoc.actor;\n    const wp = Number(seerActor.system?.characteristics?.wp?.total) || 0;\n    const roll = await new Roll(\"1d100\").evaluate();\n    const success = roll.total <= wp;\n    let note = success ? \"тест пройден\" : \"провал\";\n    if (!success && \"inRage\" in (seerActor.system || {})) {\n      await seerActor.update({ \"system.inRage\": true });\n      note += \" — Ярость (считает чемпиона единственным врагом, отыграть вручную)\";\n    }\n    lines.push(`${seerActor.name}: W ${wp} vs ${roll.total} — ${note}`);\n  }\n  await ChatMessage.create({ speaker,\n    content: `<b>Икона Богохульства:</b> иллюзия на 1 Раунд.<br>${seers.length ? lines.join(\"<br>\") : \"Ни один видящий Имперец не найден в пределах дальности/сектора обзора.\"}<br><i>Пси-чутьё/Ноосферное Сканирование не проверены — отдельный канал, не автоматизирован.</i>` });\n}",
              "scriptThrottleUnit": "battle",
              "scriptThrottleMax": 1,
              "scriptTrigger": "",
              "when": {
                "negate": false,
                "conditions": []
              }
            }
          ]
