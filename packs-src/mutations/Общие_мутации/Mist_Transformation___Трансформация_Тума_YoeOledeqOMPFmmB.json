              "label": "Полудействие: превращение в дым (Incorporeal + Flyer)",
              "code": "// wdbc-1rno: ручная кнопка. Длительность/частота теперь автоматизированы\n// через rules/temp-grant.mjs (снятие на updateWorldTime/updateCombat,\n// module/hooks.mjs) — растворение союзников/движение облака/частота\n// «Cor.b раз в сутки» остаются на отыгрыш ГМа.\nconst agBonus = Number(actor.system.characteristics?.ag?.bonus) || 0;\nconst corBonus = Number(actor.system.corruptionBonus) || 0;\nconst norm = s => String(s || \"\").toLowerCase().replace(/\\s+/g, \" \").trim();\nconst already = actor.items.some(i => i.type === \"trait\" && norm(i.name.split(\"/\")[0]) === \"incorporeal\");\nif (already) {\n  ui.notifications?.warn(\"Трансформация Тумана: Incorporeal уже есть на акторе — сначала уберите вручную.\");\n} else {\n  const pack = game.packs.get(\"warhammer-dbc.traits\");\n  const lib = pack ? await pack.getDocuments() : [];\n  const byEng = new Map(lib.map(d => [norm(d.name.split(\"/\")[0]), d]));\n  const tempGrant = { unit: \"worldTime\", expiresAt: (Number(game.time?.worldTime) || 0) + corBonus * 60, label: \"Трансформация Тумана\" };\n  const toGrant = [];\n  const incorporeal = byEng.get(\"incorporeal\");\n  if (incorporeal) {\n    const d = incorporeal.toObject(); delete d._id;\n    d.flags = { ...(d.flags || {}), \"warhammer-dbc\": { ...(d.flags?.[\"warhammer-dbc\"] || {}), tempGrant } };\n    toGrant.push(d);\n  }\n  const flyer = byEng.get(\"flyer\");\n  if (flyer) {\n    const d = flyer.toObject(); delete d._id;\n    d.system.hasRating = true; d.system.rating = agBonus * 2;\n    d.flags = { ...(d.flags || {}), \"warhammer-dbc\": { ...(d.flags?.[\"warhammer-dbc\"] || {}), tempGrant } };\n    toGrant.push(d);\n  }\n  if (toGrant.length) await actor.createEmbeddedDocuments(\"Item\", toGrant);\n  await ChatMessage.create({ speaker,\n    content: `<b>Трансформация Тумана:</b> облако дыма, Incorporeal + Flyer(${agBonus * 2}) выданы на ${corBonus} мин. — снимутся автоматически.` });\n}",
              "scriptThrottleUnit": "",
              "scriptThrottleMax": 1,
              "scriptTrigger": "",
              "when": {
