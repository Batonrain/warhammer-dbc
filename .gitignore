# Исходники книг правил — не публикуются (единственный источник, tools/
# book-coverage.py::SOURCES; README.md в этой же папке — объясняет формат,
# остаётся под git).
sources/*
!sources/README.md

# Скомпилированные компендиумы: содержимое лежит в packs-src/, а packs/
# собирается из него — npm run packs:build (в релизе это делает CI).
packs/

# Рабочие файлы
_tmp_*.txt
reqs.txt
0

# Локальные настройки инструментов
.claude/settings.local.json
.codegraph/

# Системный мусор
.DS_Store
Thumbs.db
*.swp

# Артефакты сборки релиза
system.zip
node_modules/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Побочный продукт запуска скриптов скилов
__pycache__/

# Авто-снимок git status/diff, по файлу на session_id (Stop-хук .claude/tools/handoff.py)
.handoff/
.handoff.md

# Локальная отметка "pr-reviewer прошёл чисто на этом дереве" (worktree-local,
# не история — git-scribe сверяет свежесть перед пушем, см. .claude/tools/state-hash.sh)
/.agents/last-clean-review.json

# Рабочие материалы вне репозитория: исходники книг для транскрибации и
# дизайн-мокапы (skill doombc-mockup) — большие, локальные, не для публикации
/sources/
/design-mockups/
