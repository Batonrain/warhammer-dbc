# PDF правил — не публикуются
books/*.pdf

# Скомпилированные компендиумы: содержимое лежит в packs-src/, а packs/
# собирается из него — npm run packs:build (в релизе это делает CI).
packs/

# Рабочие файлы
_tmp_*.txt
reqs.txt
0

# Локальные настройки инструментов
.claude/settings.local.json
.codegraph/

# Системный мусор
.DS_Store
Thumbs.db
*.swp

# Артефакты сборки релиза
system.zip
node_modules/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Побочный продукт запуска скриптов скилов
__pycache__/

# Авто-снимок git status/diff для сессии «Гит» (Stop-хук .claude/tools/handoff.py)
.handoff.md

# Локальная отметка "pr-reviewer прошёл чисто на этом дереве" (worktree-local,
# не история — git-scribe сверяет свежесть перед пушем, см. .claude/tools/state-hash.sh)
/.agents/last-clean-review.json
