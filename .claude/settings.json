{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/tools/handoff.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/tools/scope-readonly-agents.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git push origin *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ]
  }
}
