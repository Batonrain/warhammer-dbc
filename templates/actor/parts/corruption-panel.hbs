{{!-- Панель ПОРЧА — вынесена из sanity-corruption-panels.hbs (wdbc-ycgk),
      см. комментарий в sanity-panel.hbs (та же причина, та же гарантия для
      Демона через sanity-corruption-panels.hbs). --}}
<div class="stat-panel panel-side corruption-panel" data-collapse-key="corruption-panel"> <div class="panel-title" data-action="panelCollapse">ПОРЧА <span class="side-code">// COR</span></div> <div class="panel-body side-body"> <div class="side-main-val"> <input type="number" name="system.corruption.value" value="{{system.corruption.value}}" min="0"/> <button type="button" class="stat-add-btn" data-action="statAdd" data-stat="corruption" title="Добавить Порчу (число или XdY+Z, напр. 2d10+3)">＋</button> </div> <div class="side-bar"><div class="side-fill load-{{corruptionLevel}}" style="width:{{corruptionPct}}%;"></div><span class="side-pct">{{corruptionPct}}%</span></div> <div class="side-bonus-row"> <span class="side-bonus-label">Бонус</span> <span class="side-bonus-val">{{system.corruptionBonus}}</span> </div> <div class="side-bonus-row"> <span class="side-bonus-label" title="База 100 + бонусы Путей">Лимит</span> <span class="side-bonus-val">{{system.corruption.limit}}</span> </div> <button type="button" class="side-roll-btn corruption-roll" title="Проверка Воли на Порчу"> Проверка
    </button> </div> </div>
