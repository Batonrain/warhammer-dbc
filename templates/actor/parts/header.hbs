<header class="sheet-header{{#if (eq system.alignment "heretic")}} chaos-aligned{{/if}}{{#if (eq system.alignment "loyalist")}} loyalist-aligned{{/if}}{{#if (eq system.alignment "renegade")}} renegade-aligned{{/if}}"> <div class="portrait-block"> <img class="profile-img" data-action="portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/> </div> <div class="header-main"> <div class="header-name-row"> <label class="header-label">Имя</label> <input class="actor-name" name="name" type="text" value="{{actor.name}}" placeholder="Имя персонажа"/> </div> <div class="header-grid"> <div class="header-rows">
    <div class="header-row-fixed header-row-race"> <div class="header-cell header-cell-slot"> <label>Раса</label> <div class="wh-slot{{#unless raceSlot}} empty{{/unless}}" data-slot="race"> {{#if raceSlot}}
            <img class="wh-slot-img" src="{{raceSlot.img}}" alt=""/> <span class="wh-slot-name{{#unless raceSlot.applied}} pending{{/unless}}">{{raceSlot.name}}</span> {{#if raceSlot.applied}}
              <button type="button" class="wh-slot-btn" data-action="raceOpen" title="Открыть лист расы">⤢</button> {{else}}
              <button type="button" class="wh-slot-btn" data-action="raceApply" title="Применить расу">Применить</button> {{/if}}
            <button type="button" class="wh-slot-btn" data-action="raceClear" title="Снять расу">✕</button> {{else}}
            <button type="button" class="wh-slot-add" data-action="racePick">+ перетащите или нажмите</button> {{/if}}
          </div> </div> <div class="header-cell header-cell-subrace"> <label>Субраса</label> <div class="subrace-controls"> <div class="wh-slot{{#unless subraceSlot}} empty{{/unless}}{{#if subraceHint}} locked{{/if}}" data-slot="subrace"> {{#if subraceSlot}}
              <img class="wh-slot-img" src="{{subraceSlot.img}}" alt=""/> <span class="wh-slot-name{{#unless subraceSlot.applied}} pending{{/unless}}">{{subraceSlot.name}}</span> {{#if subraceSlot.applied}}
                <button type="button" class="wh-slot-btn" data-action="subraceOpen" title="Открыть лист субрасы">⤢</button> {{else}}
                <button type="button" class="wh-slot-btn" data-action="subraceApply" title="Применить субрасу">Применить</button> {{/if}}
              <button type="button" class="wh-slot-btn" data-action="subraceClear" title="Снять субрасу">✕</button> {{else}}{{#if subraceHint}}
              <span class="wh-slot-none" title="{{subraceHint}}">{{subraceHint}}</span> {{else}}
              <button type="button" class="wh-slot-add" data-action="subracePick">+ перетащите или нажмите</button> {{/if}}{{/if}}
            </div>
          {{#if (eq system.subrace "navigator")}}
          <input type="text" name="system.navigatorHouse" value="{{system.navigatorHouse}}" placeholder="Дом Навигатора" title="Название дома Навис Нобилитэ"/> {{/if}}
          {{#if isYnnari}}
          <select name="system.ynnariPast" class="ynnari-past-select" title="Прошлое — бывшая раса (её бонусы наследуются)"> <option value="">— Прошлое —</option> {{#each ynnariPastOptions as |p|}}
            <option value="{{p.key}}" {{#if (eq @root.system.ynnariPast p.key)}}selected{{/if}}>{{p.label}}</option> {{/each}}
          </select> {{/if}}
          {{#if isHarlequin}}
          <select name="system.harlequinPast" class="ynnari-past-select" title="Прошлое — изначальная раса (её бонусы наследуются)"> <option value="">— Прошлое —</option> {{#each harlequinPastOptions as |p|}}
            <option value="{{p.key}}" {{#if (eq @root.system.harlequinPast p.key)}}selected{{/if}}>{{p.label}}</option> {{/each}}
          </select> {{/if}}
          {{#if isAeldari}}
          <input type="text" name="system.lineageOrigin" value="{{system.lineageOrigin}}" placeholder="Происхождение" title="Мир-корабль / Кабал / линия происхождения"/> {{/if}}
        </div> </div> {{#if isAstartes}}
      <div class="header-cell header-cell-readonly" title="Геносемя — редактируется на вкладке «Заметки» (Происхождение и легион)"> <label>Геносемя</label> <div class="header-readonly-val">{{#if headerGeneSeedName}}{{headerGeneSeedName}}{{else}}—{{/if}}</div> </div>
      <div class="header-cell header-cell-readonly" title="Культура — редактируется на вкладке «Заметки» (Происхождение и легион)"> <label>Культура</label> <div class="header-readonly-val">{{#if headerCultureName}}{{headerCultureName}}{{else}}—{{/if}}</div> </div>
      {{/if}}</div>
    <div class="header-row-fixed header-row-archetype"> <div class="header-cell"> <label>Архетип</label> <select class="arch-select"> <option value="">— не выбран —</option> {{#each archetype.groups as |grp|}}
          {{#if grp.label}}
          <optgroup label="{{grp.label}}"> {{#each grp.opts as |o|}}<option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option>{{/each}}
          </optgroup> {{else}}
          {{#each grp.opts as |o|}}<option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option>{{/each}}
          {{/if}} {{/each}}
      </select> </div> <div class="header-cell header-cell-elite"> <label>Элитный архетип</label> <div class="elite-stack"> <div class="elite-pick-row"><input type="text" name="system.eliteArchetype" value="{{system.eliteArchetype}}" placeholder="Элитный архетип"/><button type="button" class="elite-pick-btn" title="Выбрать из списка (по расе)"><i class="fas fa-list"></i></button><button type="button" class="elite-add-btn" title="Добавить ещё один элитный архетип">+</button></div> {{#each eliteArchetypesExtra as |ea|}}
        <div class="elite-pick-row elite-pick-extra"><input type="text" class="elite-extra-input" data-index="{{ea.idx}}" value="{{ea.value}}" placeholder="Ещё элитный архетип"/><button type="button" class="elite-extra-pick-btn" data-index="{{ea.idx}}" title="Выбрать из списка (по расе)"><i class="fas fa-list"></i></button><button type="button" class="elite-extra-remove" data-index="{{ea.idx}}" title="Удалить">✕</button></div> {{/each}}
      </div> </div> </div>
    <div class="header-row-fixed header-row-origin"> {{#if homeworld}}
      <div class="header-cell header-cell-homeworld"> <label title="Родной мир персонажа: три модификатора Характеристик и Особенность">Происхождение</label> <div class="hw-controls"> <select class="hw-select"> <option value="">— не выбрано —</option> <option value="random">🎲 Выбрать случайно</option> {{#each homeworld.options as |o|}}
          <option value="{{o.key}}" {{#if o.selected}}selected{{/if}} title="{{o.chars}}">{{o.label}}</option> {{/each}}
        </select> </div> </div> {{/if}} {{#if divination}}
      <div class="header-cell header-cell-homeworld"> <label title="Предсказание судьбы: эффект по таблице к100">Предсказание</label> <div class="hw-controls"> <select class="dv-select"> <option value="">— не выбрано —</option> <option value="random">🎲 Бросить к100</option> {{#each divination.options as |o|}}
          <option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option> {{/each}}
        </select> </div> </div> {{/if}}
      {{> "systems/warhammer-dbc/templates/actor/parts/faction-field.hbs"}} </div>
    {{!-- Стремления выбираются здесь же: раньше выбор жил на вкладке «Записи»,
          а шапка повторяла его как текст — две поверхности на одно поле. --}}
    <div class="header-row-fixed header-row-aspir"> {{#each aspirationSlots as |a|}}
      <div class="header-cell header-cell-aspir"> <label>{{a.label}}</label>
        <div class="aspir-controls">
          {{#if a.custom}}
          <input type="text" class="aspir-custom-name" data-index="{{a.idx}}" value="{{a.name}}" placeholder="Своё стремление"/>
          <input type="text" class="aspir-custom-mods" data-index="{{a.idx}}" value="{{a.mods}}" placeholder="Модификаторы"/>
          {{else}}
          <select class="aspir-select" data-index="{{a.idx}}" title="{{#if a.mods}}{{a.mods}}{{else}}Выберите Стремление{{/if}}"> <option value="">— выбрать —</option>
            {{#each a.options as |e|}}<option value="{{e.id}}" {{#if (eq e.id a.id)}}selected{{/if}} title="{{e.mods}}">{{e.name}}</option>{{/each}}
            <option value="__custom__">Своё…</option>
          </select>
          {{/if}}
          <button type="button" class="aspir-remove" data-index="{{a.idx}}" title="Очистить">✕</button>
        </div>
        <div class="aspir-mods-line" title="Модификаторы — справка: применяются к Базе вручную">{{#if a.mods}}{{a.mods}}{{else}}&nbsp;{{/if}}</div>
      </div>
      {{/each}} </div>
    </div>
    <div class="header-resources">
    <div class="header-cell fate-cell"> <label>{{fateLabel}}</label> <div class="fate-values"> <input type="number" name="system.fate.value" value="{{system.fate.value}}" min="0" {{#if system.fateMaxAuto}}max="{{system.fate.max}}"{{/if}}/> <span>/</span> {{#if system.fateMaxAuto}}<input type="number" value="{{system.fate.max}}" readonly title="Авторасчёт: W.b × (1 + «Бездонная Душа»)"/>{{else}}<input type="number" name="system.fate.max" value="{{system.fate.max}}" min="0"/>{{/if}} </div> {{#if fatePips.length}}<div class="fate-pips" title="Очки Судьбы">{{#each fatePips as |p|}}<i class="fate-pip {{#if p.on}}on{{/if}}"></i>{{/each}}</div>{{/if}} </div> {{#if isYnnari}}
      <div class="header-cell fate-cell"> <label title="Максимум = W.b × 3 (авторасчёт)">Мёртвое Могущество</label> <div class="fate-values"> <input type="number" name="system.deadMight.value" value="{{system.deadMight.value}}" min="0" max="{{system.deadMight.max}}"/> <span>/</span> <input type="number" value="{{system.deadMight.max}}" readonly title="W.b × 3"/> </div> </div> {{/if}}
    {{!-- ── Усталость ─────────────────────────────────────────────────── --}}
      <div class="header-cell fate-cell fatigue-cell"> <label class="fatigue-label"> Усталость
          {{#if system.fatigue.value}}
          <span class="fatigue-penalty-badge" title="Штраф −10 на все тесты (кроме T, Inf, Cog)">−10</span> {{/if}}
        </label> <div class="fate-values fatigue-values"> <input type="number" name="system.fatigue.value" value="{{system.fatigue.value}}" min="0" class="fatigue-value-input
                   {{#if system.fatigue.value}}fatigue-nonzero{{/if}}"/> <span>/</span> <input type="number" name="system.fatigue.max" value="{{system.fatigue.max}}" min="0" title="Порог (= T.b + W.b)"/> </div> <div class="fatigue-step-btns"> <button type="button" class="fatigue-btn fatigue-add-btn" title="Добавить 1 Усталость">+1</button> <button type="button" class="fatigue-btn fatigue-remove-btn" title="Снять 1 Усталость">−1</button> </div> <div class="fatigue-bar" title="Усталость {{fatiguePct}}%"><div class="fatigue-fill load-{{fatigueLevel}}" style="width:{{fatiguePct}}%;"></div></div> <div class="fatigue-btns"> <button type="button" class="fatigue-btn fatigue-rest-btn" title="Час отдыха (−1 Усталость)">Отдых</button> <button type="button" class="fatigue-btn fatigue-btn-sleep fatigue-sleep-btn" title="Полноценный сон (снять всю Усталость)">Сон</button> </div> </div>
    </div>
  </div> <div class="header-checks"> {{#unless isAeldari}}
      <label class="checkbox-label align-label"> <span>Мировоззрение</span> <select name="system.alignment" class="alignment-select"> <option value="loyalist" {{#if (eq system.alignment "loyalist")}}selected{{/if}}>Лоялист</option> <option value="renegade" {{#if (eq system.alignment "renegade")}}selected{{/if}}>Ренегат</option> <option value="heretic" {{#if (eq system.alignment "heretic")}}selected{{/if}}>Хаосит</option> </select> </label> {{/unless}}
      {{!-- Мастер создания уехал в панель «Актёры»: персонаж начинается кнопкой «Начать создание персонажа», а не на уже созданном листе. --}}  </div> </div> </header>