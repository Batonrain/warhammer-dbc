<div class="tab combat-cog {{#if (eq tab "combat")}}active{{/if}}" data-tab="combat" data-group="primary"> {{!-- Раны / Броня / Движение — три колонки --}}
  <div class="combat-layout"> {{!-- РАНЫ --}}
    <div class="stat-panel"> <div class="panel-title">РАНЫ</div> <div class="panel-body wounds-body"> <div class="wounds-row wounds-tier-row"> <label>Состояние</label> <span class="wounds-tier-badge wt-{{system.wounds.tier}}" title="Уровни Ранения определяют скорость лечения (корбук): Легко ранен — потеряно до T.b×2 Ран включительно; Тяжело ранен — больше T.b×2; При смерти — Раны в минусе (Критический урон). Потеряно сейчас: {{system.wounds.tierLost}}, T.b×2 = {{system.absorption.toughnessBonus}}×2.">{{system.wounds.tierLabel}}</span> </div> <div class="wounds-row"> <label>Всего</label> <input type="number" name="system.wounds.max" value="{{system.wounds.max}}" min="0"/> </div> <div class="wounds-row"> <label>Текущие</label> <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" min="0"/> </div> <div class="wounds-row"> <label>Критический урон</label> <input type="number" name="system.wounds.critical" value="{{system.wounds.critical}}" min="0"/> </div> <div class="wounds-row wounds-heal-row"> <button type="button" class="wounds-heal-btn" title="Первая помощь / отдых / лечение — себя или выбранной цели (тест Медики)"><span class="wh-cond-ico" style="color:#ff8a8a;width:14px;height:14px;"><svg viewBox="0 0 16 16" width="14" height="14" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M8 14.2S1.8 10 1.8 5.7A3.4 3.4 0 0 1 8 3.9 3.4 3.4 0 0 1 14.2 5.7C14.2 10 8 14.2 8 14.2Z"/></svg></span> Лечение</button> </div> </div> </div> {{!-- БРОНЯ И ПОГЛОЩЕНИЕ --}}
    <div class="stat-panel"> <div class="panel-title">БРОНЯ И ПОГЛОЩЕНИЕ</div> <div class="panel-body armor-body"> <div class="armor-formula-legend"> <span class="afl-ap">AP брони</span> <span class="afl-op">−&nbsp;Пробитие</span> <span class="afl-op">+</span> <span class="afl-tb">T.b&nbsp;{{system.absorption.toughnessBonus}}</span> <span class="afl-op">=</span> <span class="afl-total">Поглощение</span> </div> <div class="armor-tb-note"> T.b (Бонус Стойкости) <b>игнорируется</b> бронепробитием —
          Pen уменьшает только AP брони
        </div> <div class="armor-diagram"> <div class="armor-head"> <div class="armor-loc-label">Голова</div> <div class="armor-loc-vals"> <span class="armor-ap-gear" title="AP брони">{{system.absorption.armorOnly.head}}</span> <span class="armor-tb-val" title="Бонус Стойкости">+{{system.absorption.toughnessBonus}}</span> <span class="armor-eq">=</span> </div> <div class="armor-absorption-total">{{system.absorption.head}}</div> </div> <div class="armor-arms-row"> <div class="armor-limb"> <div class="armor-loc-label">Л. Рука</div> <div class="armor-loc-vals"> <span class="armor-ap-gear">{{system.absorption.armorOnly.leftArm}}</span> <span class="armor-tb-val">+{{system.absorption.toughnessBonus}}</span> <span class="armor-eq">=</span> </div> <div class="armor-absorption-total">{{system.absorption.leftArm}}</div> </div> <div class="armor-limb"> <div class="armor-loc-label">Корпус</div> <div class="armor-loc-vals"> <span class="armor-ap-gear">{{system.absorption.armorOnly.body}}</span> <span class="armor-tb-val">+{{system.absorption.toughnessBonus}}</span> <span class="armor-eq">=</span> </div> <div class="armor-absorption-total">{{system.absorption.body}}</div> </div> <div class="armor-limb"> <div class="armor-loc-label">П. Рука</div> <div class="armor-loc-vals"> <span class="armor-ap-gear">{{system.absorption.armorOnly.rightArm}}</span> <span class="armor-tb-val">+{{system.absorption.toughnessBonus}}</span> <span class="armor-eq">=</span> </div> <div class="armor-absorption-total">{{system.absorption.rightArm}}</div> </div> </div> <div class="armor-legs-row"> <div class="armor-limb"> <div class="armor-loc-label">Л. Нога</div> <div class="armor-loc-vals"> <span class="armor-ap-gear">{{system.absorption.armorOnly.leftLeg}}</span> <span class="armor-tb-val">+{{system.absorption.toughnessBonus}}</span> <span class="armor-eq">=</span> </div> <div class="armor-absorption-total">{{system.absorption.leftLeg}}</div> </div> <div class="armor-limb"> <div class="armor-loc-label">П. Нога</div> <div class="armor-loc-vals"> <span class="armor-ap-gear">{{system.absorption.armorOnly.rightLeg}}</span> <span class="armor-tb-val">+{{system.absorption.toughnessBonus}}</span> <span class="armor-eq">=</span> </div> <div class="armor-absorption-total">{{system.absorption.rightLeg}}</div> </div> </div> </div> <div class="armor-legend-row"> <span class="armor-ap-gear">AP брони</span> <span class="armor-tb-val">+T.b</span> <span class="armor-eq">=</span> <span class="armor-total">Поглощение</span> </div> {{#if armorVsTypeStr}}
        <div class="armor-tb-note" style="margin-top:4px;"> Доп. AP против типов: <b>{{armorVsTypeStr}}</b> (модификации брони)
        </div> {{/if}}
        {{#if system.maxAgilityCap}}
        <div class="armor-tb-note" style="margin-top:4px;" title="Тяжёлая броня держит Ловкость не выше этого значения. Модификации вроде Открытых Сочленений потолок поднимают."> Потолок Ловкости от брони: <b>{{system.maxAgilityCap}}</b>
        </div> {{/if}}
        {{#if system.disabledArmourOverload}}
        <div class="armor-tb-note" style="margin-top:4px;color:#ff8a8a;" title="Выключенная силовая броня больше не подавляет свой вес (стр. 233) — SPD уже учтён в Движении, остальное ведите вручную: в начале Хода/при отключении — S+0 или Athletics(S)+10, провал опускает Max.A до 10.">
          ⚠️ Перевес выключенной брони — тир <b>{{system.disabledArmourOverload.tier}}</b>:
          {{system.disabledArmourOverload.moveAtkMod}} к движениям/атакам сверх обычного штрафа,
          {{#if system.disabledArmourOverload.helpless}}<b>Беспомощен</b>{{else}}{{#if system.disabledArmourOverload.fullActionOnly}}только Полное действие на движение{{else}}SPD −1{{/if}}{{/if}}
        </div>
        <div class="armor-tb-note disabled-armour-periodic-row" style="margin-top:4px;"> <button type="button" class="disabled-armour-periodic-test-btn" {{#unless disabledArmourPeriodicReady}}disabled{{/unless}} title="Тест Т+0 раз в T.b часов перевеса (стр. 233) — провал даёт 1 Усталость, интервал сбрасывается в любом исходе.">Тест Т — перевес</button> <span>{{#if disabledArmourPeriodicReady}}Тест доступен{{else}}Перезарядка: {{disabledArmourPeriodicRemainingLabel}}{{/if}}</span>
        </div>
        {{#unless (eq system.disabledArmourOverload.tier 3)}}
        <div class="armor-tb-note" style="margin-top:4px;"> <button type="button" class="disabled-armour-fork-test-btn" title="Тест-развилка S+0 или Athletics(S)+10 — в начале своего Хода или при отключении брони (стр. 233). Провал (на тире 2 успех тоже) роняет Max.A брони до 10.">Тест S/Athletics — перевес</button> <span>жать в начале своего Хода</span>
        </div> {{/unless}}
        {{/if}}
        {{#if hasWeaponPropWounds}}
        <div class="armor-tb-note wprop-wounds-block" style="margin-top:6px;">
          <div class="armor-loc-label" style="margin-bottom:2px;">Свойства оружия</div>
          {{#if system.armorCorrosion.head}}<div class="wprop-wound-row">🧪 Голова: −{{system.armorCorrosion.head}} AP <button type="button" class="wh-sheet-corrosion-repair-btn" data-loc="head" title="Техобслуживание брони, ½ смены, Trade(Armourer)+0">Ремонт</button></div>{{/if}}
          {{#if system.armorCorrosion.leftArm}}<div class="wprop-wound-row">🧪 Л. Рука: −{{system.armorCorrosion.leftArm}} AP <button type="button" class="wh-sheet-corrosion-repair-btn" data-loc="leftArm" title="Техобслуживание брони, ½ смены, Trade(Armourer)+0">Ремонт</button></div>{{/if}}
          {{#if system.armorCorrosion.rightArm}}<div class="wprop-wound-row">🧪 П. Рука: −{{system.armorCorrosion.rightArm}} AP <button type="button" class="wh-sheet-corrosion-repair-btn" data-loc="rightArm" title="Техобслуживание брони, ½ смены, Trade(Armourer)+0">Ремонт</button></div>{{/if}}
          {{#if system.armorCorrosion.body}}<div class="wprop-wound-row">🧪 Корпус: −{{system.armorCorrosion.body}} AP <button type="button" class="wh-sheet-corrosion-repair-btn" data-loc="body" title="Техобслуживание брони, ½ смены, Trade(Armourer)+0">Ремонт</button></div>{{/if}}
          {{#if system.armorCorrosion.leftLeg}}<div class="wprop-wound-row">🧪 Л. Нога: −{{system.armorCorrosion.leftLeg}} AP <button type="button" class="wh-sheet-corrosion-repair-btn" data-loc="leftLeg" title="Техобслуживание брони, ½ смены, Trade(Armourer)+0">Ремонт</button></div>{{/if}}
          {{#if system.armorCorrosion.rightLeg}}<div class="wprop-wound-row">🧪 П. Нога: −{{system.armorCorrosion.rightLeg}} AP <button type="button" class="wh-sheet-corrosion-repair-btn" data-loc="rightLeg" title="Техобслуживание брони, ½ смены, Trade(Armourer)+0">Ремонт</button></div>{{/if}}
          {{#if system.piercingWounds.head}}<div class="wprop-wound-row">🏹 Голова: снаряд в ране <button type="button" class="wh-sheet-piercing-extract-btn" data-loc="head" title="Полудействие, +1 непоглощ. R Dmg">Извлечь</button></div>{{/if}}
          {{#if system.piercingWounds.leftArm}}<div class="wprop-wound-row">🏹 Л. Рука: снаряд в ране <button type="button" class="wh-sheet-piercing-extract-btn" data-loc="leftArm" title="Полудействие, +1 непоглощ. R Dmg">Извлечь</button></div>{{/if}}
          {{#if system.piercingWounds.rightArm}}<div class="wprop-wound-row">🏹 П. Рука: снаряд в ране <button type="button" class="wh-sheet-piercing-extract-btn" data-loc="rightArm" title="Полудействие, +1 непоглощ. R Dmg">Извлечь</button></div>{{/if}}
          {{#if system.piercingWounds.body}}<div class="wprop-wound-row">🏹 Корпус: снаряд в ране (−1 SPD) <button type="button" class="wh-sheet-piercing-extract-btn" data-loc="body" title="Полудействие, +1 непоглощ. R Dmg">Извлечь</button></div>{{/if}}
          {{#if system.piercingWounds.leftLeg}}<div class="wprop-wound-row">🏹 Л. Нога: снаряд в ране (−1 SPD) <button type="button" class="wh-sheet-piercing-extract-btn" data-loc="leftLeg" title="Полудействие, +1 непоглощ. R Dmg">Извлечь</button></div>{{/if}}
          {{#if system.piercingWounds.rightLeg}}<div class="wprop-wound-row">🏹 П. Нога: снаряд в ране (−1 SPD) <button type="button" class="wh-sheet-piercing-extract-btn" data-loc="rightLeg" title="Полудействие, +1 непоглощ. R Dmg">Извлечь</button></div>{{/if}}
          {{#each system.crippledWounds as |w|}}
          <div class="wprop-wound-row">🩸 {{w.locationLabel}}: рана с шипами ({{w.rating}}) <button type="button" class="wh-sheet-crippling-trigger-btn" data-rating="{{w.rating}}" data-location="{{w.locationLabel}}" title="Снимается только лечением/полным исцелением">Оба ОД физ. — урон {{w.rating}}</button></div>
          {{/each}}
        </div>
        {{/if}}

      </div> </div>{{!-- /броня --}}

    {{#if helmetless}}
    <div class="stat-panel helmet-panel{{#if helmetless.on}} helmet-off{{/if}}"> <div class="panel-title">ШЛЕМ СИЛОВОЙ БРОНИ</div> <div class="panel-body helmet-body"> <label class="helmet-toggle" title="{{helmetless.action}}"> <input type="checkbox" name="system.helmetOff" {{checked helmetless.on}}/> <span class="helmet-toggle-label">Шлем снят</span> <span class="helmet-ap" title="ОБ на голову от снаряжения">шлем даёт {{helmetless.headAP}} ОБ</span> </label> {{#if helmetless.on}}
      <ul class="helmet-effects"> {{#each helmetless.effects as |e|}}<li>{{e.text}}</li>{{/each}}
      </ul> {{#if helmetless.disabled.length}}
      <div class="helmet-disabled"> <span class="helmet-disabled-head">Отключены системы шлема:</span> {{#each helmetless.disabled as |d|}}<span class="helmet-disabled-item">{{d}}</span>{{/each}}
      </div> {{/if}}
      {{#if helmetless.kept.length}}
      <div class="helmet-kept"> <span class="helmet-kept-head">Продолжает работать:</span> {{#each helmetless.kept as |d|}}<span class="helmet-kept-item">{{d}}</span>{{/each}}
        <span class="helmet-kept-note">— только передача звука через горжет</span> </div> {{/if}} <div class="helmet-action">{{helmetless.action}}</div> {{else}}
      <div class="helmet-hint">Многие боевые братья снимают шлем, когда нет прямой угрозы: это стоит защиты головы и авточувств, но подкупает врагов и соратников.</div> {{/if}}
    </div> </div> {{/if}}
    {{!-- ДВИЖЕНИЕ — растянута на всю ширину combat-layout (grid-column:
          1/-1 в CSS), три узкие boковые колонки иначе не влезли бы в
          прежний 155px-слот третьей колонки сетки. --}}
    <div class="stat-panel movement-panel-full"> <div class="panel-title">ДВИЖЕНИЕ</div>
      {{!-- Три колонки: боевые типы (стр. 32, кнопка = значение дистанции,
            заменяет прежнюю отдельную таблицу Полушаг/Шаг/Натиск/Бег) ·
            отдельные механики (стр. 29-30, с превью дистанции у Карабканья
            и Плавания — те же формулы, что в самом диалоге) · марши вне боя
            (стр. 29, с базовой нарративной скоростью сверху) —
            module/combat/movement-actions.mjs, тот же обработчик, что у
            Token HUD-кнопки «Движение». --}}
      <div class="panel-body movement-cols">
        <div class="movement-col">
          <div class="movement-item"> <button type="button" class="wh-move-btn" data-move-action="halfmove" title="Полудействие (1 ОД). Перемещение до SPD×1.">Полушаг</button> <span class="mv-box">{{system.movement.halfMove}}</span> </div>
          <div class="movement-item"> <button type="button" class="wh-move-btn" data-move-action="fullmove" title="Полное действие (2 ОД). Перемещение до SPD×2.">Шаг</button> <span class="mv-box">{{system.movement.move}}</span> </div>
          <div class="movement-item"> <button type="button" class="wh-move-btn" data-move-action="charge" title="Выбирает Базу «Натиск» — рукопашный приём +20, 2 ОД спишутся на броске атаки.">Натиск</button> <span class="mv-box">{{system.movement.charge}}</span> </div>
          <div class="movement-item"> <button type="button" class="wh-move-btn" data-move-action="run" title="Полное действие (2 ОД). До начала следующего Хода: нельзя Реакции, Стрельба по персонажу −20, Рукопашная +20.">Бег</button> <span class="mv-box">{{system.movement.run}}</span> </div>
        </div>
        <div class="movement-col">
          <div class="movement-item"> <button type="button" class="wh-move-btn" data-move-action="climb" title="Карабканье (стр. 29): Athletics/Acrobatics. Дистанция: SPD/2 + Успехи.">Карабканье</button> <span class="mv-box">{{movementDist.climb}}</span> </div>
          <button type="button" class="wh-move-btn" data-move-action="jump" title="Прыжок (стр. 29-30): Acrobatics. Дистанция зависит от типа прыжка (в диалоге).">Прыжок</button>
          <button type="button" class="wh-move-btn" data-move-action="fall" title="Падение и Группирование (стр. 30). Урон по высоте, не дистанция.">Падение</button>
          <div class="movement-item"> <button type="button" class="wh-move-btn" data-move-action="swim" title="Плавание (стр. 30): Athletics. Успех — SPD = ½S.b.">Плавание</button> <span class="mv-box">{{movementDist.swim}}</span> </div>
          {{#if movementCanFly}}
          <button type="button" class="wh-move-btn" data-move-action="fly" title="Высота полёта и потеря управления (стр. 30).">Полёт</button>
          {{/if}}
        </div>
        <div class="movement-col">
          <div class="movement-col-note" title="Неспешный темп по свободному ландшафту при текущем SPD ({{system.movement.halfMove}}) — стр. 29, таблица «Движение в нарративном времени». Марши ниже умножают эту базу.">
            Баз. скорость: {{movementNarrative.perMinute}}м/мин · {{movementNarrative.perHour}}км/ч · {{movementNarrative.perDay}}км/день
          </div>
          <div class="movement-item"> <button type="button" class="wh-move-btn" data-move-action="march-accelerated" title="Ускоренный марш (стр. 29): ×2 базовой скорости, до T.b часов без теста, дальше — тест T каждый час.">Ускоренный марш</button> <span class="mv-box mv-box-wide">{{movementNarrative.perDayX2}}км/день</span> </div>
          <div class="movement-item"> <button type="button" class="wh-move-btn" data-move-action="march-run" title="Бег вне боя (стр. 29): ×3 базовой скорости, 1 час, тест T каждый час.">Марафонский бег</button> <span class="mv-box mv-box-wide">{{movementNarrative.perHourX3}}км/ч</span> </div>
          <div class="movement-item"> <button type="button" class="wh-move-btn" data-move-action="march-forced" title="Форсированный марш (стр. 29): как обычный марш (после 8ч), тест T каждый час, Усталость восстанавливается вдвое медленнее.">Форсированный марш</button> <span class="mv-box mv-box-wide">{{movementNarrative.perDay}}км/день</span> </div>
        </div>
      </div>
      <div class="panel-title" style="margin-top:4px;">ПРОЧЕЕ</div>
      {{!-- Инициатива/Размер слева, Экономика Действий (ОД/Реакции) справа
            в компактном многострочном виде — раньше была отдельной
            во всю ширину листа полосой под combat-layout, теперь в одной
            строке с ПРОЧЕЕ. Только Полудействие/Полное действие/Реакция
            тратят пул — Свободное действие бесплатно и кнопки не имеет.
            Восполняется автоматически в начале Хода актора (updateCombat,
            module/combat/action-economy.mjs); кнопки ниже — ручная трата
            для действий без своей кнопки в другом месте листа
            (Уклонение/Парирование уже тратят Реакцию сами). --}}
      <div class="panel-body movement-other-row">
        <div class="movement-body movement-other-col"> <div class="movement-row initiative-row"> <label title="1d10 + Ag.Бонус + модификатор">Инициатива</label> <div class="initiative-controls"> <span class="movement-val initiative-base" title="Ag.Бонус (авторасчёт)">{{system.initiative}}</span> <span class="initiative-sep">+</span> <input type="number" class="initiative-mod-input" name="system.initiativeMod" value="{{system.initiativeMod}}" min="-99" max="99" title="Доп. модификатор к инициативе" placeholder="0"/> <button type="button" class="initiative-roll-btn" data-action="initiativeRoll" title="Бросок Инициативы в трекер (1d10 + Ag.Бонус + модификатор)">🎲</button> </div> </div> <div class="movement-row"> <label>Размер{{#if system.sizeMod}} <span class="size-trait-badge" title="Вклад Черт">(+{{system.sizeMod}} от Черт)</span>{{/if}}</label> <input type="number" name="system.size" value="{{system.size}}" min="-4" max="6" title="База. Итоговый размер с Чертами: {{system.sizeTotal}}"/> {{#if system.sizeMod}}
          <span class="size-total-value" title="Итоговый Размер (база + Черты)">= {{system.sizeTotal}}</span> {{/if}}
        </div> </div>
        {{#if actionEconomy}}
        <div class="action-economy-bar action-economy-compact{{#unless actionEconomy.encounterActive}} action-economy-idle{{/unless}}">
          <div class="ae-pool" title="Очки Действия (стр. 12): Полудействие −1, Полное действие −2">
            <span class="ae-pool-label">ОД</span>
            <span class="ae-pool-value">{{actionEconomy.ap.value}}</span><span class="ae-pool-sep">/</span><span class="ae-pool-max">{{actionEconomy.ap.max}}</span>
            <button type="button" class="ae-spend-btn" data-ae-spend="ap" data-ae-cost="1" title="Списать 1 ОД (Полудействие)">−1</button>
            <button type="button" class="ae-spend-btn" data-ae-spend="ap" data-ae-cost="2" title="Списать 2 ОД (Полное действие)">−2</button>
          </div>
          <div class="ae-pool" title="Реакции (стр. 12): тратятся Уклонением/Парированием и подобными действиями вне своего Хода">
            <span class="ae-pool-label">Реакции</span>
            <span class="ae-pool-value">{{actionEconomy.reactions.value}}</span><span class="ae-pool-sep">/</span><span class="ae-pool-max">{{actionEconomy.reactions.max}}</span>
            <button type="button" class="ae-spend-btn" data-ae-spend="reaction" data-ae-cost="1" title="Списать 1 Реакцию вручную">−1</button>
          </div>
          {{#if actionEconomy.defense}}
          <div class="ae-pool" title="Доп. Реакции только на Избегание (Защитная Стойка, стр. 15) — тратятся раньше универсальных">
            <span class="ae-pool-label">Реакции (Избегание)</span>
            <span class="ae-pool-value">{{actionEconomy.defense.value}}</span><span class="ae-pool-sep">/</span><span class="ae-pool-max">{{actionEconomy.defense.max}}</span>
          </div>
          {{/if}}
          <div class="ae-pool ae-pool-status">
            {{#if actionEconomy.exposed}}
            <span class="atk-training-warn" title="Агрессивная Стойка: в конце Хода терять было нечего — атаки по персонажу +20 до начала следующего Хода">⚔️ Раскрыт (+20 атакам по персонажу)</span>
            {{/if}}
            <span class="ae-status" title="{{#if actionEconomy.encounterActive}}Идёт бой — пул тратится и восполняется каждый Ход{{else}}Вне активного Encounter трата не считается{{/if}}">{{#if actionEconomy.encounterActive}}⚔️ В бою{{else}}Вне боя{{/if}}</span>
            <button type="button" class="ae-reset-btn" title="Восполнить ОД и Реакции до максимума вручную">Сброс</button>
          </div>
        </div>
        {{/if}}
      </div>
    </div>{{!-- /движение --}}

  </div>{{!-- /combat-layout --}}

  {{!-- ═══ ОЧКИ БОЛИ (Друкхари, талант «Через Боль») ═══ --}}
  {{#if system.painActive}}
  <div class="pain-panel">
    <div class="pain-head">
      <span class="pain-title">⚡ ОЧКИ БОЛИ</span>
      <span class="pain-current"><b class="pain-value">{{system.fate.value}}</b> / {{system.fate.max}}</span>
      <span class="pain-info" title="Максимум = W.b × (1 + «Бездонная Душа»). Тратится как Очки Бесчестья по X×строке таблицы (Cor 0 → 1 Боль, Cor 20 → 2 и т.д.). Работает в нуль-поле; нельзя на Усиление, Доп. Успехи и Переброс Длительных тестов. Вне Паутины — 1 Боль/день, иначе Порча от Голодной Суки.">ⓘ</span>
    </div>
    <div class="pain-actions">
      <button type="button" class="pain-absorb-btn" title="Реакция: впитать страдания (+1 Боль; не более 1 с одной жертвы за Раунд)">＋ Впитать (Реакция)</button>
      <button type="button" class="pain-spend-btn" title="Потратить 1 Очко Боли (как Очко Бесчестья)">− Потратить</button>
      <button type="button" class="pain-soulburn-btn" title="Выжигание Души / Варп-урон: Боль выжигается первой — 3 урона за 1 Боль">🔥 Поглотить Выжигание</button>
    </div>
  </div>
  {{/if}}

  {{!-- ═══ ЗДРАВОМЫСЛИЕ ПИЛОТА ДРЕДНОУТА (Книга Машин, стр. 57) ═══
        Видна только персонажу, которого какой-то Дредноут в мире держит
        своим пилотом (dreadnought-panel.mjs) — иначе пустая полоса ни за чем. --}}
  {{#if sanityAvailable}}
  <div class="sanity-panel">
    <div class="sanity-head">
      <span class="sanity-title">ЗДРАВОМЫСЛИЕ{{#if sanity.dreadnoughtName}} <span class="sanity-dread-name">— {{sanity.dreadnoughtName}}</span>{{/if}}</span>
      <span class="sanity-info" title="Максимум = 50 + 2×W.b, плюс 5 за каждое взятое «Ядро Воспоминаний». Кнопка ниже — единая для потери (урон Дредноуту, провал теста Воли) и восстановления (Гибернация, Электростимуляторы, Таланты) — число и причина, книга стр. 57-58.">ⓘ</span>
      <button type="button" class="sanity-daily-test-btn" data-action="dreadnoughtDailyTest"
              title="Суточный тест бодрствования: W+0 без модификаторов. При Провале Здравомыслие теряется автоматически, на число Провалов.">Тест бодрствования</button>
    </div>
    <div class="sanity-current">
      <input type="number" name="system.sanity.value" value="{{sanity.value}}" min="0" max="{{sanity.max}}"/>
      <span class="sanity-max">/ {{sanity.max}}</span>
      <button type="button" class="stat-add-btn sanity-add-btn" data-action="statAdd" data-stat="sanity"
              title="Изменить Здравомыслие (число, можно отрицательное, или XdY+Z) с причиной в лог">±</button>
    </div>
    <div class="sanity-bar">
      <div class="sanity-fill load-{{sanity.level}}" style="width:{{sanity.pct}}%;"></div>
      <span class="sanity-pct">{{sanity.pct}}%</span>
    </div>
    {{#if sanity.thresholds.length}}
    <div class="sanity-thresholds">
      <span class="sanity-thresholds-label">Пороги:</span>
      {{#each sanity.thresholds as |t|}}<span class="sanity-threshold-chip" title="{{t.label}}">{{t.value}}</span>{{/each}}
    </div>
    {{/if}}
    {{#if sanity.recoveries.length}}
    <div class="sanity-recoveries">
      {{#each sanity.recoveries as |r|}}
      <button type="button" class="sanity-recover-btn" data-action="sanityTalentRecover" data-talent="{{r.key}}"
              title="{{r.label}}: {{r.hint}}. Трата 1 Очка Бесчестия, бросок 2d10 в Здравомыслие.">{{r.label}} 2d10</button>
      {{/each}}
    </div>
    {{/if}}
    {{#if sanity.electrostim}}
    <div class="sanity-recoveries">
      {{#if sanity.electrostim.active}}
      <button type="button" class="sanity-recover-btn sanity-electrostim-rollback" data-action="electrostimRollback"
              title="Снять буст Электростимуляторов: −{{sanity.electrostim.amount}} Здравомыслия, 1d5 непоглощаемого урона.">
        Откат Электростимуляторов (−{{sanity.electrostim.amount}})</button>
      {{else}}
      <button type="button" class="sanity-recover-btn" data-action="electrostimActivate"
              title="Свободное действие: +{{sanity.electrostim.boostAmount}} Здравомыслия. Через ~{{sanity.electrostim.delayMinutes}} мин. нужно нажать «Откат».">
        Электростимуляторы (+{{sanity.electrostim.boostAmount}})</button>
      {{/if}}
    </div>
    {{/if}}
    {{#if sanity.ferumInfernus}}
    <div class="sanity-recoveries">
      <button type="button" class="sanity-recover-btn{{#unless sanity.ferumInfernus.active}} sanity-recover-btn-inert{{/unless}}"
              data-action="ferumInfernusTick"
              title="Порог: Здравомыслие < {{sanity.ferumInfernus.threshold}} (½Inf+5). Пока ниже — раз в игровой час +1 Здравомыслия; тикать нужно вручную.">
        Ферум Инфернус: тик часа{{#if sanity.ferumInfernus.active}} (порог {{sanity.ferumInfernus.threshold}}){{else}} — неактивно{{/if}}</button>
    </div>
    {{/if}}
    <div class="sanity-recoveries">
      {{#if sanity.hibernation.active}}
      <button type="button" class="sanity-recover-btn" data-action="hibernationWeekTick"
              title="Раз в полную неделю Гибернации: 1d10 Здравомыслия.">Гибернация: тик недели (1d10)</button>
      <button type="button" class="sanity-recover-btn sanity-electrostim-rollback" data-action="hibernationExit"
              title="Выход из Гибернации: часовой техноритуал, Tech-Use−40 + Medicae−40.">Выход из Гибернации</button>
      {{else}}
      <button type="button" class="sanity-recover-btn" data-action="hibernationEnter"
              title="Вход в Гибернацию: часовой техноритуал, комбинированный тест Tech-Use−40 + Medicae−40 (2-8 ассистентов). Основной способ восстановить Здравомыслие.">Войти в Гибернацию</button>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{!-- СТОЙКА — то же постоянное состояние (system.meleeStance), что читает
        диалог атаки как стартовое значение и умеет сменить на разовый
        бросок; здесь — посмотреть и сменить текущий выбор без начала атаки.
        Клик пишет то же поле, что и диалог — расхождения не будет. База
        сюда больше не входит — выбирается прямо в диалоге атаки (Натиск
        дополнительно выставляет её кнопкой на панели ДВИЖЕНИЕ). --}}
  <div class="combat-section-panel"> <div class="panel-title">СТОЙКА</div> <div class="combat-collapse-body">
    <div class="technique-grid"> {{#each combatStanceOptions as |s|}}<button type="button" class="technique-btn technique-btn-stance {{#if s.active}}is-on{{/if}}" data-stance="{{s.key}}" title="{{s.desc}}"> <span class="tech-name">{{s.label}}</span> </button> {{/each}}
    </div>
    {{!-- Ярость (wdbc-plsf) — простой тумблер состояния боя, тем же приёмом,
          что helmetOff: сама механика Ярости (+10 WS/S/W, −20 BS/I/F и т.п.,
          стр. 15) не реализована, поле нужно только как гейт для условных
          возможностей вроде Дара Кхорна «Purity of Wrath». --}}
    <label class="simple-toggle rage-toggle" title="Тумблер состояния «В Ярости» — только гейт для условных возможностей (напр. Дар Кхорна Purity of Wrath), сама механика Ярости не реализована.">
      <input type="checkbox" name="system.inRage" {{checked system.inRage}}/>
      <span class="simple-toggle-label">В Ярости</span>
    </label>
  </div></div>{{!-- /стойка --}}

  {{!-- ═══ СИЛОВОЕ ПОЛЕ — отдельная строка под основной сеткой ═══ --}}
  {{#if activeShield}}
  <div class="shield-combat-bar shield-bar-active"> <div class="shield-bar-left"> <span class="shield-bar-icon"> {{#if (eq activeShield.shieldNature "technological")}}{{else}}{{/if}}
      </span> <span class="shield-bar-title">СИЛОВОЕ ПОЛЕ</span> <span class="shield-bar-name">{{activeShield.name}}</span> <span class="shield-bar-type shield-type-{{activeShield.shieldType}}"> {{#if (eq activeShield.shieldType "dome")}}Купол{{/if}}
        {{#if (eq activeShield.shieldType "deflector")}}Дефлектор{{/if}}
        {{#if (eq activeShield.shieldType "penetrating")}}Сквозной{{/if}}
      </span> </div> <div class="shield-bar-stats"> <div class="shield-bar-stat"> <span class="shield-bar-stat-label">Рейтинг</span> <span class="shield-bar-stat-value shield-rating-glow">{{activeShield.currentRating}}</span> </div> <div class="shield-bar-stat"> <span class="shield-bar-stat-label">Перегрузка ≤</span> <span class="shield-bar-stat-value"> {{#if activeShield.overloadThreshold}}
            {{activeShield.overloadMax}}
          {{else}}—{{/if}}
        </span> </div> <div class="shield-bar-stat"> <span class="shield-bar-stat-label">Статус</span> <span class="shield-bar-stat-value"> <span class="shield-status-badge shield-status-{{activeShield.statusKey}}"> {{activeShield.statusIcon}} {{activeShield.statusLabel}}
          </span> </span> </div> </div> <div class="shield-bar-actions"> <button type="button" class="shield-roll-btn shield-bar-btn shield-bar-btn-roll" data-item-id="{{activeShield.id}}" title="Бросок d100 против рейтинга щита"> Бросок щита
      </button> <button type="button" class="shield-toggle-btn shield-bar-btn shield-bar-btn-off" data-item-id="{{activeShield.id}}" title="Деактивировать щит"> Выключить
      </button> </div> </div> {{else}}

  {{!-- Нет активного щита --}}
  <div class="shield-combat-bar shield-bar-inactive"> <div class="shield-bar-left"> <span class="shield-bar-icon shield-bar-icon-off"></span> <span class="shield-bar-title">СИЛОВОЕ ПОЛЕ</span> <span class="shield-bar-empty-text">Нет активного щита</span> </div> {{#if inactiveShields.length}}
    <div class="shield-bar-inactive-list"> {{#each inactiveShields as |s|}}
      <div class="shield-bar-inactive-item"> <span class="shield-bar-inactive-name"> {{#if (eq s.shieldNature "technological")}}{{else}}{{/if}}
          {{s.name}}
        </span> <button type="button" class="shield-toggle-btn shield-bar-btn shield-bar-btn-on" data-item-id="{{s.id}}" title="Активировать: {{s.name}}"> Активировать
        </button> </div> {{/each}}
    </div> {{/if}}
  </div> {{/if}}
  {{!-- /силовое поле --}}

  {{!-- СОСТЯЗАНИЯ — Стойка/База/обычные Приёмы теперь выбираются прямо в
        диалоге атаки; Состязания (Повалить/Финт/Давление/Напролом) в диалог
        не переехали (отдельный встречный тест, module/combat/techniques.mjs),
        поэтому свою панель сохраняют. --}}
  <div class="combat-section-panel combat-collapsible {{#if combatTechCollapsed}}collapsed{{/if}}"> <div class="panel-title combat-collapse-head" data-action="combatCollapse" data-collapse="tech"><span class="cc-caret">▾</span> СОСТЯЗАНИЯ</div> <div class="combat-collapse-body"><div class="technique-grid"> {{#each combatContestOptions as |c|}}<button type="button" class="technique-btn technique-btn-contest" data-technique="{{c.key}}"> <span class="tech-name">{{c.label}}</span> <span class="tech-mod">{{c.modLabel}}</span> </button> {{/each}}
  {{!-- Борьба (стр. 12) — только пока актор связан Захватом (conditions.grappling,
        module/combat/grapple.mjs выставляет его после попадания Приёмом «Захват»). --}}
  {{#if system.conditions.grappling}}<button type="button" class="technique-btn technique-btn-contest grapple-btn" style="border-color:#e08a3a;"> <span class="tech-name">🤼 Борьба</span> <span class="tech-mod">связан Захватом</span> </button>{{/if}}
  </div></div> </div>{{!-- /состязания --}}

  {{!-- ═══ ВЕРХОМ (стр. 477-478) ═══
        Пока скакун не выбран — только полоса-приглашение с зоной переноса.
        Скорость в текущем Ходу переключается руками: от неё зависят штраф
        стрельбы, доступные углы поворота и высота падения из седла. --}}
  {{#if mountAvailable}}
  <div class="combat-section-panel mount-panel">
    <div class="panel-title">
      ВЕРХОМ
      {{#if mountActor}}
      <span class="mount-title-meta">{{mountActor.kind}} · {{mountActor.poolLabel}} {{mountActor.poolValue}}/{{mountActor.poolMax}}{{#if mountActor.broken}} — сломан{{/if}}</span>
      <button type="button" class="mount-dismount-btn" title="Спешиться — связь снимается">Спешиться</button>
      {{/if}}
    </div>

    {{#if mountActor}}
    <div class="panel-body mount-body">
      <div class="mount-head">
        <img class="mount-img mount-open-link" src="{{mountActor.img}}" data-uuid="{{mountActor.uuid}}" alt="" title="Открыть лист: {{mountActor.name}}"/>
        <div class="mount-head-main">
          <a class="mount-name mount-open-link" data-uuid="{{mountActor.uuid}}">{{mountActor.name}}</a>
          <div class="mount-chips">
            {{#each mountTraitChips as |t|}}<span class="minion-slot-chip">{{t.label}}{{#if t.rating}} ({{t.rating}}){{/if}}</span>{{/each}}
          </div>
        </div>
      </div>

      <div class="mount-controls">
        <label class="mount-field">Место
          <select class="mount-role-select">
            {{#each mountRoles as |r|}}<option value="{{r.key}}" {{#if r.selected}}selected{{/if}}>{{r.label}}</option>{{/each}}
          </select>
        </label>
        <label class="mount-field" title="Скорость скакуна в текущем Ходу — от неё идут штраф стрельбы и углы поворота">Скорость в Ходу
          <select class="mount-speed-select">
            {{#each mountSpeeds as |s|}}<option value="{{s.key}}" {{#if s.selected}}selected{{/if}}>{{s.label}}</option>{{/each}}
          </select>
        </label>
        <label class="mount-toggle" title="Пара действует в наименьшую инициативу обоих, зато скакун тратит свои действия, бьёт и реагирует сам">
          <input type="checkbox" class="mount-flag-toggle" data-flag="sync" {{checked mountSync}}/> В ритм скакуна
        </label>
        <label class="mount-toggle" title="MIU, телепатия или подчинённый демонический скакун — управление не занимает руку">
          <input type="checkbox" class="mount-flag-toggle" data-flag="linked" {{checked mountLinked}}/> Связь без рук
        </label>
      </div>

      <div class="mount-summary">
        <div class="mount-stat"><label>Управление</label>
          <span class="{{#unless mountControl.trained}}mount-warn{{/unless}}">{{mountControl.label}} {{mountControl.value}}</span>
        </div>
        <div class="mount-stat"><label>Стрельба с седла</label><span>{{mountRanged}}</span></div>
        <div class="mount-stat"><label>Маневрирование</label><span>{{mountManoeuvre}}</span></div>
        <div class="mount-stat"><label>Руки заняты</label><span title="{{mountHands.reason}}">{{mountHands.hands}}</span></div>
        <div class="mount-stat"><label>Инициатива пары</label><span title="{{mountInitiative.label}}">{{mountInitiative.value}}</span></div>
        <div class="mount-stat"><label>Пассажиров</label><span>{{mountPassengers}}</span></div>
      </div>

      {{#unless mountControl.trained}}
      <div class="gene-seed-hint mount-warn">Навыком управления персонаж не владеет: каждое движение и атака верхом — комбинированный тест, и бонусного верхового полудействия нет.</div>
      {{/unless}}
      {{#unless mountSizeFits}}
      <div class="gene-seed-hint mount-warn">Скакун не крупнее седока на Размер — по книге он такого не понесёт (стр. 477).</div>
      {{/unless}}

      <div class="mount-actions">
        <button type="button" class="mount-action-btn" data-mount-action="turn">Поворот</button>
        <button type="button" class="mount-action-btn" data-mount-action="skid" {{#unless mountSkidAllowed}}disabled{{/unless}}
          title="{{#if mountSkidBlocked}}Байк с Коляской Занос не совершает{{else}}Только после Натиска или Бега{{/if}}">Занос</button>
        <button type="button" class="mount-action-btn" data-mount-action="terrain">Трудный ландшафт</button>
        <button type="button" class="mount-action-btn" data-mount-action="hit" title="Куда пришлось не-Избирательное попадание: дубль — по всаднику">Попадание</button>
        <button type="button" class="mount-action-btn" data-mount-action="damage" title="Скакун получил Крит. Эффект, сбит с ног или погиб — тест Акробатики">Скакуна тряхнуло</button>
        {{#if mountIsBike}}
        <button type="button" class="mount-action-btn" data-mount-action="repair" title="Смена работы и тест Tech-Use −20 (сломанному −40)">Ремонт байка</button>
        {{/if}}
      </div>
    </div>
    {{else}}
    <div class="panel-body mount-body">
      <div class="mount-drop-zone social-relations-zone" data-tooltip="Перетащите сюда скакуна или байк">
        <div class="gene-seed-hint">Не верхом. Перетащите сюда актора-скакуна или байк — из боковой панели или со сцены.</div>
      </div>
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{!-- БЛИЖНИЙ БОЙ --}}
  <div class="combat-section-panel"> <div class="panel-title">БЛИЖНИЙ БОЙ</div> <table class="items-table combat-weapons-table"> <thead> <tr> <th>Название</th><th>Класс</th><th>Урон</th><th>Тип</th> <th>Проб.</th><th>Особое</th><th>Порог</th><th></th> </tr> </thead> <tbody> {{#if combatMeleeWeapons.length}}
          {{#each combatMeleeWeapons as |w|}}
          <tr class="item-row combat-weapon-row" data-item-id="{{w.id}}"> <td class="item-name-cell">{{w.name}}
              {{#if w.hasMods}}<span class="weapon-mod-badge" title="Модификации: {{w.modNames}}">{{w.modNames}}</span>{{/if}}
            </td> <td>{{w.weaponClass}}</td> <td>{{w.damage}}</td> <td>{{w.damageType}}</td> <td>{{w.penetration}}</td> <td class="combat-special-cell">{{w.special}}</td> <td><b>{{w.attackThreshold}}</b></td> <td> <button type="button" class="weapon-hand-btn {{#if (eq w.hand 'left')}}is-on{{/if}}" data-item-id="{{w.id}}" data-hand="left" title="Оружие в левой руке (для HUD)">Л</button> <button type="button" class="weapon-hand-btn {{#if (eq w.hand 'right')}}is-on{{/if}}" data-item-id="{{w.id}}" data-hand="right" title="Оружие в правой руке (для HUD)">П</button> <button type="button" class="weapon-attack-roll combat-atk-btn" data-item-id="{{w.id}}" title="Атака: {{w.name}}">Атака</button> </td> </tr>
          {{#if w.isShield}}
          <tr class="shield-ctl-row" data-item-id="{{w.id}}"> <td colspan="8" class="shield-ctl-cell">
            <span class="shield-ap-badge" title="Броня щита на прикрываемых зонах">AP {{w.shieldAP}}</span>
            <span class="shield-cover" title="Что прикрывает щит">{{w.shieldCoverage}}</span>
            <span class="shield-ctl-spacer"></span>
            <button type="button" class="shield-hand-btn {{#if (eq w.shieldHand 'left')}}is-on{{/if}}" data-item-id="{{w.id}}" data-hand="left" title="Щит в левой руке">Л</button>
            <button type="button" class="shield-hand-btn {{#if (eq w.shieldHand 'right')}}is-on{{/if}}" data-item-id="{{w.id}}" data-hand="right" title="Щит в правой руке">П</button>
            <button type="button" class="shield-raise-btn {{#if w.shieldRaised}}is-on{{/if}}" data-item-id="{{w.id}}" title="Поднять щит: прикрывает зоны «в скобках» (пригнуться/закрыться), но это осознанное действие">{{#if w.shieldRaised}}Щит поднят{{else}}Поднять щит{{/if}}</button>
          </td> </tr> {{/if}} {{/each}}
        {{else}}
          <tr class="items-empty"> <td colspan="8"><em>Нет рукопашного оружия (отметьте «Экипировано» в Снаряжении)</em></td> </tr> {{/if}}
      </tbody> </table> </div> {{!-- ДАЛЬНИЙ БОЙ --}}
  <div class="combat-section-panel"> <div class="panel-title">ДАЛЬНИЙ БОЙ</div> {{#if combatRangedWeapons.length}}
      {{#each combatRangedWeapons as |w|}}
      <div class="ranged-weapon-card" data-item-id="{{w.id}}"> <div class="rwc-main-row"> <span class="rwc-name">{{w.name}}{{#if w.hasMods}} <span class="weapon-mod-badge" title="Модификации: {{w.modNames}}"></span>{{/if}}</span> <span class="rwc-stat-inline" title="Класс">{{w.weaponClass}}</span> <span class="rwc-divider">·</span> <span class="rwc-stat-inline" title="Дальность">{{w.range}}м</span> <span class="rwc-divider">·</span> <span class="rwc-stat-inline" title="СКС">{{w.rof}}</span> <span class="rwc-divider">·</span> <span class="rwc-stat-inline" title="Урон">{{w.damage}}</span> <span class="rwc-stat-inline rwc-dmgtype" title="Тип урона">{{w.damageType}}</span> {{#if w.penetration}}
          <span class="rwc-divider">·</span> <span class="rwc-stat-label-inline">Проб.</span> <span class="rwc-stat-inline">{{w.penetration}}</span> {{/if}}
          <span class="rwc-spacer"></span> <button type="button" class="weapon-hand-btn {{#if (eq w.hand 'left')}}is-on{{/if}}" data-item-id="{{w.id}}" data-hand="left" title="Оружие в левой руке (для HUD)">Л</button> <button type="button" class="weapon-hand-btn {{#if (eq w.hand 'right')}}is-on{{/if}}" data-item-id="{{w.id}}" data-hand="right" title="Оружие в правой руке (для HUD)">П</button> <span class="rwc-threshold-badge">{{w.attackThreshold}}</span> <button type="button" class="weapon-attack-notarget rwc-notarget-btn" data-item-id="{{w.id}}" title="Бросок без цели (тестовый — без авто-расчёта по защите цели)">Без цели</button> <button type="button" class="weapon-attack-roll rwc-atk-btn" data-item-id="{{w.id}}" title="Атака: {{w.name}}" {{#if w.magEmpty}}disabled{{/if}}>Атака</button> </div> <div class="rwc-ammo-row"> {{#if w.compatAmmo.length}}
            <select class="weapon-ammo-select rwc-ammo-select" data-item-id="{{w.id}}"> <option value="">— стандартные —</option> {{#each w.compatAmmo as |ammo|}}
              <option value="{{ammo.id}}" {{#if ammo.loaded}}selected{{/if}}
                      {{#if (eq ammo.quantity 0)}}disabled{{/if}}> {{ammo.name}}{{#if ammo.modStr}} [{{ammo.modStr}}]{{/if}}
              </option> {{/each}}
            </select> {{else}}
            <span class="rwc-no-ammo">Нет боеприпасов</span> {{/if}}
          <div class="rwc-mag-block
            {{#if w.magLow}}rwc-mag-low{{/if}}
            {{#if w.magEmpty}}rwc-mag-empty{{/if}}"> <span class="rwc-mag-cur">{{w.magazineCur}}</span> <span class="rwc-mag-sep">/</span> <span class="rwc-mag-max">{{w.magazineMax}}</span> </div> <button type="button" class="weapon-reload-btn rwc-reload-btn" data-item-id="{{w.id}}" title="Перезарядить: {{w.name}}">Перезар.</button> {{#each w.compatAmmo as |ammo|}}
            {{#if ammo.loaded}}
            <span class="rwc-ammo-stock" title="В запасе: {{ammo.name}}"> {{ammo.quantity}}
            </span> {{/if}}
          {{/each}}
        </div> </div> {{/each}}
    {{else}}
      <div class="rwc-empty"> <em>Нет дальнего оружия (отметьте «Экипировано» в Снаряжении)</em> </div> {{/if}}
  </div> {{!-- ПРИМЕНИТЬ ПРЕПАРАТ — переехало со вкладки ТЕЛО (tab-effects.hbs)
        по просьбе пользователя, контекст (gearDrugs) не менялся. АКТИВНЫЕ
        ПРЕПАРАТЫ остались на ТЕЛЕ. --}}
  <div class="combat-section-panel"> <div class="panel-title">ПРИМЕНИТЬ ПРЕПАРАТ</div> {{#if gearDrugs.length}}
    <table class="items-table effects-drug-table"> <thead> <tr> <th>Препарат</th> <th>Категория</th> <th>Приём</th> <th>Длит.</th> <th>Кол-во</th> <th></th> </tr> </thead> <tbody> {{#each gearDrugs as |drug|}}
        <tr class="drug-apply-row {{#if drug.isActive}}drug-row-active{{/if}}"> <td class="drug-name-cell"> <span class="drug-name-link" data-item-id="{{drug.id}}">{{drug.name}}</span> {{#if drug.isActive}}
              <span class="drug-active-dot" title="Активен · {{drug.roundsRemaining}} ход.">●</span> {{/if}}
            {{#if drug.hasAddiction}}
            <button type="button" class="addiction-test-btn drug-name-test-btn" data-item-id="{{drug.id}}" data-char="{{drug.addictionTestChar}}" data-mod="{{drug.addictionTestMod}}" title="Тест Зависимости">Зав.</button> {{/if}}
          </td> <td>{{drug.categoryLabel}}</td> <td>{{drug.deliveryLabel}}</td> <td class="drug-duration-cell"> {{#if drug.duration}}
            <span class="drug-duration-text" title="Бросается автоматически при применении">{{drug.duration}}</span> {{else}}—{{/if}}
          </td> <td class="drug-qty-cell">{{drug.quantity}}</td> <td> <div class="drug-apply-actions"> <button type="button" class="drug-apply-btn" data-item-id="{{drug.id}}" {{#if (eq drug.quantity 0)}}disabled{{/if}}
                      title="Применить на себе: {{drug.name}}"> Применить
              </button> <button type="button" class="drug-apply-other-btn" data-item-id="{{drug.id}}" {{#if (eq drug.quantity 0)}}disabled{{/if}}
                      title="Применить на выделенной/нацеленной цели (другой токен)"> На другом
              </button> </div> </td> </tr> {{/each}}
      </tbody> </table> {{else}}
    <div class="effects-empty">Нет препаратов в снаряжении</div> {{/if}}
  </div> {{!-- ПСИХОСИЛЫ --}}
  {{#if system.isPsyker}}
  <div class="combat-section-panel"> <div class="panel-title">ПСИХОСИЛЫ</div> <div class="psy-combat-header"> <label>Класс:
        <select name="system.psyker.class"> <option value="bound" {{#if (eq system.psyker.class "bound")}}selected{{/if}}>Связанный</option> <option value="unbound" {{#if (eq system.psyker.class "unbound")}}selected{{/if}}>Несвязанный</option> <option value="daemonic" {{#if (eq system.psyker.class "daemonic")}}selected{{/if}}>Демонический</option> </select> </label> <label>Пси-рейтинг:
        <input type="number" name="system.psyker.rating" value="{{system.psyker.rating}}" min="0" {{#if system.psyker.ratingFromTalent}}disabled title="Равен Рейтингу Таланта Psy Rating / Пси-Рейтинг"{{/if}}/> </label> <label>Поддержание:
        <input type="number" name="system.psyker.sustain" value="{{system.psyker.sustain}}" min="0"/> </label> </div> <table class="items-table psy-powers-table"> <thead> <tr> <th class="col-wide">Название</th><th>Тип</th><th class="col-narrow">PR</th> <th>Действие</th><th>Дальность</th><th>Урон</th> <th class="col-narrow">Подд.</th><th></th> </tr> </thead> <tbody> {{#if psyPowers.length}}
          {{#each psyPowers as |p|}}
          <tr class="item-row {{#if p.isSustained}}psy-row-sustained{{/if}}" data-item-id="{{p.id}}"> <td class="item-name-cell">{{p.name}}
              {{#if p.disciplineLabel}}<div class="psy-discipline-sub">{{p.disciplineLabel}}{{#if p.subtype}} · {{p.subtype}}{{/if}}</div>{{/if}}
            </td> <td>{{p.typeLabel}}</td> <td class="psy-pr-cell">{{p.prRequired}}</td> <td>{{p.actionLabel}}</td> <td>{{p.range}}</td> <td>{{#if p.damage}}{{p.damage}} {{p.damageType}}{{#if p.penetration}} (Пб {{p.penetration}}){{/if}}{{else}}—{{/if}}</td> <td class="psy-sustain-cell"> {{#if p.sustainable}}
              <input type="checkbox" class="psy-sustain-cb" data-item-id="{{p.id}}" {{#if p.isSustained}}checked{{/if}}
                     title="Поддерживать (−{{p.sustainCost}} PR, действие: {{p.sustainActionLabel}})"/> {{else}}—{{/if}}
            </td> <td class="psy-actions-cell"> <button type="button" class="psy-manifest-btn" data-item-id="{{p.id}}" title="Манифестировать (психотест)">Манифест</button> </td> </tr> {{/each}}
        {{else}}
          <tr class="items-empty"><td colspan="8"><em>Нет психосил</em></td></tr> {{/if}}
      </tbody> </table> </div> {{/if}}{{!-- /isPsyker --}}

  {{!-- ТЕХНОЧУДЕСА --}}
  {{#if system.isTechpriest}}
  <div class="combat-section-panel"> <div class="panel-title">ТЕХНОЧУДЕСА</div> <table class="items-table psy-powers-table"> <thead> <tr> <th class="col-wide">Название</th><th>Тип</th> <th class="col-narrow">Ког.</th><th class="col-narrow">Эн.</th> <th>Действие</th><th>Урон</th><th class="col-narrow">Подд.</th><th></th> </tr> </thead> <tbody> {{#if techMiracles.length}}
          {{#each techMiracles as |t|}}
          <tr class="item-row {{#if t.sustained}}psy-row-sustained{{/if}}" data-item-id="{{t.id}}"> <td class="item-name-cell">{{t.name}}
              {{#if t.disciplineLabel}}<div class="psy-discipline-sub">{{t.disciplineLabel}}{{#if t.subtype}} · {{t.subtype}}{{/if}}</div>{{/if}}
            </td> <td>{{t.typeLabel}}</td> <td class="psy-pr-cell">{{t.cognitionCost}}</td> <td class="psy-pr-cell">{{t.energyCost}}</td> <td>{{t.actionLabel}}</td> <td>{{#if t.damage}}{{t.damage}} {{t.damageType}}{{#if t.penetration}} (Пб {{t.penetration}}){{/if}}{{else}}—{{/if}}</td> <td class="psy-sustain-cell"> {{#if t.sustainCost}}
              <input type="checkbox" class="tech-sustain-cb" data-item-id="{{t.id}}" {{#if t.sustained}}checked{{/if}}
                     title="Поддерживать (−{{t.sustainCost}} Ког./ход, действие: {{t.sustainActionLabel}})"/> {{else}}—{{/if}}
            </td> <td class="psy-actions-cell"> <button type="button" class="tech-activate-btn" data-item-id="{{t.id}}" title="Активировать техночудо">Актив.</button> </td> </tr> {{/each}}
        {{else}}
          <tr class="items-empty"><td colspan="8"><em>Нет техночудес</em></td></tr> {{/if}}
      </tbody> </table> </div> {{/if}}{{!-- /isTechpriest --}}

</div>{{!-- /tab combat --}}