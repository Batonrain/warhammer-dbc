{{!-- Шапка Миньона (корбук стр. 111-113).

      Короче хозяйской: ни Архетипа, ни Родного мира, ни Предсказания, ни
      Стремлений — путь слуги определяет Талант Хозяина. Вместо них Лояльность,
      Сила и Группа, а справа — аватар Хозяина, открывающий его лист.

      Раса, Судьба и Усталость — те же поля и та же разметка, что у Персонажа
      (общая creatureSchema, characterContext/buildGetData считают их для любого
      актора). У обычного слуги они не нужны, но комплексный Трейт способен
      сделать миньона Огрином или напичкать его Имплантами Астартес (тогда нужна
      Раса), а «Избранный Судьбой» даёт Очки Судьбы — без полей в шапке взять их
      было неоткуда. --}}
<header class="sheet-header minion-header">
  <div class="portrait-block">
    <img class="profile-img" data-action="minionAvatar" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
  </div>

  <div class="header-main">
    <div class="header-name-row">
      <label class="header-label">Имя</label>
      <input class="actor-name" name="name" type="text" value="{{actor.name}}" placeholder="Имя Миньона"/>
    </div>

    <div class="header-grid">
      <div class="header-rows">
        <div class="header-row-fixed header-row-race">
          <div class="header-cell header-cell-slot">
            <label>Раса</label>
            <div class="wh-slot{{#unless raceSlot}} empty{{/unless}}" data-slot="race">
              {{#if raceSlot}}
              <img class="wh-slot-img" src="{{raceSlot.img}}" alt=""/>
              <span class="wh-slot-name{{#unless raceSlot.applied}} pending{{/unless}}">{{raceSlot.name}}</span>
              {{#if raceSlot.applied}}
              <button type="button" class="wh-slot-btn" data-action="raceOpen" title="Открыть лист расы">⤢</button>
              {{else}}
              <button type="button" class="wh-slot-btn" data-action="raceApply" title="Применить расу">Применить</button>
              {{/if}}
              <button type="button" class="wh-slot-btn" data-action="raceClear" title="Снять расу">✕</button>
              {{else}}
              <button type="button" class="wh-slot-add" data-action="racePick">+ перетащите или нажмите</button>
              {{/if}}
            </div>
          </div>
          {{#if showSubrace}}
          <div class="header-cell header-cell-subrace">
            <label>Субраса</label>
            <div class="subrace-controls">
              <div class="wh-slot{{#unless subraceSlot}} empty{{/unless}}{{#if subraceHint}} locked{{/if}}" data-slot="subrace">
                {{#if subraceSlot}}
                <img class="wh-slot-img" src="{{subraceSlot.img}}" alt=""/>
                <span class="wh-slot-name{{#unless subraceSlot.applied}} pending{{/unless}}">{{subraceSlot.name}}</span>
                {{#if subraceSlot.applied}}
                <button type="button" class="wh-slot-btn" data-action="subraceOpen" title="Открыть лист субрасы">⤢</button>
                {{else}}
                <button type="button" class="wh-slot-btn" data-action="subraceApply" title="Применить субрасу">Применить</button>
                {{/if}}
                <button type="button" class="wh-slot-btn" data-action="subraceClear" title="Снять субрасу">✕</button>
                {{else}}
                {{#if subraceHint}}
                <span class="wh-slot-none" title="{{subraceHint}}">{{subraceHint}}</span>
                {{else}}
                <button type="button" class="wh-slot-add" data-action="subracePick">+ перетащите или нажмите</button>
                {{/if}}
                {{/if}}
              </div>
            </div>
          </div>
          {{/if}}
          {{#if isAstartes}}
          <div class="header-cell header-cell-readonly" title="Геносемя — задаётся мастером создания (меню листа → «Перезапустить мастера создания»)">
            <label>Геносемя</label>
            <div class="header-readonly-val">{{#if headerGeneSeedName}}{{headerGeneSeedName}}{{else}}—{{/if}}</div>
          </div>
          <div class="header-cell header-cell-readonly" title="Культура — задаётся мастером создания (меню листа → «Перезапустить мастера создания»)">
            <label>Культура</label>
            <div class="header-readonly-val">{{#if headerCultureName}}{{headerCultureName}}{{else}}—{{/if}}</div>
          </div>
          {{/if}}
        </div>
        <div class="header-row-fixed header-row-minion">
          <div class="header-cell">
            <label title="Чем этот слуга думает: от группы идут Лояльность и максимум Миньонов">Тип Миньона</label>
            <select name="system.minionType" class="minion-group-select">
              <option value="">— выберите —</option>
              {{#each minion.groupOptions as |g|}}
              <option value="{{g.key}}" {{#if g.selected}}selected{{/if}}>{{g.label}}</option>
              {{/each}}
            </select>
          </div>

          <div class="header-cell">
            <label title="Сила задаёт уровень Таланта, бюджеты создания и Редкость снаряжения">Сила Миньона</label>
            <select name="system.minionTier" class="minion-tier-select">
              <option value="">— выберите —</option>
              {{#each minion.tierOptions as |t|}}
              <option value="{{t.key}}" {{#if t.selected}}selected{{/if}}>{{t.label}}</option>
              {{/each}}
            </select>
          </div>

          <div class="header-cell minion-loyalty-cell">
            <label title="Базовая Лояльность равна Характеристике Хозяина{{#if minion.loyaltyFrom}} ({{minion.loyaltyFrom}}){{/if}} и меняется вместе с ней">Лояльность</label>
            <div class="fate-values">
              <input type="number" name="system.loyalty.value" value="{{minion.loyalty.value}}" min="0" max="{{minion.loyalty.max}}"/>
              <span>/</span>
              <input type="number" name="system.loyalty.max" value="{{minion.loyalty.max}}" min="0"/>
              <button type="button" class="fate-btn minion-loyalty-sync" data-action="minionSyncLoyalty"
                      title="Перечитать Лояльность у Хозяина{{#if minion.loyaltyFrom}} ({{minion.loyaltyFrom}}){{/if}}">🔄</button>
            </div>
          </div>

          {{#if minion.isHorde}}
          {{!-- У Орды Миньонов Ран нет вовсе: её место занимает Магнитуда,
                равная бонусу Бесчестия Хозяина ×5 (стр. 113). --}}
          <div class="header-cell">
            <label title="Магнитуда Орды Миньонов = бонус Бесчестия Хозяина × 5">Магнитуда</label>
            <div class="fate-values">
              <input type="number" name="system.magnitude.value" value="{{minion.magnitude.value}}" min="0"/>
              <span>/</span>
              <input type="number" name="system.magnitude.max" value="{{minion.magnitude.max}}" min="0"/>
            </div>
          </div>
          {{/if}}
        </div>

        {{#if minion.speech}}
        <div class="header-row-fixed minion-speech-row">
          <span class="gene-seed-hint">{{minion.speech}}</span>
        </div>
        {{/if}}
      </div>

      <div class="header-resources">
        <div class="header-cell fate-cell">
          <label>{{fateLabel}}</label>
          <div class="fate-values">
            <input type="number" name="system.fate.value" value="{{system.fate.value}}" min="0" {{#if system.fateMaxAuto}}max="{{system.fate.max}}"{{/if}}/>
            <span>/</span>
            {{#if system.fateMaxAuto}}
            <input type="number" value="{{system.fate.max}}" readonly title="Авторасчёт: W.b × (1 + «Бездонная Душа»)"/>
            {{else}}
            <input type="number" name="system.fate.max" value="{{system.fate.max}}" min="0"/>
            {{/if}}
          </div>
          {{#if fatePips.length}}
          <div class="fate-pips" title="Очки Судьбы">{{#each fatePips as |p|}}<i class="fate-pip {{#if p.on}}on{{/if}}"></i>{{/each}}</div>
          {{/if}}
        </div>
        {{!-- ── Усталость ─────────────────────────────────────────────────── --}}
        <div class="header-cell fate-cell fatigue-cell">
          <label class="fatigue-label">
            Усталость
            {{#if system.fatigue.value}}
            <span class="fatigue-penalty-badge" title="Штраф −10 на все тесты (кроме T, Inf, Cog)">−10</span>
            {{/if}}
          </label>
          <div class="fate-values fatigue-values">
            <input type="number" name="system.fatigue.value" value="{{system.fatigue.value}}" min="0" class="fatigue-value-input{{#if system.fatigue.value}} fatigue-nonzero{{/if}}"/>
            <span>/</span>
            <input type="number" value="{{system.fatigue.max}}" readonly title="Порог Усталости — авторасчёт: T.b + W.b"/>
          </div>
          <div class="fatigue-step-btns">
            <button type="button" class="fatigue-btn fatigue-add-btn" title="Добавить 1 Усталость">+1</button>
            <button type="button" class="fatigue-btn fatigue-remove-btn" title="Снять 1 Усталость">−1</button>
          </div>
          <div class="fatigue-bar" title="Усталость {{fatiguePct}}%"><div class="fatigue-fill load-{{fatigueLevel}}" style="width:{{fatiguePct}}%;"></div></div>
          <div class="fatigue-btns">
            <button type="button" class="fatigue-btn fatigue-rest-btn" title="Час отдыха (−1 Усталость)">Отдых</button>
            <button type="button" class="fatigue-btn fatigue-btn-sleep fatigue-sleep-btn" title="Полноценный сон (снять всю Усталость)">Сон</button>
          </div>
        </div>
        <div class="minion-master">
          {{#if minion.master}}
          <div class="minion-master-card" data-action="minionOpenMaster" title="Открыть лист Хозяина: {{minion.master.name}}">
            <img class="minion-master-img" src="{{minion.master.img}}" alt=""/>
            <div class="minion-master-name">{{minion.master.name}}</div>
            <div class="minion-master-label">Хозяин</div>
          </div>
          {{else}}
          <div class="minion-master-card empty">
            <div class="minion-master-label">Хозяин не назначен</div>
            <div class="gene-seed-hint">Миньон заводится кнопкой «+» в блоке МИНЬОНЫ на вкладке СОЦИУМ Хозяина.</div>
          </div>
          {{/if}}
        </div>
      </div>
    </div>

    {{!-- Фракция — своя у Миньона, не только у Хозяина (по просьбе
          пользователя): предметы-Фракции, тот же общий механизм, что у
          Персонажа/Демона/Принца/Орды (module/apps/actor-factions.mjs). --}}
    {{> "systems/warhammer-dbc/templates/actor/parts/faction-field.hbs"}}
  </div>
</header>
