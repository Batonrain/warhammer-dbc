{{!-- templates/actor/parts/tab-craft.hbs
     Вкладка КРАФТ (wdbc-42a6) — разметка перенесена почти дословно из
     templates/apps/craft-workshop.hbs (отдельное окно «Мастерская» остаётся,
     см. заголовок module/apps/craft-workshop.mjs): убран собственный <form>
     (корневая форма уже даёт сам лист персонажа) и top-level переменные
     контекста переименованы с префиксом craft*/ico*, чтобы не столкнуться с
     одноимёнными ключами остальных вкладок листа (module/sheets/tabs/craft.mjs
     ::craftTabContext). Логика та же, движок тот же. --}}
<div class="tab craft-tab {{#if (eq tab "craft")}}active{{/if}}" data-tab="craft" data-group="primary">
  <div class="wh-craft-form wh-craft-tab-form">
    <div class="wh-craft-scroll">

      {{#each craftProjects as |p|}}
      <section class="wh-craft-project {{#if p.collapsed}}collapsed{{/if}} {{#if p.isResearch}}is-research{{/if}}" data-pid="{{p.id}}">

        {{!-- Шапка проекта --}}
        <header class="wh-craft-phead">
          <button type="button" class="wh-craft-caret" data-act="toggle" title="Свернуть/развернуть">{{#if p.collapsed}}▸{{else}}▾{{/if}}</button>
          <input type="text" name="ptitle" value="{{p.title}}" placeholder="{{p.autoTitle}}" class="wh-craft-ptitle-input"/>
          <span class="wh-craft-psummary" title="Прогресс">{{p.summary}}</span>
          <button type="button" class="wh-craft-premove" data-act="remove" title="Удалить проект">✕</button>
        </header>

        {{#unless p.collapsed}}
        <div class="wh-craft-pbody">

          {{!-- Режим --}}
          <div class="wh-craft-mode">
            <button type="button" data-mode="craft" class="wh-craft-modebtn {{#if p.isCraft}}active{{/if}}">{{{../icoCraft}}}<span>Крафт</span></button>
            <button type="button" data-mode="research" class="wh-craft-modebtn {{#if p.isResearch}}active{{/if}}">{{{../icoResearch}}}<span>Исследование</span></button>
            <button type="button" data-mode="bio" class="wh-craft-modebtn {{#if p.isBio}}active{{/if}}">{{{../icoBio}}}<span>Биолаборатория</span></button>
            <button type="button" data-mode="training" class="wh-craft-modebtn {{#if p.isTraining}}active{{/if}}">{{{../icoTeach}}}<span>Обучение</span></button>
          </div>

          {{!-- Крафтер / Учитель --}}
          <div class="wh-craft-panel">
            <div class="wh-craft-ptitle">{{{../icoCrafter}}} {{#if p.isTraining}}Учитель{{else}}Крафтер{{/if}}</div>
            {{#if p.noCrafters}}
              <div class="wh-craft-hint">Нет доступных крафтеров. На листе персонажа (ЗАМЕТКИ → СТАТУС) отметьте «Доступен для крафта».</div>
            {{else}}
            <select name="crafter" class="wh-craft-select">
              <option value="">— выберите персонажа —</option>
              {{#each p.crafters as |c|}}<option value="{{c.id}}" {{#if (eq c.id p.crafterId)}}selected{{/if}}>{{c.name}}</option>{{/each}}
            </select>
            {{/if}}
          </div>

          {{!-- Что создаём --}}
          {{#if (or p.isBio p.isTraining)}}{{else}}{{#if p.isCraft}}
          <div class="wh-craft-panel">
            <div class="wh-craft-ptitle">{{{../icoCraft}}} Категория предмета</div>
            <div class="wh-craft-catgrid">
              {{#each p.categories as |c|}}
              <button type="button" class="wh-craft-cat {{#if c.selected}}active{{/if}}" data-cat="{{c.key}}" title="{{c.label}}"><span class="wh-craft-cat-ico">{{{c.icon}}}</span><span class="wh-craft-cat-lbl">{{c.label}}</span></button>
              {{/each}}
            </div>
            {{#if p.categoryAlt}}<div class="wh-craft-hint">Альтернатива по книге: {{p.categoryAlt}}</div>{{/if}}
          </div>
          {{else}}
          <div class="wh-craft-panel">
            <div class="wh-craft-ptitle">{{{../icoResearch}}} Тип результата</div>
            <select name="research-kind" class="wh-craft-select">
              {{#each p.researchKinds as |k|}}<option value="{{k.key}}" {{#if k.selected}}selected{{/if}}>{{k.label}}</option>{{/each}}
            </select>
            {{#if p.showPsychicResultType}}
            <label class="wh-craft-sub"><span class="wh-craft-lbl">Какой предмет создать</span>
              <select name="psychic-result-type" class="wh-craft-select">
                {{#each p.psychicResultTypes as |t|}}<option value="{{t.key}}" {{#if t.selected}}selected{{/if}}>{{t.label}}</option>{{/each}}
              </select>
            </label>
            {{/if}}
            {{#if p.isStudy}}
            <label class="wh-craft-sub"><span class="wh-craft-lbl">Для какого Навыка — обоснование</span>
              <input type="text" name="study-target" value="{{p.studyTarget}}" placeholder="например: Scholastic Lore (Xenos)" class="wh-craft-select"/>
            </label>
            <div class="wh-craft-hint">Изучение (книга): Логика «вместо создания знаний» — служит ГМу основанием продвинуть экзотический Навык группы Lore, без учителя/литературы. Предмет не создаётся.</div>
            {{else}}
            <div class="wh-craft-hint">Исследование не использует Trade/Common Lore. Навык выбирается ниже из Знаний крафтера.</div>
            {{/if}}
          </div>
          {{/if}}{{/if}}

          {{#unless (or p.isBio p.isTraining)}}
          {{!-- Параметры --}}
          <div class="wh-craft-panel">
            <div class="wh-craft-ptitle">{{{../icoQuality}}} Сложность и Банк</div>
            <div class="wh-craft-params">
              <label><span class="wh-craft-lbl">Редкость</span>
                <select name="rarity" class="wh-craft-select">{{#each p.rarityOptions as |o|}}<option value="{{o.v}}" {{#if o.selected}}selected{{/if}}>{{o.v}} · {{o.l}}</option>{{/each}}</select>
              </label>
              <label><span class="wh-craft-lbl">Качество</span>
                <select name="quality" class="wh-craft-select">{{#each p.qualityOptions as |o|}}<option value="{{o.k}}" {{#if o.selected}}selected{{/if}}>{{o.label}} (×{{o.mult}})</option>{{/each}}</select>
              </label>
              <label><span class="wh-craft-lbl">Инструменты</span>
                <select name="tool" class="wh-craft-select">{{#each p.tools as |t|}}<option value="{{t.key}}" {{#if t.selected}}selected{{/if}}>{{t.label}} ({{#if (gte t.mod 0)}}+{{/if}}{{t.mod}})</option>{{/each}}</select>
              </label>
              <label><span class="wh-craft-lbl">Базовый Банк</span><input type="number" name="basebank" value="{{p.baseBankVal}}" min="1" class="wh-craft-num"/></label>
              <label><span class="wh-craft-lbl">Ассистенты (успехи/смена)</span><input type="number" name="assistants" value="{{p.assistants}}" min="0" class="wh-craft-num"/></label>
              {{#if p.hasAssistants}}
              <label title="Один из ассистентов — конкретный актор: Подмастерье/Тёмная Муза проверяются по его настоящему инвентарю, не на слово стола">
                <span class="wh-craft-lbl">Ассистент (для Талантов)</span>
                <select name="assistant-actor" class="wh-craft-select">
                  <option value="">— не указан —</option>
                  {{#each p.assistantChoices as |a|}}<option value="{{a.id}}" {{#if (eq a.id p.assistantId)}}selected{{/if}}>{{a.name}}</option>{{/each}}
                </select>
              </label>
              {{/if}}
              <label><span class="wh-craft-lbl">Модификатор ГМа (±)</span><input type="number" name="gmmod" value="{{blankZero p.gmMod}}" placeholder="0" class="wh-craft-num"/></label>
            </div>
            <div class="wh-craft-toggles">
              <label class="wh-craft-check"><input type="checkbox" name="improve" {{#if p.improve}}checked{{/if}}/> Улучшение (−20, Банк /2)</label>
              <label class="wh-craft-check"><input type="checkbox" name="monotony" {{#if p.monotony}}checked{{/if}}/> Монотонность (−30)</label>
              {{#if p.isRepairable}}
              <label class="wh-craft-check" title="Ремонт, а не создание: тот же расширенный тест Tech-Use. Банк Успехов книга для ремонта не называет — впишите его в «Базовый Банк». Мастер-Технопровидец, Фабрикатор и прочие бонусы Крафта действуют и на ремонт.">
                <input type="checkbox" name="repair" {{#if p.repair}}checked{{/if}}/> Ремонт
              </label>
              {{#if p.repair}}
              {{#if p.repairChoices.length}}
              <label title="Когда ремонт будет готов, с выбранного оружия снимется метка «Уничтожено»">
                <span class="wh-craft-lbl">Что чиним</span>
                <select name="repair-weapon" class="wh-craft-select">
                  <option value="">— не привязано к оружию —</option>
                  {{#each p.repairChoices as |w|}}<option value="{{w.id}}" {{#if w.selected}}selected{{/if}}>{{w.name}}</option>{{/each}}
                </select>
              </label>
              {{/if}}
              {{#if p.hasMasterEngineseer}}
              <label class="wh-craft-check" title="Мастер-Технопровидец: чинит без запчастей под рукой — работает в полную силу, но по виду заметно, что чинили без нужных ресурсов">
                <input type="checkbox" name="noparts" {{#if p.noParts}}checked{{/if}}/> Без запчастей
              </label>
              {{/if}}
              {{/if}}
              {{/if}}
              {{#if p.hookUpAvail}}
              <label class="wh-craft-check" title="Крючок: −30 к тесту — готовый наркотик с вдвое меньшим лимитом доз в неделю (окр.▼); принимающие перебрасывают успешный тест Зависимости. Отметьте «Крючок» на листе готового наркотика.">
                <input type="checkbox" name="hookup" {{#if p.hookUp}}checked{{/if}}/> Крючок (−30)
              </label>
              {{/if}}
              {{#if p.hasSlowShiftTalent}}
              <label class="wh-craft-check" title="Медленная Смена: +4ч смены (на слово стола) → +30 и Преимущество">
                <input type="checkbox" name="slowshift" {{#if p.slowShift}}checked{{/if}}/> Медленная Смена (+30, Преимущество, +4ч)
              </label>
              {{/if}}
              {{#if p.torrentChoices.length}}
              <label title="Талант Поток: смена с Tech-Use над огнемётом отмечается на самом оружии — потом стрелок с Потоком может удвоить расход патронов и поставить шаблон Blast">
                <span class="wh-craft-lbl">Работа над огнемётом</span>
                <select name="torrent-weapon" class="wh-craft-select">
                  <option value="">— не над огнемётом —</option>
                  {{#each p.torrentChoices as |w|}}<option value="{{w.uuid}}" {{#if w.selected}}selected{{/if}}>{{w.label}}{{#if w.worked}} (смен: {{w.worked}}){{/if}}</option>{{/each}}
                </select>
              </label>
              {{/if}}
            </div>
            <div class="wh-craft-toggles">
              <span class="wh-craft-lbl">Кубик смены:</span>
              <label class="wh-craft-check"><input type="radio" name="dicemode" value="normal" {{#if (eq p.diceMode "normal")}}checked{{/if}}/> Обычный</label>
              <label class="wh-craft-check"><input type="radio" name="dicemode" value="advantage" {{#if (eq p.diceMode "advantage")}}checked{{/if}}/> Преимущество</label>
              <label class="wh-craft-check"><input type="radio" name="dicemode" value="disadvantage" {{#if (eq p.diceMode "disadvantage")}}checked{{/if}}/> Помеха</label>
              {{#if p.cyberpreacherActive}}<span class="wh-craft-lbl" title="Киберпроповедник: Преимущество на имплантацию бионики/кибернетики">⚙ Киберпроповедник: Преимущество применяется автоматически</span>{{/if}}
            </div>
            {{#if p.notCraftable}}<div class="wh-craft-warn">⚠ По таблице предмет этой Категории не создаётся при выбранной Редкости — задайте Банк вручную или измените Редкость.</div>{{/if}}
            {{#if p.prototypingNote}}<div class="wh-craft-hint" title="Предмет опознаётся по названию проекта (поле вверху); память пишется, когда проект-создание закрыт, и хранится на персонаже-крафтере">{{p.prototypingNote}}</div>{{/if}}
            {{#if p.machineNote}}
            <div class="wh-craft-toggles">
              <label><span class="wh-craft-lbl">Размер машины</span><input type="number" name="machinesize" value="{{p.machineSize}}" min="0" class="wh-craft-num"/></label>
              <div class="wh-craft-hint">Машины: итоговый Банк ×(Размер+1) — уже умножено выше. Орудия создаются отдельно.</div>
            </div>
            {{/if}}
          </div>

          {{!-- Комбинированный тест --}}
          <div class="wh-craft-panel">
            <div class="wh-craft-ptitle">Комбинированный тест</div>
            <table class="wh-craft-table">
              <thead><tr><th class="wh-craft-th-skill">Навык (выберите)</th><th>Всего</th><th>Вклад в Предел</th></tr></thead>
              <tbody>
                {{#each p.testRows as |r|}}
                <tr>
                  <td>
                    <select class="wh-craft-select wh-craft-slot" data-slot="{{r.idx}}">{{#each r.options as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
                    {{#if r.suggestion}}<div class="wh-craft-sugg">по книге: {{r.suggestion}}</div>{{/if}}
                  </td>
                  <td>{{r.total}}</td>
                  <td>{{#if r.isPrimary}}<b>{{r.total}}</b> <span class="wh-craft-syn">ведущий</span>{{else}}+{{r.rankBonus}} <span class="wh-craft-sugg">ранг</span>{{/if}}{{#if r.synergy}} <span class="wh-craft-syn">+{{r.synergy}} синергия</span>{{/if}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
            <div class="wh-craft-limitrow">Итоговый Предел теста: <b class="wh-craft-{{p.limitCls}}">{{p.limit}}</b>
              <span class="wh-craft-modline">(инструменты {{#if (gte p.toolModVal 0)}}+{{/if}}{{p.toolModVal}}{{#if p.gmModVal}} · ГМ {{#if (gte p.gmModVal 0)}}+{{/if}}{{p.gmModVal}}{{/if}}{{#if p.improveMod}} · улучшение {{p.improveMod}}{{/if}}). Редкость и Качество влияют только на Банк.</span>
            </div>
          </div>

          {{!-- Банк и прогресс --}}
          <div class="wh-craft-panel wh-craft-progress">
            <div class="wh-craft-bankrow">
              <div class="wh-craft-bank">Банк Успехов: <b>{{p.bank}}</b></div>
              <div class="wh-craft-shifts">{{{../icoShift}}} Смен: <b>{{p.shifts}}</b> · Усталость: <b>{{p.fatigue}}</b></div>
            </div>
            <div class="wh-craft-bar"><div class="wh-craft-bar-fill{{#if p.done}} done{{/if}}" style="width:{{p.pct}}%"></div><span class="wh-craft-bar-txt">{{p.accumulated}} / {{p.bank}}{{#if p.done}} — ГОТОВО{{/if}}</span></div>
            <div class="wh-craft-actions">
              <button type="button" class="wh-craft-btn primary" data-act="shift" {{#unless p.hasCrafter}}disabled{{/unless}}>{{{../icoShift}}} Отработать смену</button>
              <button type="button" class="wh-craft-btn" data-act="reset">Сбросить прогресс</button>
            </div>
          </div>
          {{/unless}}

          {{#if p.isTraining}}
          {{!-- ═══════════ ОБУЧЕНИЕ (книга, стр. 22) ═══════════ --}}
          <div class="wh-training">

            <div class="wh-craft-panel">
              <div class="wh-craft-ptitle">{{{../icoTeach}}} Чему учим</div>
              {{#if p.training.noTargets}}
              <div class="wh-craft-hint">Учитель не знает ни одного обученного Навыка/Таланта — книга: учить можно только тому, что знаешь сам, и не выше своего уровня.</div>
              {{else}}
              <select name="training-target" class="wh-craft-select">
                {{#each p.training.targets as |t|}}<option value="{{t.value}}" {{#if t.selected}}selected{{/if}}>{{t.label}}{{#if t.rankLabel}} ({{t.rankLabel}}){{/if}}</option>{{/each}}
              </select>
              {{/if}}
              <div class="wh-craft-hint">Trade (Instructor) учителя: <b>{{p.training.instructorTotal}}</b>{{#unless p.training.instructorFound}} (необученная Int — специализации нет){{/unless}}</div>
              <label class="wh-craft-sub"><span class="wh-craft-lbl">Комбинировать тест учителя с</span>
                <select name="social-key" class="wh-craft-select">
                  {{#each p.training.socialOptions as |o|}}<option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
                </select>
              </label>
              <div class="wh-craft-hint">При успехе комбинированного теста — всем ученикам +5×Успехи к Пределу их теста (книга).</div>
              <div class="wh-craft-limitrow">Предел учителя: <b class="wh-craft-{{#if (gte p.training.teacherLimit 50)}}good{{else}}mid{{/if}}">{{p.training.teacherLimit}}</b>
                {{#if p.training.teacherTalent}}<span class="wh-craft-syn">Учитель: Успехи ×2 в формуле xp, без Усталости/монотонности за сеанс</span>{{/if}}</div>
              <label class="wh-craft-check"><input type="checkbox" name="monotony" {{#if p.monotony}}checked{{/if}}/> Монотонность (−30 всем тестам курса при завершении)</label>
            </div>

            <div class="wh-craft-panel">
              <div class="wh-craft-ptitle">{{{../icoCrafter}}} Ученики</div>
              <div class="wh-craft-hint">До <b>{{p.training.studentCap}}</b> учеников в курсе (I.b учителя{{#if p.training.teacherTalent}} ×10 — Учитель{{/if}}){{#if p.training.overCap}} — <b style="color:#f0968a">сейчас больше, курс не завершить</b>{{/if}}</div>
              {{#each p.training.studentRows as |s|}}
              <div class="wh-training-student" data-sidx="{{s.idx}}">
                <span class="wh-training-sname">{{s.name}}</span>
                <select name="student-test" class="wh-craft-select">
                  {{#each s.testOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}} ({{o.total}})</option>{{/each}}
                </select>
                <span class="wh-craft-hint">курсов в месяце: {{s.monthlyUsed}}/{{s.monthlyCap}}{{#if s.overMonthlyCap}} — лимит исчерпан{{/if}}</span>
                <button type="button" class="wh-craft-premove" data-act="remove-student" data-sidx="{{s.idx}}" title="Убрать ученика">✕</button>
              </div>
              {{/each}}
              <select name="student-add" class="wh-craft-select">
                <option value="">— добавить ученика —</option>
                {{#each p.training.studentChoices as |a|}}<option value="{{a.id}}">{{a.name}}</option>{{/each}}
              </select>
            </div>

            <div class="wh-craft-panel wh-craft-progress">
              <div class="wh-craft-bankrow">
                <div class="wh-craft-bank">Сеансы курса: <b>{{p.training.sessionCount}}</b> / {{p.training.sessionsNeeded}}</div>
                <div class="wh-craft-shifts">{{{../icoShift}}} Усталость — каждый сеанс, учителю{{#if p.training.teacherTalent}} (КРОМЕ Учителя){{/if}} и ученикам</div>
              </div>
              <div class="wh-craft-bar"><div class="wh-craft-bar-fill{{#if p.training.canFinish}} done{{/if}}" style="width:{{p.training.sessionPct}}%"></div><span class="wh-craft-bar-txt">{{p.training.sessionCount}} / {{p.training.sessionsNeeded}}</span></div>
              <div class="wh-craft-actions">
                <button type="button" class="wh-craft-btn primary" data-act="session" {{#unless p.hasCrafter}}disabled{{/unless}}>{{{../icoShift}}} Отработать сеанс</button>
                <button type="button" class="wh-craft-btn primary" data-act="finish-course" {{#unless p.training.canFinish}}disabled{{/unless}}>{{{../icoTeach}}} Завершить курс</button>
              </div>
            </div>

            {{#if p.training.courseLog.length}}
            <div class="wh-craft-panel">
              <div class="wh-craft-ptitle">Журнал курсов (этот проект)</div>
              {{#each p.training.courseLog as |c|}}
              <div class="wh-craft-hint">«{{c.target}}»: {{#each c.students as |s|}}{{s.name}} +{{s.xp}}xp{{#unless @last}}, {{/unless}}{{/each}}</div>
              {{/each}}
            </div>
            {{/if}}

          </div>
          {{/if}}

          {{#if p.isBio}}
          {{!-- ═══════════ БИОЛАБОРАТОРИЯ ДРУКХАРИ ═══════════ --}}
          <div class="wh-bio">

            {{!-- Чан: живая графика --}}
            <div class="wh-craft-panel wh-bio-vatpanel">
              <div class="wh-bio-stage">
                <svg class="wh-bio-vat {{#if p.bio.ripe}}is-ripe{{/if}}" viewBox="0 0 120 170" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="bioFluid" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%"   stop-color="#7fd8a0" stop-opacity=".55"/>
                      <stop offset="55%"  stop-color="#3f9c6a" stop-opacity=".75"/>
                      <stop offset="100%" stop-color="#14361f" stop-opacity=".95"/>
                    </linearGradient>
                    <radialGradient id="bioGlow" cx="50%" cy="50%" r="50%">
                      <stop offset="0%"   stop-color="#d9ffe8"/>
                      <stop offset="45%"  stop-color="#6fe6a0"/>
                      <stop offset="100%" stop-color="#0d2416" stop-opacity="0"/>
                    </radialGradient>
                    <clipPath id="bioJar"><path d="M26 40h68v96a16 16 0 01-16 16H42a16 16 0 01-16-16z"/></clipPath>
                  </defs>

                  {{!-- крышка и патрубки --}}
                  <path class="wh-bio-cap" d="M36 20h48v20H36z"/>
                  <path class="wh-bio-pipe" d="M46 20V8h28v12M60 8V2"/>
                  <path class="wh-bio-pipe" d="M26 62H12v46h14M94 62h14v46H94"/>

                  {{!-- жидкость, свечение, пузыри --}}
                  <g clip-path="url(#bioJar)">
                    <rect x="26" y="40" width="68" height="112" fill="url(#bioFluid)"/>
                    <circle class="wh-bio-glow" cx="60" cy="100" r="34" fill="url(#bioGlow)"/>
                    <g class="wh-bio-bubbles">
                      <circle cx="42" cy="150" r="3"/><circle cx="58" cy="150" r="2"/>
                      <circle cx="72" cy="150" r="3.5"/><circle cx="50" cy="150" r="2.4"/>
                      <circle cx="66" cy="150" r="1.8"/><circle cx="80" cy="150" r="2.6"/>
                    </g>
                    {{!-- эмбрион импланта: растёт вместе с прогрессом --}}
                    <g class="wh-bio-embryo">
                      <path d="M60 84c9 5 13 15 10 24-3 8-11 13-19 11-8-2-13-10-11-19 2-8 11-14 20-16z"/>
                      <path d="M60 90c5 4 6 12 3 18M56 96c-4 4-5 10-2 15"/>
                      <circle cx="64" cy="96" r="2.2"/>
                    </g>
                  </g>

                  {{!-- стекло, шкала, блик --}}
                  <path class="wh-bio-glass" d="M26 40h68v96a16 16 0 01-16 16H42a16 16 0 01-16-16z"/>
                  <path class="wh-bio-scale" d="M30 60h8M30 76h6M30 92h8M30 108h6M30 124h8"/>
                  <path class="wh-bio-shine" d="M36 52v84"/>
                </svg>

                <div class="wh-bio-readout">
                  <div class="wh-bio-title">ФЕРМЕНТНЫЙ ЧАН</div>
                  <div class="wh-bio-sub">{{#if p.bio.selName}}{{p.bio.selName}}{{else}}Образец не заряжен{{/if}}</div>
                  <div class="wh-bio-cyclebar">
                    <div class="wh-bio-cyclefill{{#if p.bio.ripe}} ripe{{/if}}" style="width:{{p.bio.cyclePct}}%"></div>
                    <span>Цикл {{p.bio.cycle}} / {{p.bio.cycles}}{{#if p.bio.ripe}} — СБОР УРОЖАЯ{{/if}}</span>
                  </div>
                  <div class="wh-bio-costs">
                    <span class="wh-bio-cost">{{{../icoBiomass}}}<b>{{p.bio.biomass}}</b> биомассы</span>
                    <span class="wh-bio-cost {{#if p.bio.freeSolution}}is-free{{/if}}">{{{../icoSolution}}}<b>{{p.bio.solution}}</b> раствора</span>
                    <span class="wh-bio-cost {{#unless p.bio.needTemplate}}is-off{{/unless}}">{{{../icoTemplate}}}{{#if p.bio.needTemplate}}нужен шаблон{{else}}без шаблона{{/if}}</span>
                    <span class="wh-bio-cost">{{{../icoShift}}}<b>{{p.bio.hours}}</b> ч</span>
                  </div>
                </div>
              </div>
              <div class="wh-craft-hint"><b>Допуск к чану:</b> {{p.bio.entryReq}}</div>
            </div>

            {{!-- Настройка партии --}}
            <div class="wh-craft-panel">
              <div class="wh-craft-ptitle">{{{../icoBio}}} Партия</div>
              <div class="wh-bio-grid">
                <label>Что выращиваем
                  <select name="bio-implant" class="wh-craft-select">
                    <option value="">— выберите биоимплант —</option>
                    {{#each p.bio.catalogGroups as |g|}}
                    <optgroup label="{{g.label}}">
                      {{#each g.items as |i|}}<option value="{{i.key}}" {{#if i.selected}}selected{{/if}}>{{i.label}}</option>{{/each}}
                    </optgroup>
                    {{/each}}
                  </select>
                </label>
                <label>Качество чана
                  <select name="vat" class="wh-craft-select">
                    {{#each p.bio.vats as |v|}}<option value="{{v.key}}" {{#if v.selected}}selected{{/if}}>{{v.label}} · R{{v.rarity}}</option>{{/each}}
                  </select>
                </label>
                <label>Желаемое качество
                  <select name="bio-target" class="wh-craft-select">
                    {{#each p.bio.targets as |t|}}<option value="{{t.key}}" {{#if t.selected}}selected{{/if}}>{{t.label}} — {{t.parts}}</option>{{/each}}
                  </select>
                </label>
                <label>Тест
                  <select name="bio-skill" class="wh-craft-select">
                    {{#each p.bio.skills as |k|}}<option value="{{k.key}}" {{#if k.selected}}selected{{/if}}>{{k.label}}</option>{{/each}}
                  </select>
                </label>
              </div>
              <div class="wh-craft-hint wh-bio-vatnote">{{p.bio.vatNote}}</div>

              <div class="wh-craft-limitrow">Модификатор теста:
                <b class="wh-craft-{{#if p.bio.blocked}}bad{{else}}good{{/if}}">{{p.bio.modSign}}{{p.bio.mod}}</b>
                <span class="wh-craft-modline">качество импланта + качество чана{{#if p.bio.rerolls}} · перебросов у чана: {{p.bio.rerolls}}{{/if}}</span>
              </div>

              {{#if p.bio.blocked}}
              <div class="wh-bio-blocks">
                {{#each p.bio.blocks as |b|}}<div class="wh-bio-block">✕ {{b}}</div>{{/each}}
              </div>
              {{/if}}

              {{#if p.bio.needTemplate}}
              <details class="wh-bio-tpl">
                <summary>{{{../icoTemplate}}} Генетический шаблон — где взять</summary>
                <div class="wh-craft-hint">{{p.bio.tplSources}}</div>
                <div class="wh-craft-hint">{{p.bio.tplNote}}</div>
                <div class="wh-bio-tplnum">Для R{{p.bio.rarity}} средних габаритов: Good.Q — <b>{{p.bio.tplGood}}</b> успехов, Best.Q — <b>{{p.bio.tplBest}}</b>. Это Исследование Medicae — заведите его отдельным проектом.</div>
              </details>
              {{/if}}

              <div class="wh-craft-actions">
                <button type="button" class="wh-craft-btn primary" data-act="bio-cycle" {{#unless p.hasCrafter}}disabled{{/unless}}>{{{../icoBio}}} Прогнать цикл (24 ч)</button>
                <button type="button" class="wh-craft-btn" data-act="bio-reset">Слить чан</button>
              </div>
            </div>

            {{!-- Журнал циклов --}}
            {{#if p.bio.log.length}}
            <div class="wh-craft-panel">
              <div class="wh-craft-ptitle">Журнал чана</div>
              <table class="wh-craft-table wh-bio-log">
                <thead><tr><th>Цикл</th><th>Бросок</th><th>Предел</th><th>Ст.</th><th>Исход</th><th>Итог</th></tr></thead>
                <tbody>
                  {{#each p.bio.log as |l|}}
                  <tr><td>{{l.cycle}}</td><td>{{l.roll}}</td><td>{{l.limit}}</td><td>{{l.dos}}</td><td>{{l.outcome}}</td><td>{{l.quality}}</td></tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
            {{/if}}

            {{!-- Справка по исходам --}}
            <details class="wh-craft-panel wh-bio-outcomes">
              <summary class="wh-craft-ptitle">Результаты теста</summary>
              {{#each p.bio.outcomes as |o|}}
              <div class="wh-bio-outcome"><b>{{o.label}}</b> <i>({{o.dos}})</i><div>{{o.text}}</div></div>
              {{/each}}
            </details>

          </div>
          {{/if}}

        </div>
        {{/unless}}
      </section>
      {{/each}}

      <button type="button" class="wh-craft-add" data-act="add-project">＋ Добавить крафт / исследование</button>

      {{!-- Журнал Исследований (wdbc-research-journal) — находки, уже открытые
           ЭТИМ персонажем: Чертежи/Истинные имена/Иное легли предметом в
           инвентарь, Психосила/Ритуал/Вязь — тем же путём, Изучение — только
           строкой-обоснованием без предмета. Нет в отдельном окне «Мастерская»
           (party-инструмент без одного владельца), только на этой вкладке. --}}
      {{#if craftResearchJournal.length}}
      <details class="wh-craft-panel wh-craft-journal" open>
        <summary class="wh-craft-ptitle">{{{icoResearch}}} Журнал Исследований</summary>
        <table class="wh-craft-table wh-research-journal">
          <thead><tr><th>Вид находки</th><th>Навык / обоснование</th><th>Результат</th></tr></thead>
          <tbody>
            {{#each craftResearchJournal as |j|}}
            <tr>
              <td>{{j.kindLabel}}</td>
              <td>{{j.skillLabel}}{{#if j.studyTarget}} → {{j.studyTarget}}{{/if}}</td>
              <td>
                {{#if j.hasItem}}
                <button type="button" class="wh-craft-btn wh-journal-open" data-act="open-finding" data-item-id="{{j.itemId}}">{{j.itemName}}</button>
                {{else}}
                {{#if j.itemName}}{{j.itemName}}{{else}}{{j.title}}{{/if}}
                {{/if}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </details>
      {{/if}}

      <details class="wh-craft-panel wh-craft-mats">
        <summary class="wh-craft-ptitle">{{{icoMaterial}}} Материалы (справочно)</summary>
        <table class="wh-craft-table">
          <thead><tr><th>R</th><th>Материал</th><th>Описание</th></tr></thead>
          <tbody>{{#each craftMaterials as |m|}}<tr><td>{{m.r}}</td><td>{{m.name}}</td><td class="wh-craft-matdesc">{{m.desc}}</td></tr>{{/each}}</tbody>
        </table>
      </details>

    </div>
  </div>
</div>
