<div class="tab gear-cog {{#if (eq tab "gear")}}active{{/if}}" data-tab="gear" data-group="primary">

  {{!-- ═══ Сенсор нагрузки (всегда виден) ═══ --}}
  <div class="gear-section-panel gear-load-panel">
    <div class="panel-title">СЕНСОР НАГРУЗКИ <span class="gl-code">// ENC.SYS</span></div>
    <div class="gear-load">
      <div class="gl-readout">
        <span class="gl-cur load-{{encumbranceLevel}}">{{system.encumbrance.current}}</span>
        <span class="gl-sep">/</span>
        <span class="gl-max">{{system.encumbrance.max}}</span>
        <span class="gl-unit">КГ</span>
        {{#unless (eq system.encumbrance.gravity 1)}}
          <span class="gl-gravity" title="Гравитация сцены — эффективный вес снаряжения {{system.encumbrance.effectiveCurrent}} кг вместо {{system.encumbrance.current}} кг">🪐 {{system.encumbrance.gravity}}G</span>
        {{/unless}}
      </div>
      <div class="gl-bar"><div class="gl-fill load-{{encumbranceLevel}}" style="width:{{encumbrancePct}}%;"></div><span class="gl-pct">{{encumbrancePct}}%</span></div>
      <div class="gl-status load-{{encumbranceLevel}}">{{#if encumbranceOver}}◈ ПЕРЕГРУЗ{{else}}◈ В НОРМЕ{{/if}}</div>
      <div class="gl-tiers">
        <span title="Ношение — без штрафов">Ношение {{system.encumbrance.carry}} кг</span>
        <span title="Подъём — макс. вес, поднимаемый с земли">Подъём {{system.encumbrance.lift}} кг</span>
        <span title="Толкание — макс. вес, сдвигаемый по полу">Толкание {{system.encumbrance.push}} кг</span>
      </div>
    </div>
  </div>

  {{!-- Панель действий --}}
  <div class="gear-add-row">
    <button type="button" class="add-item-btn gear-add-btn" data-action="itemAdd">Добавить предмет</button>
    <button type="button" class="gear-lib-btn gear-add-btn" data-action="gearLib" title="Выбрать оружие, броню или снаряжение из библиотеки">📚 Из библиотеки</button>
    <button type="button" class="rig-open-btn gear-add-btn" data-action="rigOpen" title="Разместить предметы по слотам разгрузок">Разгрузка</button>
  </div>

  {{!-- ═══════════════════ ОРУЖИЕ ═══════════════════ --}}
  <section class="gear-cat {{#if gearCollapse.weapons}}collapsed{{/if}}" data-cat="weapons">
    <div class="gear-cat-head" data-action="gearCat" data-gear-cat="weapons">
      <span class="gear-cat-chevron">▾</span>
      <span class="gear-cat-title">ОРУЖИЕ</span>
      <span class="gear-cat-count">{{gearWeapons.length}}</span>
    </div>
    <div class="gear-cat-body">
      <table class="items-table gear-table">
        <thead><tr>
          <th class="gear-equip-th">Экип.</th><th>Оружие</th><th>Класс</th><th>Тип</th>
          <th>Урон</th><th>Тип урона</th><th>Маг.</th><th>Вес</th>
        </tr></thead>
        <tbody>
          {{#if gearWeapons.length}}
            {{#each gearWeapons as |w|}}
            <tr class="item-row gear-host-row {{#if w.mods.length}}has-mods{{/if}}" data-item-id="{{w.id}}">
              <td class="gear-equip-cell"><input type="checkbox" class="weapon-equip-cb" data-item-id="{{w.id}}" {{#if w.equipped}}checked{{/if}} {{#if w.integralAttack}}disabled title="Интегральная атака — снять нельзя"{{/if}}/></td>
              <td class="item-name-cell">{{w.name}}{{#if w.integralAttack}} <span class="gear-integral-badge" title="Интегральная атака: часть тела или машины. Есть, пока работает то, что её даёт.">врождённая</span>{{/if}}{{#if w.mods.length}} <button type="button" class="gear-mods-toggle" data-action="gearModsToggle" data-host-id="{{w.id}}" title="Свернуть/развернуть улучшения"><span class="gmt-chevron">▾</span>⚙{{w.mods.length}}</button>{{/if}}</td>
              <td>{{w.weaponClass}}</td><td>{{w.weaponType}}</td>
              <td>{{w.damage}}</td><td>{{w.damageType}}</td>
              <td>{{w.magazineCur}}/{{w.magazineMax}}</td><td>{{w.weight}}</td>
            </tr>
            {{#each w.mods as |m|}}
            <tr class="item-row gear-modsub-row" data-item-id="{{m.id}}" data-host-id="{{w.id}}">
              <td class="gear-modsub-arrow">↳</td>
              <td class="gear-modsub-main" colspan="6">
                <button type="button" class="ability-detail-toggle gear-modsub-toggle" data-action="abilityDetail" data-item-id="{{m.id}}" title="Показать/скрыть описание">▸</button>
                <span class="gear-modsub-name">{{m.name}}</span>
                {{#if m.groupLabel}}<span class="gear-modsub-group">{{m.groupLabel}}</span>{{/if}}
                <button type="button" class="gear-mod-uninstall" data-item-id="{{m.id}}" title="Снять модификацию">✕ снять</button>
              </td>
              <td>{{m.weight}}</td>
            </tr>
            <tr class="ability-detail-row" data-item-id="{{m.id}}" data-host-id="{{w.id}}" style="display:none;"><td colspan="8"><div class="ability-detail-text">{{#if m.benefit}}{{m.benefit}}{{else}}—{{/if}}</div></td></tr>
            {{/each}}
            {{/each}}
          {{else}}
            <tr class="items-empty"><td colspan="8"><em>Нет оружия</em></td></tr>
          {{/if}}
        </tbody>
      </table>

      {{!-- Не установленные модификации оружия --}}
      {{#if gearWeaponModsFree.length}}
      <div class="gear-free-block">
        <div class="gear-free-title">Модификации оружия — не установлены</div>
        <table class="items-table gear-table gear-free-table">
          <tbody>
            {{#each gearWeaponModsFree as |m|}}
            <tr class="item-row gear-free-row" data-item-id="{{m.id}}">
              <td class="ability-toggle-cell"><button type="button" class="ability-detail-toggle" data-action="abilityDetail" data-item-id="{{m.id}}" title="Показать/скрыть описание">▸</button></td>
              <td class="item-name-cell">{{m.name}}</td>
              <td class="gear-free-group">{{m.groupLabel}}</td>
              <td class="gear-free-install">
                <select class="gear-mod-install" data-item-id="{{m.id}}" title="Установить на оружие">
                  <option value="">Установить на…</option>
                  {{#each m.targets as |t|}}<option value="{{t.id}}">{{t.name}}{{#if t.equipped}} ✓{{/if}}</option>{{/each}}
                </select>
              </td>
              <td class="gear-free-weight">{{m.weight}}</td>
            </tr>
            <tr class="ability-detail-row" data-item-id="{{m.id}}" style="display:none;"><td colspan="5"><div class="ability-detail-text">{{#if m.benefit}}{{m.benefit}}{{else}}—{{/if}}</div></td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{/if}}
    </div>
  </section>

  {{!-- ═══════════════════ БРОНЯ ═══════════════════ --}}
  <section class="gear-cat {{#if gearCollapse.armor}}collapsed{{/if}}" data-cat="armor">
    <div class="gear-cat-head" data-action="gearCat" data-gear-cat="armor">
      <span class="gear-cat-chevron">▾</span>
      <span class="gear-cat-title">БРОНЯ И СИСТЕМЫ</span>
      <span class="gear-cat-count">{{gearArmor.length}}</span>
    </div>
    <div class="gear-cat-body">
      <table class="items-table gear-table">
        <thead><tr>
          <th class="gear-equip-th">Экип.</th><th>Броня</th><th>Тип</th>
          <th title="Голова">Гол.</th><th title="Корпус">Корп.</th>
          <th title="Левая рука">Л.Р.</th><th title="Правая рука">П.Р.</th>
          <th title="Левая нога">Л.Н.</th><th title="Правая нога">П.Н.</th><th>Вес</th>
        </tr></thead>
        <tbody>
          {{#if gearArmor.length}}
            {{#each gearArmor as |a|}}
            <tr class="item-row gear-host-row {{#if a.equipped}}item-row-equipped{{/if}} {{#if a.mods.length}}has-mods{{/if}}" data-item-id="{{a.id}}">
              <td class="gear-equip-cell"><input type="checkbox" class="armor-equip-cb" data-item-id="{{a.id}}" {{#if a.equipped}}checked{{/if}}/></td>
              <td class="item-name-cell">{{a.name}}{{#if a.mods.length}} <button type="button" class="gear-mods-toggle" data-action="gearModsToggle" data-host-id="{{a.id}}" title="Свернуть/развернуть модификации и системы"><span class="gmt-chevron">▾</span>⚙{{a.mods.length}}</button>{{/if}}</td>
              <td class="gear-armor-type">
                {{#if (eq a.armorType "simple")}}Простая{{/if}}
                {{#if (eq a.armorType "flak")}}Флак{{/if}}
                {{#if (eq a.armorType "mesh")}}Ячеистая{{/if}}
                {{#if (eq a.armorType "carapace")}}Панцирная{{/if}}
                {{#if (eq a.armorType "power")}}Силовая{{/if}}
                {{#if (eq a.armorType "aspect")}}Аспектная{{/if}}
              </td>
              <td class="gear-ap-cell {{#if a.equipped}}gear-ap-active{{/if}}">{{a.head}}</td>
              <td class="gear-ap-cell {{#if a.equipped}}gear-ap-active{{/if}}">{{a.body}}</td>
              <td class="gear-ap-cell {{#if a.equipped}}gear-ap-active{{/if}}">{{a.leftArm}}</td>
              <td class="gear-ap-cell {{#if a.equipped}}gear-ap-active{{/if}}">{{a.rightArm}}</td>
              <td class="gear-ap-cell {{#if a.equipped}}gear-ap-active{{/if}}">{{a.leftLeg}}</td>
              <td class="gear-ap-cell {{#if a.equipped}}gear-ap-active{{/if}}">{{a.rightLeg}}</td>
              <td>{{a.weight}}</td>
            </tr>
            {{#each a.mods as |m|}}
            <tr class="item-row gear-modsub-row {{#if m.activatable}}{{#unless m.active}}gear-modsub-off{{/unless}}{{/if}}" data-item-id="{{m.id}}" data-host-id="{{a.id}}">
              <td class="gear-modsub-arrow">↳</td>
              <td class="gear-modsub-main" colspan="8">
                <button type="button" class="ability-detail-toggle gear-modsub-toggle" data-action="abilityDetail" data-item-id="{{m.id}}" title="Показать/скрыть описание">▸</button>
                <span class="gear-modsub-name">{{m.name}}</span>
                {{#if m.powerSystem}}<span class="gear-sys-badge" title="Система силовой брони">⚡</span>{{/if}}
                {{#if m.groupLabel}}<span class="gear-modsub-group">{{m.groupLabel}}</span>{{/if}}
                {{#if m.activatable}}
                <button type="button" class="armormod-active-toggle gear-modsub-power {{#if m.active}}is-on{{/if}}" data-item-id="{{m.id}}" title="Включить/выключить систему (бонусы учитываются только во включённом состоянии)">{{#if m.active}}ВКЛ{{else}}выкл{{/if}}</button>
                {{/if}}
                <button type="button" class="gear-mod-uninstall" data-item-id="{{m.id}}" title="Снять">✕ снять</button>
              </td>
              <td>{{m.weight}}</td>
            </tr>
            <tr class="ability-detail-row" data-item-id="{{m.id}}" data-host-id="{{a.id}}" style="display:none;"><td colspan="10"><div class="ability-detail-text">{{#if m.benefit}}{{m.benefit}}{{else}}—{{/if}}</div></td></tr>
            {{/each}}
            {{/each}}
          {{else}}
            <tr class="items-empty"><td colspan="10"><em>Нет брони</em></td></tr>
          {{/if}}
        </tbody>
      </table>

      {{!-- Не установленные модификации/системы брони --}}
      {{#if gearArmorModsFree.length}}
      <div class="gear-free-block">
        <div class="gear-free-title">Модификации и системы — не установлены</div>
        <table class="items-table gear-table gear-free-table">
          <tbody>
            {{#each gearArmorModsFree as |m|}}
            <tr class="item-row gear-free-row" data-item-id="{{m.id}}">
              <td class="ability-toggle-cell"><button type="button" class="ability-detail-toggle" data-action="abilityDetail" data-item-id="{{m.id}}" title="Показать/скрыть описание">▸</button></td>
              <td class="item-name-cell">{{m.name}}{{#if m.powerSystem}} <span class="gear-sys-badge" title="Система силовой брони">⚡</span>{{/if}}</td>
              <td class="gear-free-group">{{m.groupLabel}}</td>
              <td class="gear-free-install">
                {{#if m.noTargets}}
                  <span class="gear-free-notarget" title="{{#if m.powerSystem}}Нужна броня типа «Силовая»{{else}}Нет брони{{/if}}">{{#if m.powerSystem}}нет силовой брони{{else}}нет брони{{/if}}</span>
                {{else}}
                <select class="gear-mod-install" data-item-id="{{m.id}}" title="{{#if m.powerSystem}}Установить на силовую броню{{else}}Установить на броню{{/if}}">
                  <option value="">Установить на…</option>
                  {{#each m.targets as |t|}}<option value="{{t.id}}">{{t.name}}{{#if t.equipped}} ✓{{/if}}</option>{{/each}}
                </select>
                {{/if}}
              </td>
              <td class="gear-free-weight">{{m.weight}}</td>
            </tr>
            <tr class="ability-detail-row" data-item-id="{{m.id}}" style="display:none;"><td colspan="5"><div class="ability-detail-text">{{#if m.benefit}}{{m.benefit}}{{else}}—{{/if}}</div></td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{/if}}
    </div>
  </section>

  {{!-- ═══════════════════ СИЛОВЫЕ ПОЛЯ ═══════════════════ --}}
  <section class="gear-cat {{#if gearCollapse.shields}}collapsed{{/if}}" data-cat="shields">
    <div class="gear-cat-head" data-action="gearCat" data-gear-cat="shields">
      <span class="gear-cat-chevron">▾</span>
      <span class="gear-cat-title">СИЛОВЫЕ ПОЛЯ</span>
      <span class="gear-cat-count">{{gearForcefields.length}}</span>
    </div>
    <div class="gear-cat-body">
      <table class="items-table gear-table shield-gear-table">
        <thead><tr>
          <th class="shield-th-status" title="Статус"></th>
          <th>Силовое поле</th>
          <th class="shield-th-nature" title="Природа">Прир.</th>
          <th class="shield-th-type">Тип</th>
          <th class="shield-th-rating">Рейтинг</th>
          <th class="shield-th-cur" title="Текущий рейтинг">Тек.</th>
          <th class="shield-th-weight">Вес</th>
          <th class="shield-th-action"></th>
        </tr></thead>
        <tbody>
          {{#if gearForcefields.length}}
            {{#each gearForcefields as |f|}}
            <tr class="item-row shield-row shield-row-{{f.statusKey}}" data-item-id="{{f.id}}">
              <td class="shield-status-cell"><span class="shield-status-dot shield-dot-{{f.statusKey}}" title="{{f.statusLabel}}">{{f.statusIcon}}</span></td>
              <td class="item-name-cell">{{f.name}}</td>
              <td class="shield-nature-cell">
                {{#if (eq f.shieldNature "technological")}}<span class="shield-nature-tech" title="Технологический"></span>{{else}}<span class="shield-nature-warp" title="Чародейский"></span>{{/if}}
              </td>
              <td class="shield-type-cell">
                {{#if (eq f.shieldType "dome")}}<span class="shield-type-badge shield-type-dome">Купол</span>{{else if (eq f.shieldType "deflector")}}<span class="shield-type-badge shield-type-deflector">Дефлект.</span>{{else}}<span class="shield-type-badge shield-type-penetrating">Сквозной</span>{{/if}}
              </td>
              <td class="shield-rating-cell">
                {{#if f.isSpecialRating}}<span class="shield-rating-special">особый</span>{{else}}<span class="shield-rating-range">{{f.ratingMin}}–{{f.ratingMax}}</span>{{#if f.overloadThreshold}}<span class="shield-overload-sep">/</span><span class="shield-overload-val">{{f.overloadThreshold}}</span>{{else}}<span class="shield-overload-none">/−</span>{{/if}}{{/if}}
              </td>
              <td class="shield-cur-cell">{{#if f.equipped}}<span class="shield-cur-active">{{f.currentRating}}</span>{{else}}<span class="shield-cur-off">—</span>{{/if}}</td>
              <td class="shield-weight-cell">{{f.weight}}</td>
              <td class="shield-action-cell">
                <button type="button" class="shield-toggle-btn" data-item-id="{{f.id}}" title="{{#if f.equipped}}Деактивировать{{else}}Активировать{{/if}} {{f.name}}">{{#if f.equipped}}Выкл{{else}}Вкл{{/if}}</button>
                {{#if f.equipped}}<button type="button" class="shield-roll-btn" data-item-id="{{f.id}}" title="Бросок щита против попадания">Бросок</button>{{/if}}
                {{#if f.needsRepair}}<button type="button" class="shield-repair-btn" data-item-id="{{f.id}}" title="Сбросить перегрузку / отремонтировать">Ремонт</button>{{/if}}
              </td>
            </tr>
            {{/each}}
          {{else}}
            <tr class="items-empty"><td colspan="8"><em>Нет силовых полей</em></td></tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </section>

  {{!-- ═══════════════════ БОЕПРИПАСЫ ═══════════════════ --}}
  <section class="gear-cat {{#if gearCollapse.ammo}}collapsed{{/if}}" data-cat="ammo">
    <div class="gear-cat-head" data-action="gearCat" data-gear-cat="ammo">
      <span class="gear-cat-chevron">▾</span>
      <span class="gear-cat-title">БОЕПРИПАСЫ</span>
      <span class="gear-cat-count">{{gearAmmo.length}}</span>
    </div>
    <div class="gear-cat-body">
      <table class="items-table gear-table">
        <thead><tr><th>Боеприпасы</th><th>Оружие</th><th>Кол-во</th><th>Вес</th><th>Всего</th></tr></thead>
        <tbody>
          {{#if gearAmmo.length}}
            {{#each gearAmmo as |a|}}
            <tr class="item-row" data-item-id="{{a.id}}"><td class="item-name-cell">{{a.name}}</td><td>{{a.weaponTypes}}</td><td>{{a.quantity}}</td><td>{{a.weight}}</td><td>{{a.totalWeight}}</td></tr>
            {{/each}}
          {{else}}
            <tr class="items-empty"><td colspan="5"><em>Нет боеприпасов</em></td></tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </section>

  {{!-- ═══════════════════ СНАРЯЖЕНИЕ ═══════════════════ --}}
  <section class="gear-cat {{#if gearCollapse.gear}}collapsed{{/if}}" data-cat="gear">
    <div class="gear-cat-head" data-action="gearCat" data-gear-cat="gear">
      <span class="gear-cat-chevron">▾</span>
      <span class="gear-cat-title">СНАРЯЖЕНИЕ</span>
      <span class="gear-cat-count">{{gearGear.length}}</span>
    </div>
    <div class="gear-cat-body">
      <table class="items-table gear-table">
        <thead><tr><th>Снаряжение</th><th>Описание</th><th>Кол-во</th><th>Вес</th><th>Всего</th></tr></thead>
        <tbody>
          {{#if gearGear.length}}
            {{#each gearGear as |g|}}
            <tr class="item-row" data-item-id="{{g.id}}"><td class="item-name-cell">{{g.name}}</td><td></td><td>{{g.quantity}}</td><td>{{g.weight}}</td><td>{{g.totalWeight}}</td></tr>
            {{/each}}
          {{else}}
            <tr class="items-empty"><td colspan="5"><em>Нет снаряжения</em></td></tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </section>

  {{!-- ═══════════════════ ПРЕПАРАТЫ ═══════════════════ --}}
  <section class="gear-cat {{#if gearCollapse.drugs}}collapsed{{/if}}" data-cat="drugs">
    <div class="gear-cat-head" data-action="gearCat" data-gear-cat="drugs">
      <span class="gear-cat-chevron">▾</span>
      <span class="gear-cat-title">ПРЕПАРАТЫ</span>
      <span class="gear-cat-count">{{gearDrugs.length}}</span>
    </div>
    <div class="gear-cat-body">
      <table class="items-table gear-table">
        <thead><tr><th>Препараты</th><th>Описание</th><th>Кол-во</th><th>Вес</th><th>Всего</th></tr></thead>
        <tbody>
          {{#if gearDrugs.length}}
            {{#each gearDrugs as |d|}}
            <tr class="item-row" data-item-id="{{d.id}}"><td class="item-name-cell">{{d.name}}</td><td></td><td>{{d.quantity}}</td><td>{{d.weight}}</td><td>{{d.totalWeight}}</td></tr>
            {{/each}}
          {{else}}
            <tr class="items-empty"><td colspan="5"><em>Нет препаратов</em></td></tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </section>

  {{!-- ═══════════════════ ИНСТРУМЕНТЫ ═══════════════════ --}}
  <section class="gear-cat {{#if gearCollapse.tools}}collapsed{{/if}}" data-cat="tools">
    <div class="gear-cat-head" data-action="gearCat" data-gear-cat="tools">
      <span class="gear-cat-chevron">▾</span>
      <span class="gear-cat-title">ИНСТРУМЕНТЫ</span>
      <span class="gear-cat-count">{{gearTools.length}}</span>
    </div>
    <div class="gear-cat-body">
      <table class="items-table gear-table">
        <thead><tr><th>Инструменты</th><th>Описание</th><th>Кол-во</th><th>Вес</th></tr></thead>
        <tbody>
          {{#if gearTools.length}}
            {{#each gearTools as |t|}}
            <tr class="item-row" data-item-id="{{t.id}}"><td class="item-name-cell">{{t.name}}</td><td></td><td>{{t.quantity}}</td><td>{{t.weight}}</td></tr>
            {{/each}}
          {{else}}
            <tr class="items-empty"><td colspan="4"><em>Нет инструментов</em></td></tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </section>

  {{!-- ═══════════════════ ИМПЛАНТЫ ═══════════════════ --}}
  <section class="gear-cat {{#if gearCollapse.implants}}collapsed{{/if}}" data-cat="implants">
    <div class="gear-cat-head" data-action="gearCat" data-gear-cat="implants">
      <span class="gear-cat-chevron">▾</span>
      <span class="gear-cat-title">ИМПЛАНТЫ</span>
      <span class="gear-cat-count">{{gearImplants.length}}</span>
    </div>
    <div class="gear-cat-body">
      <table class="items-table gear-table">
        <thead><tr><th>Имплант</th><th>Категория</th><th>Качество</th><th>Эффект</th></tr></thead>
        <tbody>
          {{#if gearImplants.length}}
            {{#each gearImplants as |im|}}
            <tr class="item-row" data-item-id="{{im.id}}"><td class="item-name-cell">{{im.name}}</td><td>{{im.category}}</td><td>{{im.quality}}</td><td class="implant-effect-cell">{{im.effect}}</td></tr>
            {{/each}}
          {{else}}
            <tr class="items-empty"><td colspan="4"><em>Нет имплантов — перетащите из библиотеки</em></td></tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </section>

</div>{{!-- /tab gear --}}
