{{!-- ══════════════════════════════════════════════════════════════════════ --}}
{{!--  СОЦИУМ — всё, чем персонаж действует на других: Навыки, Таланты,      --}}
{{!--  Особенности, Модификаторы, Назначения, Фракции, Миньоны, Отношения.  --}}
{{!-- ══════════════════════════════════════════════════════════════════════ --}}
<div class="tab social-tab {{#if (eq tab "social")}}active{{/if}}" data-tab="social" data-group="primary">

  {{!-- ── Фракции: перетащить сюда или «＋» (Обозреватель с фильтром) ── --}}
  <div class="notes-section-panel social-factions">
    <div class="panel-title">ФРАКЦИИ <span class="gene-seed-hint" style="font-weight:400;">— перетащите Фракцию сюда или нажмите ＋</span></div>
    {{!-- Классы .faction-drop-zone / .wh-faction-add / .wh-faction-remove —
          те же, что у прежнего поля шапки: их слушает
          activateFactionFieldListeners (apps/actor-factions.mjs). --}}
    <div class="faction-drop-zone social-faction-zone" data-tooltip="Перетащите предмет-Фракцию">
      {{#each actorFactions as |f|}}
      <div class="social-faction-card" title="{{f.hint}}">
        <img class="social-faction-img" src="{{f.img}}" alt="{{f.name}}"/>
        <div class="social-faction-main">
          <a class="social-faction-name social-open-item" data-item-id="{{f.id}}" title="Открыть лист Фракции">{{f.name}}</a>
          <div class="social-faction-hint">{{f.hint}}</div>
        </div>
        <button type="button" class="wh-faction-remove" data-item-id="{{f.id}}" title="Убрать принадлежность">✕</button>
      </div>
      {{else}}
      <div class="gene-seed-hint">Фракций нет — перетащите сюда или нажмите ＋.</div>
      {{/each}}
      <button type="button" class="wh-faction-add social-faction-add" title="Выбрать фракцию в Обозревателе компендиумов">＋</button>
    </div>
  </div>

  {{!-- ── Навыки: только социальные, бросок отсюда ── --}}
  <div class="notes-section-panel">
    <div class="panel-title">НАВЫКИ <span class="gene-seed-hint" style="font-weight:400;">— клик по названию бросает тест</span></div>
    <div class="social-skills">
      {{#each socialSkills as |sk|}}
      <div class="social-skill">
        <a class="social-skill-name skill-roll" data-action="skillRoll" data-skill="{{sk.key}}" title="Бросок: {{sk.label}}">{{sk.label}}</a>
        <span class="social-skill-total {{#if (lt sk.total 0)}}skill-neg{{else}}skill-pos{{/if}}">{{sk.total}}</span>
      </div>
      {{/each}}
    </div>
  </div>

  {{!-- ── Таланты: только те, что про социальное ── --}}
  <div class="notes-section-panel">
    <div class="panel-title">ТАЛАНТЫ <span class="gene-seed-hint" style="font-weight:400;">— влияющие на социальные Навыки, Общительность, Лояльность или Сплочённость</span></div>
    {{#if socialTalents.length}}
    <table class="items-table"><tbody>
      {{#each socialTalents as |t|}}
      <tr class="item-row" title="{{t.summary}}">
        <td class="item-name-cell social-open-item" data-item-id="{{t.id}}" title="Открыть">{{t.name}}</td>
        <td class="godgift-god col-narrow">{{t.reasons}}</td>
        <td class="social-summary">{{t.summary}}</td>
      </tr>
      {{/each}}
    </tbody></table>
    {{else}}<div class="gene-seed-hint">Талантов, влияющих на социальное, нет.</div>{{/if}}
  </div>

  {{!-- ── Особенности: Черты и Мутации, тоже по социальному следу ── --}}
  <div class="notes-section-panel">
    <div class="panel-title">ОСОБЕННОСТИ <span class="gene-seed-hint" style="font-weight:400;">— Черты и Мутации, влияющие на социальное</span></div>
    {{#if socialFeatures.length}}
    <table class="items-table"><tbody>
      {{#each socialFeatures as |f|}}
      <tr class="item-row" title="{{f.summary}}">
        <td class="item-name-cell social-open-item" data-item-id="{{f.id}}" title="Открыть">{{f.name}}</td>
        <td class="godgift-god col-narrow">{{f.kind}} · {{f.reasons}}</td>
        <td class="social-summary">{{f.summary}}</td>
      </tr>
      {{/each}}
    </tbody></table>
    {{else}}<div class="gene-seed-hint">Черт и Мутаций, влияющих на социальное, нет.</div>{{/if}}
  </div>

  {{!-- ── Модификаторы: что правит социальные Навыки ── --}}
  <div class="notes-section-panel">
    <div class="panel-title">МОДИФИКАТОРЫ <span class="gene-seed-hint" style="font-weight:400;">— снаряжение, эффекты и силы, что двигают социальные Навыки, Общительность, Лояльность или Сплочённость</span></div>
    {{#if socialModifiers.length}}
    <table class="items-table"><tbody>
      {{#each socialModifiers as |m|}}
      <tr class="item-row">
        <td class="item-name-cell social-open-item" data-item-id="{{m.id}}" data-uuid="{{m.uuid}}" title="Открыть">{{m.name}}</td>
        <td class="godgift-god col-narrow">{{m.kind}}</td>
        <td class="social-summary">{{m.effects}}</td>
      </tr>
      {{/each}}
    </tbody></table>
    {{else}}<div class="gene-seed-hint">Ничего, что двигало бы социальное, не найдено.</div>{{/if}}
  </div>

  {{!-- ── Назначения: где актор числится ── --}}
  <div class="notes-section-panel">
    <div class="panel-title">НАЗНАЧЕНИЯ <span class="gene-seed-hint" style="font-weight:400;">— Отряды, Формирования, должности на корабле и места в технике</span></div>
    {{#if socialAssignments.length}}
    <table class="items-table"><tbody>
      {{#each socialAssignments as |a|}}
      <tr class="item-row">
        <td class="item-name-cell social-open-actor" data-uuid="{{a.uuid}}" title="Открыть лист">{{a.name}}</td>
        <td class="godgift-god col-narrow">{{a.kind}}</td>
        <td class="social-summary">{{a.role}}</td>
      </tr>
      {{/each}}
    </tbody></table>
    {{else}}<div class="gene-seed-hint">Ни в одном Отряде, Формировании, экипаже или расчёте не числится.</div>{{/if}}
  </div>

  {{!-- ── Патрон / Протеже: субраса «Наследник», Трейт Помазанник(X) ──
        Наследник хранит ссылку на своего Демона-Принца; сам Принц отдельного
        списка не хранит — видит подопечных по оформленным дарам «Помазанник»
        (вкладка АПОФЕОЗ) и незавершённым заявкам с их стороны (wdbc-yo6r). --}}
  {{#if patronAvailable}}
  {{#if isProtegeList}}
  <div class="notes-section-panel social-minions">
    <div class="panel-title">
      ПРОТЕЖЕ
      <span class="gene-seed-hint" style="font-weight:400;">— смертные, отмеченные даром «Помазанник» (вкладка АПОФЕОЗ)</span>
    </div>
    {{#if proteges.length}}
    <div class="minion-cards">
      {{#each proteges as |p|}}
      <div class="minion-card{{#if p.uuid}} patron-open-link{{/if}}" data-uuid="{{p.uuid}}"
           title="{{#if p.uuid}}Открыть лист: {{p.name}}{{else}}Цель ещё не выбрана — правится в system.dp.gifts{{/if}}">
        <img class="minion-card-img" src="{{p.img}}" alt=""/>
        <div class="minion-card-name">{{p.name}}{{#if p.missing}} (актор удалён){{/if}}</div>
        <div class="minion-card-meta">Помазанник ({{p.rating}})</div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="gene-seed-hint">Дар «Помазанник» ещё не оформлен ни на кого.</div>
    {{/if}}
    {{#if patronPending.length}}
    <div class="gene-seed-hint">Заявили этого Принца патроном, но дар не оформлен:
      {{#each patronPending as |p|}}<span class="minion-slot-chip patron-open-link" data-uuid="{{p.uuid}}" title="Открыть лист">{{p.name}}</span>{{/each}}
    </div>
    {{/if}}
  </div>
  {{else}}
  <div class="notes-section-panel social-minions">
    <div class="panel-title">
      ПАТРОН
      <span class="gene-seed-hint" style="font-weight:400;">— субраса «Наследник»: Трейт Помазанник(X) Демона-Принца</span>
    </div>
    {{#if patronLinked}}
      {{#if patronActor}}
      <div class="minion-cards">
        <div class="minion-card patron-open-link" data-uuid="{{patronActor.uuid}}" title="Открыть лист: {{patronActor.name}}">
          <img class="minion-card-img" src="{{patronActor.img}}" alt=""/>
          <div class="minion-card-name">{{patronActor.name}}</div>
          <div class="minion-card-meta">{{patronActor.godLabel}} · Помазанник ({{patronRating}}){{#unless patronConfirmed}} — дар не найден на его стороне{{/unless}}</div>
        </div>
      </div>
      {{else}}
      <div class="gene-seed-hint">Связанный актор Демона-Принца не найден в мире (удалён или недоступен).</div>
      {{/if}}
      <button type="button" class="patron-clear-btn" title="Снять связь">Снять патрона</button>
    {{else}}
      <div class="gene-seed-hint">Патрон ещё не выбран — перетащите сюда актора Демона-Принца, если он уже есть в мире, или впишите его текстом заранее.</div>
      <div class="social-relations-zone patron-drop-zone" data-tooltip="Перетащите актора Демона-Принца сюда">
        <label>Имя (пока нет актора): <input type="text" class="patron-name-input" value="{{patronStub.name}}" placeholder="Имя патрона"/></label>
        <label>Бог:
          <select class="patron-god-select">
            <option value="">—</option>
            {{#each patronGods as |g|}}<option value="{{g.key}}" {{#if g.selected}}selected{{/if}}>{{g.label}}</option>{{/each}}
          </select>
        </label>
      </div>
      <label>Помазанник (X, ожидаемо): <input type="number" class="patron-rating-input" value="{{patronRating}}" min="0"/></label>
    {{/if}}
  </div>
  {{/if}}
  {{/if}}

  {{!-- ── Командование вне Отряда ──
        Командовать можно и теми, кто в Отряд не сведён. Слаженности и Риска у
        такой группы нет — это свойства сведённого отряда, — поэтому порог
        теста здесь чистый Command(F). --}}
  <div class="notes-section-panel cmd-free">
    <div class="panel-title">
      ПОД МОИМ ПРИСУТСТВИЕМ
      <span class="minion-count" title="Сколько подчинённых вне Отряда">{{followerCount}}</span>
      <span class="gene-seed-hint" style="font-weight:400;">— перетащите актора или возьмите выделенные токены</span>
      <button type="button" class="cmd-take-tokens" title="Взять под Присутствие все выделенные на сцене токены">Взять выделенные</button>
    </div>

    {{!-- Броски Команд --}}
    <div class="cmd-rolls">
      <button type="button" class="cmd-roll-btn{{#if presenceActive}} cmd-on{{/if}}" data-cmd-roll="presence"
              title="Command(F)+0. Одно преимущество на выбор, меняется в начале Хода">
        Присутствие{{#if presenceActive}} ✦{{/if}}</button>
      <button type="button" class="cmd-roll-btn{{#if shortActive}} cmd-on{{/if}}" data-cmd-roll="short"
              title="Полудействие. Бонус = Успехи × множитель приказа">
        Короткая{{#if shortActive}} +{{shortBonus}}{{/if}}</button>
      <button type="button" class="cmd-roll-btn{{#if detailActive}} cmd-on{{/if}}" data-cmd-roll="detail"
              title="Полное действие. Успехи тратятся на эффекты">
        Детальная{{#if detailActive}} {{detailSuccesses}}{{/if}}</button>
      <button type="button" class="cmd-clear" title="Снять всё отданное — конец боя или потеря Командования">Сбросить</button>
      {{#if exoditeLord}}
      <button type="button" class="cmd-lord-clear" title="Полное действие: вывести до F.b выделенных союзников из Страха/Шока/Подавления">Вывести из состояний</button>
      <button type="button" class="cmd-lord-rally" title="Command(F)−10: восстановить 1 очко Судьбы всем эльдарам своего Отряда, включая себя">Судьба Отряду</button>
      {{/if}}
    </div>

    <div class="cmd-presence-row">
      <label>Преимущество Присутствия:</label>
      <select data-cmd-benefit>
        {{#each presenceBenefits as |b|}}
        <option value="{{b.key}}" {{#if b.selected}}selected{{/if}} title="{{b.desc}}">{{b.number}}. {{b.label}}</option>
        {{/each}}
      </select>
    </div>

    {{#if detailActive}}
    <div class="cmd-detail-picks">
      {{#each detailCommands as |c|}}
      <button type="button" class="cmd-detail-pick{{#if c.picked}} cmd-picked{{/if}}{{#unless c.afford}} cmd-poor{{/unless}}"
              data-key="{{c.key}}" title="{{c.desc}}"><span class="sq-chat-cost">{{c.cost}}</span> {{c.label}}</button>
      {{/each}}
    </div>
    {{/if}}

    {{!-- Список подчинённых --}}
    <div class="cmd-followers-zone" data-tooltip="Перетащите актора сюда">
      {{#each followers as |f|}}
      <div class="cmd-follower{{#if f.missing}} sq-member-missing{{/if}}" data-index="{{f.idx}}">
        <img class="cmd-follower-img social-open-actor" data-uuid="{{f.uuid}}" src="{{f.img}}" alt="{{f.name}}" title="Открыть лист"/>
        <div class="cmd-follower-main">
          <div class="cmd-follower-line">
            <a class="cmd-follower-name social-open-actor" data-uuid="{{f.uuid}}">{{f.name}}</a>
            <span class="godgift-god">{{f.typeLabel}}</span>
            {{#unless f.reach.commands}}<span class="sq-member-badge sq-badge-limited"
              title="{{#each f.reach.notes}}{{this}} {{/each}}">Только Присутствие 1 и 3</span>{{/unless}}
            {{#unless f.reach.presenceApplies}}<span class="sq-member-badge sq-badge-off"
              title="Выбранное преимущество Присутствия до него не доходит">Присутствие мимо</span>{{/unless}}
          </div>
          <div class="cmd-follower-stats">
            {{#if f.hp}}<span>{{f.hp}}</span>{{/if}}
            {{#if f.wp}}<span title="Воля">W {{f.wp}}</span>{{/if}}
            {{#if f.psychDamage}}<span class="cmd-psych" title="Психологический урон — его и лечит тест Командования">Псих. {{f.psychDamage}}</span>{{/if}}
          </div>
          <input type="text" class="cmd-follower-note" data-index="{{f.idx}}" value="{{f.note}}" placeholder="Заметка (роль, приказ…)"/>
        </div>
        <div class="cmd-follower-acts">
          {{#if f.isHorde}}
          <a class="cmd-rally" data-uuid="{{f.uuid}}" title="Речь к Орде: тест Командования лечит ей психологический урон"><i class="fas fa-bullhorn"></i></a>
          {{/if}}
          <a class="cmd-follower-remove" data-index="{{f.idx}}" title="Вывести из-под Присутствия"><i class="fas fa-times"></i></a>
        </div>
      </div>
      {{else}}
      <div class="gene-seed-hint">Никого. Перетащите сюда актора или выделите токены на сцене и нажмите «Взять выделенные».</div>
      {{/each}}
    </div>

    {{#if commandedHordes.length}}
    <div class="gene-seed-hint cmd-horde-hint">Ордам доходят только эффекты 1 и 3 Присутствия; Короткие и Детальные Команды на них не действуют, а тест Командования лечит им психологический урон.</div>
    {{/if}}
  </div>

  {{!-- ── Миньоны (стр. 111-113) ──
        Блока нет, пока не куплен Талант «Миньон Хаоса»: слуг даёт Талант.
        В шапке — сколько их какой группы и каков максимум (наименьший бонус
        Характеристики по имеющимся группам). «+» появляется, когда Талантов
        куплено больше, чем заведено слуг. --}}
  {{#if hasMinionTalent}}
  <div class="notes-section-panel social-minions">
    <div class="panel-title">
      МИНЬОНЫ
      <span class="minion-count" title="Занято слуг из максимума: максимум — наименьший бонус Характеристики по имеющимся группам (стр. 111)">
        {{minionCount}} / {{minionCapacity}}
      </span>
      {{#each minionTally as |t|}}<span class="minion-tally">{{t.label}}: {{t.count}}</span>{{/each}}
      {{#if freeSlots.length}}
      <button type="button" class="minion-add-btn" data-action="minionCreate"
              title="Создать Миньона по купленному Таланту: свободных Талантов — {{freeSlots.length}}">+</button>
      {{/if}}
    </div>

    {{#if minionRows.length}}
    <div class="minion-cards">
      {{#each minionRows as |m|}}
      <div class="minion-card minion-open-link" data-uuid="{{m.uuid}}" title="Открыть лист: {{m.name}}">
        <img class="minion-card-img" src="{{m.img}}" alt=""/>
        <div class="minion-card-name">{{m.name}}</div>
        <div class="minion-card-meta">{{m.groupLabel}} · {{m.tierLabel}}</div>
        <div class="minion-card-loyalty">
          {{#if m.magnitude}}Магнитуда {{m.magnitude}}{{else}}Лояльность {{m.loyaltyValue}}/{{m.loyaltyMax}}{{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="gene-seed-hint">Талант куплен, а слуги ещё нет — нажмите «+», чтобы собрать его по правилам книги.</div>
    {{/if}}

    {{#if freeSlots.length}}
    <div class="gene-seed-hint">Свободных Талантов: {{freeSlots.length}} —
      {{#each freeSlots as |s|}}<span class="minion-slot-chip">{{s.label}}</span>{{/each}}
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{!-- ── Отношения ── --}}
  <div class="notes-section-panel social-relations">
    <div class="panel-title">ОТНОШЕНИЯ <span class="gene-seed-hint" style="font-weight:400;">— перетащите сюда Персонажа, Орду, Демона или Принца Демонов</span></div>
    <div class="social-relations-zone" data-tooltip="Перетащите актора сюда">
      {{#each socialRelations as |r|}}
      <div class="social-relation" data-index="{{r.idx}}">
        <div class="social-relation-head">
          <img class="social-relation-img" src="{{r.img}}" alt="{{r.name}}"/>
          <a class="social-relation-name social-open-actor" data-uuid="{{r.uuid}}" title="Открыть лист">{{r.name}}</a>
          <span class="godgift-god">{{r.kind}}</span>
          <input type="text" class="social-relation-note" data-index="{{r.idx}}" value="{{r.note}}" placeholder="Заметка"/>
          <button type="button" class="social-relation-remove" data-index="{{r.idx}}" title="Убрать">✕</button>
        </div>
        <table class="items-table social-relation-table">
          <thead><tr>{{#each ../relationSkillCols as |c|}}<th>{{c.label}}</th>{{/each}}</tr></thead>
          <tbody><tr>
            {{#each r.mods as |m|}}
            <td>
              <select class="social-relation-mod" data-index="{{../r.idx}}" data-skill="{{m.key}}" title="{{m.title}}">
                {{#each m.options as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
              </select>
            </td>
            {{/each}}
          </tr></tbody>
        </table>
      </div>
      {{else}}
      <div class="gene-seed-hint">Отношений нет — перетащите сюда актора.</div>
      {{/each}}
    </div>
  </div>

</div>
