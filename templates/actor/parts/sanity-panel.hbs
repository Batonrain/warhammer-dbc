{{!-- Панель БЕЗУМИЕ — вынесена из sanity-corruption-panels.hbs (wdbc-ycgk),
      чтобы вкладка ТЕЛО у Персонажа/Миньона/Принца могла показать её
      отдельно от Порчи (субвкладка «Разум»), а не только парой в 2 колонки.
      У Демона (tab-stats.hbs) обе панели по-прежнему идут вместе через
      sanity-corruption-panels.hbs, которая теперь просто включает эту и
      corruption-panel.hbs подряд — вывод для него не меняется. --}}
<div class="stat-panel panel-side insanity-panel" data-collapse-key="insanity-panel"> <div class="panel-title" data-action="panelCollapse">БЕЗУМИЕ <span class="side-code">// PSY</span></div> <div class="panel-body side-body"> <div class="side-main-val"> <input type="number" name="system.insanity.value" value="{{system.insanity.value}}" min="0"/> <button type="button" class="stat-add-btn" data-action="statAdd" data-stat="insanity" title="Добавить Безумие (число или XdY+Z, напр. 2d10+3)">＋</button> </div> <div class="side-bar"><div class="side-fill load-{{insanityLevel}}" style="width:{{insanityPct}}%;"></div><span class="side-pct">{{insanityPct}}</span></div> <button type="button" class="side-roll-btn fear-roll" title="Тест Страха → таблица Шока">Страх</button> <button type="button" class="side-roll-btn trauma-roll" title="Тест Ментальной Травмы → таблица Травмы">Травма</button> <button type="button" class="side-roll-btn disorder-roll" title="Случайное Ментальное Расстройство (d100)">Расстройство</button> {{#if mentalTraumas.length}}<button type="button" class="side-roll-btn trauma-suppress" title="Подавление активной Ментальной Травмы (стр. 473)">Подавить Травму</button>{{/if}} {{#if mentalDisorders.length}}<button type="button" class="side-roll-btn disorder-suppress" title="Подавление активного Ментального Расстройства (стр. 473)">Подавить Расстройство</button>{{/if}} </div> </div>
