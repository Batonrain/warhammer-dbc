<div class="tab notes-cog {{#if (eq tab "notes")}}active{{/if}}" data-tab="notes" data-group="primary">

  {{!-- Телосложение переехало в меню «Настройки листа» у шапки (actor-sheet.mjs,
        _changeBodyType) — блок радиокнопок здесь больше не нужен. --}}

  {{!-- Родной мир, Предсказание и Стремления — переехали из шапки Персонажа
        (Демон/Принц/Миньон их там никогда не показывали, поэтому и здесь
        только для actor.type "character"). Классы .hw-select/.dv-select/
        .aspir-* те же, что были в шапке — их слушают actor-sheet.mjs и
        activateAspirationListeners (tabs/aspirations.mjs) независимо от
        места в DOM. --}}
  {{#if (eq actor.type "character")}}
  {{#if (or homeworld divination)}}
  <div class="notes-section-panel homeworld-panel">
    <div class="panel-title">РОДНОЙ МИР И ПРЕДСКАЗАНИЕ</div>
    <div class="origin-grid">
      {{#if homeworld}}
      <div class="header-cell" title="Родной мир персонажа: три модификатора Характеристик и Особенность"> <label>Происхождение</label> <div class="hw-controls"> <select class="hw-select"> <option value="">— не выбрано —</option> <option value="random">🎲 Выбрать случайно</option> {{#each homeworld.options as |o|}}
          <option value="{{o.key}}" {{#if o.selected}}selected{{/if}} title="{{o.chars}}">{{o.label}}</option> {{/each}}
        </select> </div> </div>
      {{/if}}
      {{#if divination}}
      <div class="header-cell" title="Предсказание судьбы: эффект по таблице к100"> <label>Предсказание</label> <div class="hw-controls"> <select class="dv-select"> <option value="">— не выбрано —</option> <option value="random">🎲 Бросить к100</option> {{#each divination.options as |o|}}
          <option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option> {{/each}}
        </select> </div> </div>
      {{/if}}
    </div>
  </div>
  {{/if}}

  <div class="notes-section-panel">
    <div class="panel-title">СТРЕМЛЕНИЯ</div>
    <div class="notes-aspir-row">
      {{#each aspirationSlots as |a|}}
      <div class="header-cell header-cell-aspir"> <label>{{a.label}}</label>
        <div class="aspir-controls">
          {{#if a.custom}}
          <input type="text" class="aspir-custom-name" data-index="{{a.idx}}" value="{{a.name}}" placeholder="Своё стремление"/>
          <input type="text" class="aspir-custom-mods" data-index="{{a.idx}}" value="{{a.mods}}" placeholder="Модификаторы"/>
          {{else}}
          <select class="aspir-select" data-index="{{a.idx}}" title="{{#if a.mods}}{{a.mods}}{{else}}Выберите Стремление{{/if}}"> <option value="">— выбрать —</option>
            {{#each a.options as |e|}}<option value="{{e.id}}" {{#if (eq e.id a.id)}}selected{{/if}} title="{{e.mods}}">{{e.name}}</option>{{/each}}
            <option value="__custom__">Своё…</option>
          </select>
          {{/if}}
          <button type="button" class="aspir-remove" data-index="{{a.idx}}" title="Очистить">✕</button>
        </div>
        <div class="aspir-mods-line" title="Модификаторы — справка: применяются к Базе вручную">{{#if a.mods}}{{a.mods}}{{else}}&nbsp;{{/if}}</div>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if showPatronPicker}}
  <div class="notes-section-panel chaos-patron-panel">
    <div class="panel-title">ПОКРОВИТЕЛЬ ХАОСА</div>
    <div class="chaos-patron-grid">
      {{#each chaosPatrons as |p|}}
      <label class="chaos-patron-opt {{#if p.selected}}sel{{/if}}" title="{{p.label}}" style="--pg:{{p.color}};--pgs:{{p.gc2}};--pgl:{{p.glow}}">
        <input type="radio" name="system.patronGod" value="{{p.key}}" {{#if p.selected}}checked{{/if}}/>
        <span class="chaos-patron-sigil" style="-webkit-mask:url('{{p.sigil}}') center/contain no-repeat;mask:url('{{p.sigil}}') center/contain no-repeat"></span>
        <span class="chaos-patron-name">{{p.label}}</span>
        <span class="chaos-patron-favor">
          <span class="chaos-patron-favor-val" title="Благосклонность — {{p.label}}">{{p.favor}}</span>
          <button type="button" class="stat-add-btn patron-favor-add" data-action="statAdd" data-stat="patronFavor" data-god="{{p.key}}" title="Добавить Благосклонность — {{p.label}}">＋</button>
        </span>
      </label>
      {{/each}}
    </div>
    <div class="chaos-patron-note">Выбор Бога окрашивает лист и определяет преимущество/недостаток Очков Бесчестия (корбук 438).</div>
  </div>
  {{/if}}
  {{#if showWorldOrigin}}
  <div class="notes-section-panel aeldari-origin-panel"> <div class="panel-title">ПРОИСХОЖДЕНИЕ (АЭЛЬДАРИ)</div>
    <div class="origin-grid"> <div class="origin-row"> <label class="origin-label">Мир-Корабль</label> <select name="system.world" class="origin-select">{{{worldOptions}}}</select> </div>
      {{#if selectedWorld}}<div class="origin-info"> <div class="origin-chars">{{selectedWorld.chars}}</div> <div class="origin-special">{{selectedWorld.special}}</div> </div>{{/if}}
      <div class="origin-row"> <label class="origin-label">Корсарская Банда</label> <select name="system.band" class="origin-select">{{{bandOptions}}}</select> </div>
      {{#if selectedBand}}<div class="origin-info"> <div class="origin-chars">{{selectedBand.chars}}</div> <div class="origin-special">{{selectedBand.special}}</div> </div>{{/if}}
    </div>
    <div class="gene-seed-hint">Модификаторы характеристик применяются в Базу при создании персонажа (вручную). Особенность — справка для отыгрыша.</div>
  </div> {{/if}}
  {{#if isDrukhari}}
  <div class="notes-section-panel aeldari-origin-panel"> <div class="panel-title">ПРОИСХОЖДЕНИЕ (ДРУКХАРИ)</div>
    <div class="origin-grid"> <div class="origin-row"> <label class="origin-label">Кабал / Культ / Ковен</label> <select name="system.drukhariFaction" class="origin-select">{{{drukhariFactionOptions}}}</select> </div>
      {{#if selectedDrukhariFaction}}<div class="origin-info"> <div class="origin-chars">{{selectedDrukhariFaction.chars}}</div> <div class="origin-special">{{selectedDrukhariFaction.special}}</div> </div>{{/if}}
      <div class="origin-row"> <label class="origin-label">Район Комморага</label> <select name="system.drukhariDistrict" class="origin-select">{{{drukhariDistrictOptions}}}</select> </div>
      {{#if selectedDrukhariDistrict}}<div class="origin-info"> <div class="origin-chars">{{selectedDrukhariDistrict.chars}}</div> <div class="origin-special">{{selectedDrukhariDistrict.special}}</div> </div>{{/if}}
      {{!-- Корсарские банды — общие для Аэльдари и Друкхари: в банде ходят и те, и другие. --}}
      <div class="origin-row"> <label class="origin-label">Корсарская Банда</label> <select name="system.band" class="origin-select">{{{bandOptions}}}</select> </div>
      {{#if selectedBand}}<div class="origin-info"> <div class="origin-chars">{{selectedBand.chars}}</div> <div class="origin-special">{{selectedBand.special}}</div> </div>{{/if}}
    </div>
    <div class="gene-seed-hint">Выберите ОДНО из: Кабал, Культ Ведьм или Ковен Гемункулов — и отдельно Район Комморага (берётся вместе с фракцией). Модификаторы характеристик применяются в Базу при создании (вручную); особенность — справка.</div>
  </div> {{/if}}
  {{#if isHarlequin}}
  <div class="notes-section-panel aeldari-origin-panel"> <div class="panel-title">МАСКА (АРЛЕКИН)</div>
    <div class="origin-grid"> <div class="origin-row"> <label class="origin-label">Маска (труппа)</label> <select name="system.harlequinMasque" class="origin-select">{{{masqueOptions}}}</select> </div>
      {{#if selectedMasque}}<div class="origin-info"> <div class="origin-chars">{{selectedMasque.chars}}</div> <div class="origin-special">{{selectedMasque.special}}</div> </div>{{/if}}
    </div>
    <div class="gene-seed-hint">Маска (труппа) определяет бонусы характеристик и особый эффект. Бонусы характеристик применяются в Базу вручную при создании; особенность — справка. Это не то же, что Мириада Масок (Света/Сумерек/Ночи) из Черты «Myriad Masks».</div>
  </div> {{/if}}
  {{#if isAstartes}}
  <div class="notes-section-panel astartes-geneseed-panel"> <div class="panel-title">ГЕНОСЕМЯ И КУЛЬТУРА (АСТАРТЕС)</div>
    <div class="origin-grid">
      <div class="origin-row"> <label class="origin-label">Геносемя</label> <div class="origin-value">{{#if headerGeneSeedName}}{{headerGeneSeedName}}{{else}}— не выбрано —{{/if}}</div> </div>
      {{#if geneSeedText}}<div class="origin-info"> <div class="origin-special">{{geneSeedText}}</div> </div>{{/if}}
      <div class="origin-row"> <label class="origin-label">Культура</label> <div class="origin-value">{{#if headerCultureName}}{{headerCultureName}}{{else}}— не выбрано —{{/if}}</div> </div>
      {{#if cultureText}}<div class="origin-info"> <div class="origin-special">{{cultureText}}</div> </div>{{/if}}
    </div>
  </div> {{/if}}

  <div class="notes-section-panel"> <div class="panel-title">БИОГРАФИЯ</div> <div class="bio-grid"> <label>Пол<input type="text" name="system.bio.gender" value="{{system.bio.gender}}"/></label> <label>Возраст<input type="number" name="system.bio.age" value="{{system.bio.age}}"/></label> <label>Рост<input type="text" name="system.bio.height" value="{{system.bio.height}}"/></label> <label>Сложение<input type="text" name="system.bio.build" value="{{system.bio.build}}"/></label> <label>Волосы<input type="text" name="system.bio.hair" value="{{system.bio.hair}}"/></label> </div> </div>

  {{!-- Миньоны на «Записях» больше не живут: сам слуга теперь отдельный тип
        актора со своей шапкой (Хозяин, Тип, Сила, Лояльность), а перечень слуг
        Хозяина — блок «МИНЬОНЫ» на вкладке СОЦИУМ. --}}

  <div class="notes-section-panel"> <div class="panel-title">ЗАПИСИ</div> <prose-mirror name="system.notes" class="notes-textarea" toggled value="{{system.notes}}">{{{notesEnriched}}}</prose-mirror> </div>
  {{!-- Блок СТАТУС убран: все пять флажков продублированы в меню «Настройки
        листа» у шапки (actor-sheet.mjs, _sheetToggleEntries — состав пунктов
        свой у каждого типа) — там же ручной оверрайд поверх автоопределения
        по Черте/Архетипу/владению игроком. Эту вкладку (tab-notes.hbs)
        показывают только Персонаж/Демон/Принц/Миньон, а такая кнопка есть у
        всех четверых — дублировать было незачем. --}}

  {{!-- У Персонажа, Демона и Миньона «В Орду» переехало в кнопку-меню
        «Настройки листа» у шапки (actor-sheet.mjs, _sheetSettingsEntries);
        здесь остаётся только для Принца Демона — в его меню «В Орду» решили
        не дублировать, своя кнопка на ЗАПИСЯХ и остаётся единственной. --}}
  {{#unless (or (eq actor.type "character") (eq actor.type "daemon") (eq actor.type "minion"))}}
  <div class="notes-section">
    <div class="panel-title">ПРЕОБРАЗОВАНИЕ</div>
    <button type="button" class="char-wizard-btn horde-convert-btn" data-action="convertToHorde" title="Создать копию этого персонажа как Орду: Раны станут Магнитудой, Характеристики, Навыки, Таланты, Черты и снаряжение переедут">В Орду</button>
  </div>
  {{/unless}}
</div>{{!-- /tab notes --}}
