<div class="tab body-tab {{#if (eq tab "effects")}}active{{/if}}" data-tab="effects" data-group="primary"> <div class="body-cogitator">

  {{!-- ══════════════ ЗАКРЕПЛЁННАЯ ПРИБОРКА: видна на любой субвкладке ══════════════
        wdbc-ycgk (полный редизайн, по прямому запросу владельца — «то как
        сейчас выглядит тело это просто отвратно, нагромождение всего и вся
        без какой-либо структуры»): всё, что меняется каждый раунд боя
        (Раны/Усталость/Состояния) остаётся видно без переключения вкладки;
        остальное разложено по трём субвкладкам ниже (Плоть/Разум/Скверна). --}}
  <div class="bc-hero">

    {{!-- ── Голо-скан фигуры (кнопка ХИРУРГЕОН переехала в субвкладку «Плоть») ── --}}
    <div class="bc-figure-col">
    <div class="bc-figure-panel"> <div class="bc-figure-head"> <span class="bc-figure-title">◄ БИО-СКАН ►</span> <span class="bc-figure-serial">SUBJECT // {{actor.name}}</span> </div> <div class="bc-figure-stage"> {{#if body.mechMark}}<img class="bc-mechanicus-mark" src="/systems/warhammer-dbc/assets/mechanicus.png" title="Кибер-Мантия Механикум"/>{{/if}}
        <div class="body-photo {{#if body.skinColor}}has-skin{{/if}}" {{#if body.skinColor}}style="--skin:{{body.skinColor}};"{{/if}}> {{{body.implantsBack}}}
          {{#each body.layers as |L|}}
          <div class="bp {{#if L.aug}}is-aug{{/if}} {{#if L.organ}}bp-organ{{/if}} {{#if L.beat}}bp-beat{{/if}}" data-part="{{L.key}}" style="--bp-col:{{L.color}}; -webkit-mask-image:url('{{L.mask}}'); mask-image:url('{{L.mask}}');"></div> {{/each}}
          {{{body.implantsFront}}}
          <div class="body-photo-scan"></div> </div> <div class="bc-figure-grid"></div> </div> <div class="bc-figure-legend"> <span class="bc-leg bc-leg-flesh">● плоть</span> {{#each body.legend as |lg|}}<span class="bc-leg" style="color:{{lg.color}};">● {{lg.label}}</span>{{/each}}
        {{#if body.mechCount}}<span class="bc-leg bc-leg-mech">● механодендриты: {{body.mechCount}}</span>{{/if}}
      </div> </div>
    </div>{{!-- /bc-figure-col --}}

    {{!-- ── Правая колонка: кардиограмма, витальные, состояния ── --}}
    <div class="bc-side">

      {{!-- Кардиограмма + Усталость рядом. --}}
      <div class="bc-ecg-row">
      <div class="bc-ecg ecg--{{body.ecg.key}}"> <div class="bc-ecg-head"> <span class="bc-ecg-title">КАРДИО-МОНИТОР</span> <label class="bc-ecg-death" title="Констатация смерти — остановить кардиомонитор"><input type="checkbox" class="bc-death-toggle" {{#if body.ecg.dead}}checked{{/if}}/> смерть</label> <span class="bc-ecg-status">{{body.ecg.label}}</span> </div>
        {{!-- Стр. 232-233 («Смерть») — только пока констатирована смерть: Спасение
              (Чудесное/Божественная Защита/Замедленная Анимация) и Воскресить
              (без формулы — последствия на ГМа и игроков). --}}
        <div class="bc-death-actions{{#if body.deceased}} bc-death-actions--show{{/if}}">
          <button type="button" class="bc-death-save-btn">⚡ Спасение</button>
          <button type="button" class="bc-resurrect-btn">✚ Воскресить</button>
        </div>
        <div class="bc-ecg-screen"> <svg class="bc-ecg-wave" viewBox="0 0 300 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"> <defs> <linearGradient id="ecgSweep-{{actor.id}}" x1="0" y1="0" x2="1" y2="0"> <stop offset="0" stop-color="#fff" stop-opacity="0"/> <stop offset="0.70" stop-color="#fff" stop-opacity="0"/> <stop offset="0.95" stop-color="#fff" stop-opacity="0.95"/> <stop offset="1" stop-color="#fff" stop-opacity="1"/> </linearGradient> <mask id="ecgMask-{{actor.id}}"> <rect class="bc-ecg-sweep" x="-300" y="0" width="300" height="80" fill="url(#ecgSweep-{{actor.id}})"/> </mask> </defs> <path class="bc-ecg-base" d="{{body.ecg.path}}"/> <g mask="url(#ecgMask-{{actor.id}})"><path class="bc-ecg-lead" d="{{body.ecg.path}}"/></g> <rect class="bc-ecg-bar" x="-1.5" y="0" width="3" height="80"/> </svg> </div> <div class="bc-ecg-read"> <span class="bc-ecg-hp">РАНЫ <b>{{body.ecg.value}}</b>/{{body.ecg.max}}</span> <span class="bc-ecg-pct">{{body.ecg.pct}}%</span> {{#if body.ecg.crit}}<span class="bc-ecg-crit">КРИТ −{{body.ecg.crit}}</span>{{/if}}
        <span class="bc-ecg-bpm">{{body.ecg.bpm}} <small>уд/мин</small></span> </div> </div>

      <div class="stat-panel panel-side bc-fatigue-compact stats-cog"> <div class="panel-body side-body bc-fatigue-body"> <div class="header-cell fate-cell fatigue-cell"> <label class="fatigue-label"> Усталость
          {{#if system.fatigue.value}}
          <span class="fatigue-penalty-badge" title="Штраф −10 на все тесты (кроме T, Inf, Cog)">−10</span> {{/if}}
        </label> <div class="fate-values fatigue-values"> <input type="number" name="system.fatigue.value" value="{{system.fatigue.value}}" min="0" class="fatigue-value-input
                   {{#if system.fatigue.value}}fatigue-nonzero{{/if}}"/> <span>/</span> <input type="number" name="system.fatigue.max" value="{{system.fatigue.max}}" min="0" title="Порог (= T.b + W.b)"/> </div> <div class="fatigue-step-btns"> <button type="button" class="fatigue-btn fatigue-add-btn" title="Добавить 1 Усталость">+1</button> <button type="button" class="fatigue-btn fatigue-remove-btn" title="Снять 1 Усталость">−1</button> </div> <div class="fatigue-bar" title="Усталость {{fatiguePct}}%"><div class="fatigue-fill load-{{fatigueLevel}}" style="width:{{fatiguePct}}%;"></div></div> <div class="fatigue-btns"> <button type="button" class="fatigue-btn fatigue-rest-btn" title="Час отдыха (−1 Усталость)">Отдых</button> <button type="button" class="fatigue-btn fatigue-btn-sleep fatigue-sleep-btn" title="Полноценный сон (снять всю Усталость)">Сон</button> </div> </div> </div> </div>
      </div>{{!-- /bc-ecg-row --}}

      {{!-- Витальные счётчики (светящиеся) --}}
      <div class="bc-vitals"> <div class="bc-vital {{#if body.conditionCount}}is-alert{{/if}}"> <span class="bc-vital-n">{{body.conditionCount}}</span> <span class="bc-vital-l">Состояния</span> </div> <div class="bc-vital bc-vital-dis {{#if body.diseaseCount}}is-alert{{/if}}"> <span class="bc-vital-n">{{body.diseaseCount}}</span> <span class="bc-vital-l">Болезни</span> </div> <div class="bc-vital bc-vital-psy {{#if body.disorderCount}}is-alert{{/if}}"> <span class="bc-vital-n">{{body.disorderCount}}</span> <span class="bc-vital-l">Психика</span> </div> <div class="bc-vital bc-vital-drug {{#if body.drugCount}}is-alert{{/if}}"> <span class="bc-vital-n">{{body.drugCount}}</span> <span class="bc-vital-l">Препараты</span> </div> </div>

      {{!-- СОСТОЯНИЯ — полная редактируемая панель, не только счётчик выше:
            меняются каждый раунд боя, поэтому остаются в закреплённой
            приборке, а не спрятаны за субвкладкой (wdbc-ycgk). --}}
      <div class="effects-section-panel bc-conditions-pinned"> <div class="effects-subsection" data-collapse-key="body-conditions"> <div class="panel-title conditions-panel-title" data-action="panelCollapse"> СОСТОЯНИЯ
          <button type="button" class="conditions-add-btn" title="Добавить состояние">＋</button> </div> {{#if activeConditions.length}}
        <div class="conditions-active-list"> {{#each activeConditions as |cond|}}
          <div class="condition-tag {{cond.css}}" data-condition="{{cond.key}}" style="--cond-color:{{cond.color}};" title="{{cond.desc}}"> <span class="condition-tag-icon">{{{cond.svg}}}</span> <span class="condition-tag-name">{{cond.label}}</span> {{#if cond.hasLevel}}
            <span class="condition-tag-level-wrap"> <input type="number" class="condition-level-input" data-condition="{{cond.key}}" value="{{cond.level}}" min="0" {{#if (eq cond.key "fatigued")}}readonly title="Значение — со вкладки ТЕЛО"{{else}}title="Уровень / Раунды"{{/if}}/> </span> {{/if}}
            {{#if cond.removable}}<button type="button" class="condition-remove-btn" data-condition="{{cond.key}}" title="Снять состояние">✕</button>{{/if}} </div> {{/each}}
        </div> {{else}}
        <div class="conditions-empty">Нет активных состояний</div> {{/if}}
      </div> </div>

    </div>
  </div>

  {{!-- ══════════════ СУБВКЛАДКИ: Плоть / Разум / Скверна ══════════════ --}}
  <div class="bc-subtabs">
    <a class="bc-subtab active" data-action="bodySubtab" data-subtab="flesh">Плоть</a>
    <a class="bc-subtab bc-subtab--mind" data-action="bodySubtab" data-subtab="mind">Разум</a>
    <a class="bc-subtab bc-subtab--corruption" data-action="bodySubtab" data-subtab="corruption">Скверна</a>
  </div>

  {{!-- ─────────────────────── ПЛОТЬ: Нужды, Болезни, Хирургия ─────────────────────── --}}
  <div class="bc-subpanel active" data-subpanel="flesh"> <div class="effects-section-panel">

  {{!-- Жизненные потребности: Голод / Жажда / Сон (корбук 483) --}}
  <div class="bc-life">
    <div class="bc-life-cap">ЖИЗНЕОБЕСПЕЧЕНИЕ</div>
    {{#each body.life as |v|}}
    <div class="bc-life-row {{#if v.alert}}is-alert{{/if}} {{#if v.crit}}is-crit{{/if}}" style="--vc:{{v.tone}}" data-tooltip="{{v.fx}}">
      <span class="bc-life-ic">{{v.icon}}</span>
      <div class="bc-life-mid">
        <div class="bc-life-top"> <span class="bc-life-lbl">{{v.label}}</span> <span class="bc-life-stage">{{v.stageLabel}}</span> {{#if v.pen}}<span class="bc-life-pen" title="Авто-дебафф к характеристикам">−{{v.pen}}</span>{{/if}} </div>
        <div class="bc-life-pips">{{#each v.pips as |p|}}<i class="bc-life-pip {{#if p.on}}on{{/if}}"></i>{{/each}}</div>
      </div>
      <div class="bc-life-ctl">
        <button type="button" class="bc-life-btn" data-vital-adj="{{v.key}}" data-dir="-1" title="Легче">−</button>
        <button type="button" class="bc-life-btn" data-vital-adj="{{v.key}}" data-dir="1" title="Хуже">+</button>
        <button type="button" class="bc-life-btn bc-life-ok" data-vital-reset="{{v.key}}" title="{{v.action}} — сбросить">✓</button>
      </div>
    </div>
    {{/each}}
  </div>

  {{!-- Зависимость (мутация «Addiction», wdbc-5inv) — своей строкой под
        ЖИЗНЕОБЕСПЕЧЕНИЕМ, только если мутация есть у актора. --}}
  {{#if body.dependencies.length}}
  <div class="bc-life bc-dep">
    <div class="bc-life-cap">ЗАВИСИМОСТЬ</div>
    {{#each body.dependencies as |d|}}
    <div class="bc-dep-row {{#if d.unsatisfied}}is-alert{{/if}}">
      <span class="bc-life-ic">💉</span>
      <div class="bc-life-mid">
        <input type="text" class="bc-dep-substance" data-dep-substance="{{d.itemId}}" value="{{d.substance}}" placeholder="объект зависимости"/>
        <div class="bc-dep-status">{{#if d.unsatisfied}}<span class="bc-life-pen">−10 Навыки</span>{{/if}} <span>{{d.status}}</span></div>
      </div>
      <div class="bc-life-ctl">
        <button type="button" class="bc-life-btn bc-life-ok" data-dep-satisfy="{{d.itemId}}" title="Удовлетворить — сбросить таймер">✓</button>
      </div>
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{!-- ── ГЕНОСЕМЯ (перенесено со Способностей) ────────────────────────── --}}
  {{#if isAstartes}}
  <div class="ability-section-panel gene-seed-panel" data-collapse-key="body-gene-seed"> <div class="panel-title" data-action="panelCollapse" title="Числовые бонусы (Unnatural S/T, Размер) применяются автоматически через Черты. Импланты Геносемени — гайд ниже."> ГЕНОСЕМЯ </div> <div class="gene-seed-head"> <span class="gene-origin-label" style="flex:1;align-self:center;">Происхождение и Легион — на вкладке «Записи».</span> </div>
    {{#if geneSeedOrgans.length}}
    <table class="items-table gene-seed-table"> <thead> <tr> <th class="ability-toggle-col"></th> <th class="col-wide">Орган</th> <th>Эффект</th> </tr> </thead> <tbody> {{#each geneSeedOrgans as |o|}}
      <tr class="item-row" data-item-id="{{o.id}}"> <td class="ability-toggle-cell"><button type="button" class="ability-detail-toggle" data-action="abilityDetail" data-item-id="{{o.id}}" title="Показать/скрыть описание">▸</button></td> <td class="item-name-cell">{{o.name}}</td> <td class="trait-fx-cell">{{o.effect}}</td> </tr>
      <tr class="ability-detail-row" data-item-id="{{o.id}}" style="display:none;"> <td colspan="3"><div class="ability-detail-text">{{#if o.installed}}<b>Расположение:</b> {{o.installed}}<br/>{{/if}}{{#if o.description}}{{o.description}}{{else}}—{{/if}}</div></td> </tr>
      {{/each}} </tbody> </table>
    {{else}}
    <div class="gene-seed-hint">Импланты Геносемени ещё не выданы — их даёт Конструктор Черты «Геносемя» (см. вкладку МЕХАНИКА этой Черты).</div>
    {{/if}}
  </div>
  {{/if}}

  {{!-- ── ИМПЛАНТЫ (перенесено со Снаряжения) ───────────────────────────── --}}
  <section class="gear-cat {{#if gearCollapse.implants}}collapsed{{/if}}" data-cat="implants">
    <div class="gear-cat-head" data-action="gearCat" data-gear-cat="implants">
      <span class="gear-cat-chevron">▾</span>
      <span class="gear-cat-title">ИМПЛАНТЫ</span>
      <span class="gear-cat-count">{{gearImplants.length}}</span>
    </div>
    <div class="gear-cat-body">
      <table class="items-table gear-table">
        <thead><tr><th>Имплант</th><th>Категория</th><th>Качество</th><th>Эффект</th></tr></thead>
        <tbody>
          {{#if gearImplants.length}}
            {{#each gearImplants as |im|}}
            <tr class="item-row" data-item-id="{{im.id}}"><td class="item-name-cell">{{im.name}}</td><td>{{im.category}}</td><td>{{im.quality}}</td><td class="implant-effect-cell">{{im.effect}}</td></tr>
            {{/each}}
          {{else}}
            <tr class="items-empty"><td colspan="4"><em>Нет имплантов — перетащите из библиотеки</em></td></tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </section>

  {{!-- ── АКТИВНЫЕ ПРЕПАРАТЫ ────────────────────────────────────────────── --}}
  {{#if activeDrugs.length}}
  <div class="effects-subsection" data-collapse-key="body-active-drugs"> <div class="panel-title" data-action="panelCollapse">АКТИВНЫЕ ПРЕПАРАТЫ</div> {{#each activeDrugs as |drug|}}
    <div class="effect-card effect-card-drug {{#if drug.isAfterEffect}}effect-card-after{{/if}}" data-item-id="{{drug.id}}"> <div class="effect-card-header"> <span class="effect-icon"></span> <span class="effect-name">{{drug.name}}</span> {{#if drug.isAfterEffect}}
          <span class="effect-state-badge effect-state-after">пост-эффект</span> {{else}}
          <span class="effect-state-badge">активен</span> {{/if}}
        <span class="effect-category">{{drug.categoryLabel}}</span> {{#if drug.deliveryLabel}}
          <span class="effect-delivery">· {{drug.deliveryLabel}}</span> {{/if}}
        {{#if drug.roundsRemaining}}
          <span class="effect-rounds">{{drug.roundsRemaining}} ход.</span> {{else if drug.duration}}
          {{#unless drug.isAfterEffect}}
          <span class="effect-duration">{{drug.duration}}</span> {{/unless}}
        {{/if}}
        <button type="button" class="effect-deactivate-btn" data-item-id="{{drug.id}}" title="Завершить действие">✕</button> </div> {{#if drug.statModsDisplay}}
      <div class="effect-stat-mods">{{drug.statModsDisplay}}</div> {{/if}}
      {{#if drug.charDamageDisplay}}
      <div class="effect-char-damage">Урон в характеристику: {{drug.charDamageDisplay}}</div> {{/if}}
      {{#if drug.effect}}
      <div class="effect-desc">{{drug.effect}}</div> {{/if}}
      {{#if drug.specialSummary}}
      <div class="effect-special-list"> {{#each drug.specialSummary as |line|}}
        <div class="effect-special-line">{{line}}</div> {{/each}}
      </div> {{/if}}
      {{#if drug.hasAfterEffect}}
        {{#if drug.isAfterEffect}}
          <div class="effect-after effect-after-running"> Пост-эффект активен{{#if drug.afterEffect}}: {{drug.afterEffect}}{{/if}}
          </div> {{else}}
          {{#if drug.afterEffect}}
          <div class="effect-after">Пост-эффект: {{drug.afterEffect}}{{#if drug.afterEffectDice}} [{{drug.afterEffectDice}}]{{/if}}</div> {{/if}}
          <div class="effect-card-actions"> <button type="button" class="effect-trigger-after-btn" data-item-id="{{drug.id}}" title="Завершить основной эффект и перейти к пост-эффекту"> Запустить пост-эффект
            </button> </div> {{/if}}
      {{/if}}
    </div> {{/each}}
  </div> {{/if}}

  {{!-- ── БОЛЕЗНИ ─────────────────────────────────────────────────────────── --}}
  <div class="effects-subsection" data-collapse-key="body-diseases"> <div class="panel-title conditions-panel-title" data-action="panelCollapse"> БОЛЕЗНИ
      <button type="button" class="conditions-add-btn disease-add-btn" title="Добавить болезнь">＋</button> </div> {{#if diseases.length}}
    <div class="diseases-list"> {{#each diseases as |dis|}}
      <div class="effect-card effect-card-disease {{#if dis.active}}effect-card-disease-active{{/if}}" data-item-id="{{dis.id}}"> <div class="effect-card-header"> <span class="effect-icon">☣</span> <span class="effect-name disease-name-link" data-item-id="{{dis.id}}" style="cursor:pointer;">{{dis.name}}</span> <span class="effect-category">{{dis.typeLabel}}</span> {{#if dis.severityLabel}}<span class="effect-category">{{dis.severityLabel}}</span>{{/if}}
            {{#if dis.godLabel}}<span class="effect-category disease-god">{{dis.godLabel}}</span>{{/if}}
            {{#if dis.active}}<span class="effect-state-badge effect-state-disease">активна</span>{{/if}}
            <button type="button" class="disease-active-toggle effect-disease-toggle" data-item-id="{{dis.id}}" title="Переключить активность">{{#if dis.active}}⏸{{else}}▶{{/if}}</button> <button type="button" class="disease-remove-btn" data-item-id="{{dis.id}}" title="Снять болезнь">✕</button> </div> {{#if dis.symptoms}}<div class="effect-desc"><b>Симптомы:</b> {{dis.symptoms}}</div>{{/if}}
        {{#if dis.vectors}}<div class="disease-line"><b>Векторы:</b> {{dis.vectors}}</div>{{/if}}
        {{#if dis.incubation}}<div class="disease-line"><b>Инкубация:</b> {{dis.incubation}}</div>{{/if}}
        {{#if dis.cure}}<div class="disease-line disease-cure"><b>Излечение:</b> {{dis.cure}}</div>{{/if}}
      </div> {{/each}}
    </div> {{else}}
    <div class="conditions-empty">Нет болезней — перетащите из библиотеки или нажмите ＋</div> {{/if}}
  </div>

  {{!-- ── ЗАВИСИМОСТИ ─────────────────────────────────────────────────────── --}}
  {{#if addictions.length}}
  <div class="effects-subsection" data-collapse-key="body-addictions"> <div class="panel-title panel-title-addiction" data-action="panelCollapse">ЗАВИСИМОСТИ</div> <div class="addictions-list"> {{#each addictions as |add|}}
      <div class="addiction-entry" data-item-id="{{add.id}}"> <div class="addiction-header"> <span class="addiction-icon"></span> <span class="addiction-name">{{add.name}}</span> <span class="addiction-status-on">● зависим</span> <span class="addiction-test">Тест: <b>{{add.testChar}}{{#if add.testMod}}{{signedNum add.testMod}}{{/if}}</b></span> {{#if add.frequency}}<span class="addiction-freq">{{add.frequency}}</span>{{/if}}
          <button type="button" class="addiction-test-btn" data-item-id="{{add.id}}" data-char="{{add.testCharKey}}" data-mod="{{add.testMod}}" title="Тест на срыв зависимости (успех — избавление)">Тест</button> <button type="button" class="addiction-remove-btn" data-item-id="{{add.id}}" title="Снять зависимость вручную">✕</button> </div> {{#if add.minDose}}
        <div class="addiction-dose">Мин. опасная доза/нед.: <b>{{add.minDose}}</b></div> {{/if}}
        {{#if add.penalty}}
        <div class="addiction-penalty">Штраф зависимости: {{add.penalty}}</div> {{/if}}
      </div> {{/each}}
    </div> </div> {{/if}}

  {{!-- ПРИМЕНИТЬ ПРЕПАРАТ переехал на вкладку БОЙ (tab-combat.hbs) — по
        просьбе пользователя, ближе к остальным боевым действиям. --}}

  {{!-- Кнопка хирургикона — теперь здесь, вместе с остальным «телесным»
        содержимым субвкладки «Плоть», а не под Био-сканом (wdbc-ycgk). --}}
  <button type="button" class="bc-surgeon-btn" title="Открыть хирургеон — установка/снятие имплантов"> <img class="bc-surgeon-ic" src="/systems/warhammer-dbc/assets/mechanicus.png" alt=""/> <span class="bc-surgeon-btn-label">ХИРУРГЕОН</span> <span class="bc-surgeon-btn-sub">установка имплантов</span> </button>

  </div> </div>{{!-- /субвкладка Плоть --}}

  {{!-- ─────────────────────── РАЗУМ: Безумие, Ментальные расстройства ─────────────────────── --}}
  <div class="bc-subpanel" data-subpanel="mind"> <div class="effects-section-panel">

  <div class="stats-cog">
    {{> "systems/warhammer-dbc/templates/actor/parts/sanity-panel.hbs"}}
  </div>

  {{!-- ── МЕНТАЛЬНЫЕ РАССТРОЙСТВА ──────────────────────────────────────────── --}}
  <div class="effects-subsection" data-collapse-key="body-mental-disorders"> <div class="panel-title conditions-panel-title" data-action="panelCollapse"> МЕНТАЛЬНЫЕ РАССТРОЙСТВА
      <span class="panel-btn-group"> <button type="button" class="panel-mini-btn disorder-roll-btn" title="Случайное расстройство (d100)">d100</button> <button type="button" class="panel-mini-btn disorder-add-btn" title="Добавить расстройство из списка">＋</button> </span> </div> {{#if mentalDisorders.length}}
    <div class="disorders-list"> {{#each mentalDisorders as |d|}}
      <div class="effect-card" data-item-id="{{d.id}}"> <div class="effect-card-header"> <span class="effect-icon"></span> <span class="effect-name disorder-name-link" data-item-id="{{d.id}}" style="cursor:pointer;">{{d.name}}</span> <span class="addiction-test">Тест: <b>{{d.testLabel}}</b></span> <button type="button" class="disorder-test-btn" data-item-id="{{d.id}}" title="Бросок теста расстройства">Тест</button> <button type="button" class="disorder-remove-btn" data-item-id="{{d.id}}" title="Снять расстройство">✕</button> </div> {{#if d.desc}}<div class="effect-desc">{{d.desc}}</div>{{/if}}
      </div> {{/each}}
    </div> {{else}}
    <div class="conditions-empty">Нет расстройств</div> {{/if}}
  </div>

  </div> </div>{{!-- /субвкладка Разум --}}

  {{!-- ─────────────────────── СКВЕРНА: Порча, Мутации и Дары Богов ─────────────────────── --}}
  <div class="bc-subpanel" data-subpanel="corruption"> <div class="effects-section-panel">

  <div class="stats-cog">
    {{> "systems/warhammer-dbc/templates/actor/parts/corruption-panel.hbs"}}
  </div>

  {{!-- ── МУТАЦИИ И ДАРЫ БОГОВ (общий пул, стр. 440-460) ───────────────────── --}}
  <div class="effects-subsection" data-collapse-key="body-mutations-gifts"> <div class="panel-title" data-action="panelCollapse"> МУТАЦИИ И ДАРЫ БОГОВ
      <button type="button" class="mutgift-roll-btn" data-action="mutgiftRoll" title="Бросок 1d100 — Общие Мутации (стр. 440) или Дар своего Бога (стр. 453-460), со сдвигом ±Inf.b">🎲</button>
      <button type="button" class="mutgift-add-btn" data-action="mutgiftAdd" title="Выбрать мутацию или Дар из общего пула">＋</button> </div>
    <table class="items-table"> <thead> <tr> <th class="ability-toggle-col"></th> <th>Название</th> <th class="col-narrow">Тип</th> </tr> </thead> <tbody> {{#if mutationsAndGifts.length}}
        {{#each mutationsAndGifts as |m|}}
        <tr class="item-row" data-item-id="{{m.id}}"> <td class="ability-toggle-cell"><button type="button" class="ability-detail-toggle" data-action="abilityDetail" data-item-id="{{m.id}}" title="Показать/скрыть описание">▸</button></td> <td class="item-name-cell">{{m.name}}{{#if m.subName}} <span class="godgift-sub">({{m.subName}})</span>{{/if}}{{#if m.activatable}} <button type="button" class="mutgift-active-toggle gear-modsub-power {{#if m.active}}is-on{{/if}}" data-action="mutgiftToggleActive" data-item-id="{{m.id}}" title="Включить/выключить способность (бонусы учитываются только во включённом состоянии)">{{#if m.active}}ВКЛ{{else}}выкл{{/if}}</button>{{/if}}</td> <td class="godgift-god">{{#if m.godLabel}}{{m.godLabel}}{{else}}Мутация{{/if}}</td> </tr>
        <tr class="ability-detail-row" data-item-id="{{m.id}}" style="display:none;"> <td colspan="3">{{#if m.subText}}<div class="ability-detail-text godgift-subtext">{{m.subText}}</div>{{/if}}<div class="ability-detail-text">{{#if m.benefit}}{{m.benefit}}{{else}}—{{/if}}</div></td> </tr> {{/each}}
      {{else}}
        <tr class="items-empty"> <td colspan="3"><em>Нет мутаций и Даров</em></td> </tr> {{/if}}
      </tbody> </table> </div>

  </div> </div>{{!-- /субвкладка Скверна --}}

</div> </div>{{!-- /tab effects --}}
