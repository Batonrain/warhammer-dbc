<div class="tab stats-cog {{#if (eq tab "stats")}}active{{/if}}" data-tab="stats" data-group="primary"> <div class="stats-layout"> {{!-- Безумие --}}
    <div class="stat-panel panel-side"> <div class="panel-title">БЕЗУМИЕ <span class="side-code">// PSY</span></div> <div class="panel-body side-body"> <div class="side-main-val"> <input type="number" name="system.insanity.value" value="{{system.insanity.value}}" min="0"/> <button type="button" class="stat-add-btn" data-action="statAdd" data-stat="insanity" title="Добавить Безумие (число или XdY+Z, напр. 2d10+3)">＋</button> </div> <div class="side-bar"><div class="side-fill load-{{insanityLevel}}" style="width:{{insanityPct}}%;"></div><span class="side-pct">{{insanityPct}}</span></div> <button type="button" class="side-roll-btn fear-roll" title="Тест Страха → таблица Шока">Страх</button> <button type="button" class="side-roll-btn trauma-roll" title="Тест Ментальной Травмы → таблица Травмы">Травма</button> <button type="button" class="side-roll-btn disorder-roll" title="Случайное Ментальное Расстройство (d100)">Расстройство</button> </div> </div> {{!-- Характеристики --}}
    <div class="stat-panel panel-chars"> <div class="panel-title">ХАРАКТЕРИСТИКИ</div> <div class="panel-body" style="padding:0;"> <table class="char-table-display"> <thead> <tr> <th class="col-name">Название</th> <th class="col-val" title="Урон/дебафф в характеристику (временный, база не трогается)">Дебафф</th> <th class="col-val">Итого</th> <th class="col-val">Бонус</th> </tr> </thead> <tbody> {{#each chars as |char|}}
            <tr> <td class="char-name-cell"> <a class="char-roll" data-action="charRoll" data-char="{{char.key}}" title="Проверка: {{char.label}}"> <b>{{char.abbr}}</b> — {{char.label}}
                </a> </td> <td class="char-debuff-cell"> <input type="number" class="char-debuff-input" name="system.charDamage.{{char.key}}" value="{{char.charDamage}}" min="0" title="Урон в характеристику {{char.abbr}} (вычитается из Итого; база не меняется)"/> </td> <td class="char-total-disp {{#if char.charDamage}}char-total-debuffed{{/if}}">{{char.total}}</td> <td class="char-bonus-disp">{{char.bonus}}</td> </tr> {{/each}}
            {{#if system.isRogueTrader}}
            <tr class="char-pf-row"> <td class="char-name-cell"><a class="char-roll char-pf-label" data-action="charRoll" data-char="pf" title="Проверка: Фактор Прибыли"><b>PF</b> — Фактор Прибыли</a></td> <td class="char-debuff-cell char-pf-dash">—</td> <td class="char-total-disp"><input type="number" class="char-pf-input" name="system.aspirations.profitFactor" value="{{system.aspirations.profitFactor}}" min="0" title="Фактор Прибыли"/></td> <td class="char-bonus-disp">{{profitFactorBonus}}</td> </tr>
            {{/if}}
          </tbody> </table> </div> </div> {{!-- Порча --}}
    <div class="stat-panel panel-side"> <div class="panel-title">ПОРЧА <span class="side-code">// COR</span></div> <div class="panel-body side-body"> <div class="side-main-val"> <input type="number" name="system.corruption.value" value="{{system.corruption.value}}" min="0"/> <button type="button" class="stat-add-btn" data-action="statAdd" data-stat="corruption" title="Добавить Порчу (число или XdY+Z, напр. 2d10+3)">＋</button> </div> <div class="side-bar"><div class="side-fill load-{{corruptionLevel}}" style="width:{{corruptionPct}}%;"></div><span class="side-pct">{{corruptionPct}}%</span></div> <div class="side-bonus-row"> <span class="side-bonus-label">Бонус</span> <span class="side-bonus-val">{{system.corruptionBonus}}</span> </div> <div class="side-bonus-row"> <span class="side-bonus-label" title="База 100 + бонусы Путей">Лимит</span> <span class="side-bonus-val">{{system.corruption.limit}}</span> </div> <button type="button" class="side-roll-btn corruption-roll" title="Проверка Воли на Порчу"> Проверка
        </button> </div> </div> </div>{{!-- /stats-layout --}}

  {{!-- Навыки --}}
  <div class="skills-panel"> <div class="panel-title">НАВЫКИ</div> <div class="skills-grid"> {{!-- Колонка 1 --}}
      <div class="skills-column"> {{#each skillsCol1 as |sk|}}
        <div class="skill-row"> <a class="skill-roll skill-name" data-action="skillRoll" data-skill="{{sk.key}}" title="Бросок: {{sk.label}}">{{sk.label}}</a> <span class="skill-total {{#if (lt sk.total 0)}}skill-neg{{else}}skill-pos{{/if}}"> {{sk.total}}
          </span> </div> {{/each}}
      </div> {{!-- Колонка 2 --}}
      <div class="skills-column"> {{#each skillsCol2 as |sk|}}
        <div class="skill-row"> <a class="skill-roll skill-name" data-action="skillRoll" data-skill="{{sk.key}}" title="Бросок: {{sk.label}}">{{sk.label}}</a> <span class="skill-total {{#if (lt sk.total 0)}}skill-neg{{else}}skill-pos{{/if}}"> {{sk.total}}
          </span> </div> {{/each}}
      </div> {{!-- Колонка 3 — групповые навыки --}}
      <div class="skills-column skills-column-groups"> {{#if groupSkillsDisplay}}
          {{#each groupSkillsDisplay as |gsk|}}
            {{#if gsk.isFirstInGroup}}
            <div class="skill-group-header">{{gsk.groupLabel}}</div> {{/if}}
            <div class="skill-row skill-row-grouped"> <a class="skill-roll skill-name skill-name-specialty" data-action="skillRoll" data-skill="group" data-group="true" data-groupkey="{{gsk.groupKey}}" data-index="{{gsk.entryIndex}}" title="Бросок: {{gsk.label}}">{{gsk.specialty}}</a> <span class="skill-total {{#if (lt gsk.total 0)}}skill-neg{{else}}skill-pos{{/if}}"> {{gsk.total}}
              </span> </div> {{/each}}
        {{else}}
          <div class="skill-row"> <span class="skill-name" style="color:var(--wh-text-mid);font-style:italic;"> Нет групповых навыков
            </span> </div> {{/if}}
      </div>{{!-- /skills-column-groups --}}

    </div>{{!-- /skills-grid --}}
  </div>{{!-- /skills-panel --}}

</div>{{!-- /tab-stats --}}