<div class="tab abil-cog {{#if (eq tab "abilities")}}active{{/if}}" data-tab="abilities" data-group="primary"> {{#if isAstartes}}
  <div class="ability-section-panel gene-seed-panel"> <div class="panel-title"> ГЕНОСЕМЯ </div> <div class="gene-seed-head"> <span class="gene-origin-label" style="flex:1;align-self:center;">Происхождение и Легион — на вкладке «Записи».</span> <button type="button" class="gene-apply-btn" data-action="geneApply" title="Создать расовые Черты Астартес (Unnatural S/T, Size, Nimble, Amphibious, Gene-Seed) и базовые характеристики"> {{#if hasGeneSeedTrait}}↻ Обновить расовые бонусы{{else}}Применить расовые бонусы{{/if}}
      </button> </div> <div class="gene-seed-hint">Числовые бонусы (Unnatural S/T, Размер) применяются автоматически через Черты.</div> </div> {{/if}}

  {{#if isYnnari}}
  <div class="ability-section-panel ynnari-panel"> <div class="panel-title"> ИННАРИ — ПЕРЕРОЖДЁННЫЕ </div>
    <div class="gene-seed-head"> <span class="gene-origin-label">Прошлое: <b>{{#if ynnariPastLabel}}{{ynnariPastLabel}}{{else}}— не выбрано (в шапке листа) —{{/if}}</b></span>
      <button type="button" class="ynnari-apply-btn" data-action="ynnariApply" title="Применить бонусы Прошлого (характеристики в пустые поля + расовые Черты) и Черты Иннари">{{#if ynnariPastLabel}}Применить бонусы ({{ynnariPastLabel}}) + Иннари{{else}}Применить Черты Иннари{{/if}}</button> </div>
    <div class="gene-seed-hint">Прошлое (бывшая раса) выбирается в шапке листа или в Мастере создания. Иннари получает все бонусы изначальной расы + Черты «Перерождённые» и «Сила Душ». Мёртвое Могущество — на вкладке Показатели. Бонусы применяются в пустые поля характеристик и как Черты — повторное нажатие безопасно.</div>
  </div> {{/if}}

  {{#if isHarlequin}}
  <div class="ability-section-panel ynnari-panel"> <div class="panel-title"> АРЛЕКИН — СЛУГИ ЦЕГОРАХА </div>
    <div class="gene-seed-head"> <span class="gene-origin-label">Прошлое: <b>{{#if harlequinPastLabel}}{{harlequinPastLabel}}{{else}}— не выбрано (в шапке листа) —{{/if}}</b></span>
      <button type="button" class="harlequin-apply-btn" data-action="harlequinApply" title="Применить бонусы Прошлого (характеристики в пустые поля + расовые Черты) и Черты Арлекина">{{#if harlequinPastLabel}}Применить бонусы ({{harlequinPastLabel}}) + Арлекин{{else}}Применить Черты Арлекина{{/if}}</button> </div>
    <div class="gene-seed-hint">Прошлое (изначальная раса: Азуриане/Друкхари/Экзодит) выбирается в шапке листа или в Мастере создания. Арлекин получает все бонусы изначальной расы + Черты Арлекина (Дары Цегораха, Акробатическое Мастерство, Искажённое Тело, Неприкосновенные, Воля Цегораха) и выбор Маски (Мириада Масок). Бонусы применяются в пустые поля характеристик и как Черты — повторное нажатие безопасно.</div>
  </div> {{/if}}

  {{#if isAeldari}}
  <div class="ability-section-panel aeldari-paths-panel"> <div class="panel-title conditions-panel-title"> ПУТИ (АЭЛЬДАРИ)
      <span class="paths-title-btns"> <button type="button" class="paths-toggle-btn" data-action="pathsToggle" title="Свернуть/развернуть Пути">▾ Пути</button> <button type="button" class="path-add-btn" title="Добавить Путь">＋</button> </span> </div>
    <div class="paths-collapse">
    {{#if charPaths.length}}
    <div class="paths-list"> {{#each charPaths as |p|}}
      <div class="path-card"> <div class="path-card-header"> <select class="path-sel" data-index="{{p.idx}}">{{{p.pathOptions}}}</select> <select class="path-grade" data-index="{{p.idx}}">{{{p.gradeOptions}}}</select> <button type="button" class="path-remove" data-index="{{p.idx}}" title="Удалить Путь">✕</button> </div>
        {{#if p.autoLabel}}<div class="path-auto">Авто: {{p.autoLabel}}</div>{{/if}}
        {{#if p.gradesShown.length}}
          {{#each p.gradesShown as |gr|}}
          <div class="path-grade-block"> <div class="path-grade-name">{{gr.gradeLabel}}</div> <div class="path-desc">{{gr.desc}}</div> </div> {{/each}}
        {{else}}
          <div class="path-desc path-desc-empty"><em>Выберите Путь и градацию</em></div> {{/if}}
      </div> {{/each}}
    </div> {{else}}
    <div class="conditions-empty">Нет Путей</div> {{/if}}
    <div class="gene-seed-hint">Пути заменяют Мировоззрение. Градации: Новичок → Следующий → Мастер → Заблудившийся. Постоянные пассивки (Unnatural, лимит Порчи) учитываются автоматически; ситуативные боевые эффекты — справка для отыгрыша.</div>
    </div>{{!-- /paths-collapse --}}
  </div> {{/if}}

  <div class="ability-section-panel"> <div class="panel-title"> ТАЛАНТЫ
      <button type="button" class="talent-add-btn" data-action="talentAdd" title="Добавить талант из списка (по типам). ПКМ — создать пустой">＋</button> </div> <table class="items-table talents-table"> <thead> <tr> <th class="ability-toggle-col"></th> <th class="col-wide">Название</th> <th class="col-narrow">Ур.</th> <th>Склонности</th> <th>Требование</th> </tr> </thead> <tbody> {{#if abilityTalentGroups.length}}
          {{#each abilityTalentGroups as |g|}}
          <tr class="talent-group-row"><td colspan="5" class="talent-group-cell">{{g.label}} <span class="talent-group-count">{{g.items.length}}</span></td></tr>
          {{#each g.items as |t|}}
          <tr class="item-row" data-item-id="{{t.id}}"> <td class="ability-toggle-cell"><button type="button" class="ability-detail-toggle" data-action="abilityDetail" data-item-id="{{t.id}}" title="Показать/скрыть описание">▸</button></td> <td class="item-name-cell">{{t.name}}</td> <td class="talent-tier-cell">{{t.tier}}</td> <td class="talent-apt-cell">{{t.aptitudes}}</td> <td class="talent-req-cell">{{t.requirement}}</td> </tr>
          <tr class="ability-detail-row" data-item-id="{{t.id}}" style="display:none;"> <td colspan="5"><div class="ability-detail-text">{{#if t.god}}<b>Бог:</b> {{t.god}}{{/if}}{{#if t.specialization}} · <b>Специализации:</b> {{t.specialization}}{{/if}}{{#if t.effectSummary}} · {{t.effectSummary}}{{/if}}{{#if (or t.god t.specialization t.effectSummary)}}<br/>{{/if}}{{#if t.benefit}}{{t.benefit}}{{else}}—{{/if}}</div></td> </tr> {{/each}}
          {{/each}}
        {{else}}
          <tr class="items-empty"> <td colspan="5"><em>Нет талантов</em></td> </tr> {{/if}}
      </tbody> </table> </div> <div class="ability-section-panel"> <div class="panel-title"> ЧЕРТЫ
      <button type="button" class="trait-add-btn" data-action="traitAdd" title="Добавить черту из списка (по типам). ПКМ — создать пустую">＋</button> </div> <table class="items-table traits-table"> <thead> <tr> <th class="ability-toggle-col"></th> <th class="col-wide">Название</th> <th class="col-narrow">Рейтинг</th> <th>Авто-эффекты</th> </tr> </thead> <tbody> {{#if traits.length}}
          {{#each traits as |tr|}}
          <tr class="item-row" data-item-id="{{tr.id}}"> <td class="ability-toggle-cell"><button type="button" class="ability-detail-toggle" data-action="abilityDetail" data-item-id="{{tr.id}}" title="Показать/скрыть описание">▸</button></td> <td class="item-name-cell">{{tr.name}}</td> <td class="trait-rating-cell">{{tr.ratingDisplay}}</td> <td class="trait-fx-cell">{{tr.effectSummary}}</td> </tr>
          <tr class="ability-detail-row" data-item-id="{{tr.id}}" style="display:none;"> <td colspan="4"><div class="ability-detail-text">{{#if tr.benefit}}{{tr.benefit}}{{else}}—{{/if}}</div></td> </tr> {{/each}}
        {{else}}
          <tr class="items-empty"> <td colspan="4"><em>Нет черт</em></td> </tr> {{/if}}
      </tbody> </table> </div>

  {{!-- Ритуалы (стр. 393-425). Пополняются драг-н-дропом предмета-ритуала на
        лист (штатный _onDropItem Foundry, свой обработчик не нужен) либо
        кнопкой «＋» — Обозревателем компендиумов. Раскрытие строки ведёт общий
        .ability-detail-toggle, а открытие и удаление — общее контекстное меню
        строки предмета по ПКМ, как у талантов и черт (wdbc-5qk). --}}
  <div class="ability-section-panel"> <div class="panel-title"> РИТУАЛЫ
      <button type="button" class="ritual-add-btn" title="Выбрать ритуал в Обозревателе компендиумов">＋</button> </div>
    <table class="items-table rituals-table"> <thead> <tr>
      <th class="ability-toggle-col"></th>
      <th class="col-wide">Название</th>
      <th class="col-narrow">Тип</th>
      <th class="col-narrow" title="Уровень Записи">Запись</th>
      <th class="col-narrow" title="Ассистенты: мин.—макс.">Асс.</th>
    </tr> </thead> <tbody>
      {{#if rituals.length}}
        {{#each rituals as |r|}}
        <tr class="item-row{{#unless r.meetsReq}} ritual-row-unmet{{/unless}}" data-item-id="{{r.id}}">
          <td class="ability-toggle-cell"><button type="button" class="ability-detail-toggle" data-action="abilityDetail" data-item-id="{{r.id}}" title="Показать/скрыть описание">▸</button></td>
          <td class="item-name-cell">
            {{#if r.meetsReq}}<span class="ritual-req-ok" title="Требования выполнены">✓</span>
            {{else}}<span class="ritual-req-fail" title="Требования не выполнены">✗</span>{{/if}}
            {{r.name}}</td>
          <td>{{r.typeLabel}}</td>
          <td>{{r.record}}</td>
          <td>{{r.assistLabel}}</td>
        </tr>
        <tr class="ability-detail-row" data-item-id="{{r.id}}" style="display:none;"> <td colspan="5">
          <div class="ability-detail-text">
            {{!-- Каждая группа — своя строка: у ИЛИ-группы текст уже начинается
                  с «одно из: …», склеивать группы между собой нельзя. --}}
            {{#if r.reqLines.length}}<div><b>Требования:</b> {{#each r.reqLines}}<span>{{this}}</span>{{#unless @last}}, {{/unless}}{{/each}}</div>{{/if}}
            {{#if r.reqFailed.length}}<div class="ritual-req-fail"><b>Не выполнено:</b> {{#each r.reqFailed}}<span>{{this}}</span>{{#unless @last}}, {{/unless}}{{/each}}</div>{{/if}}
            {{#if r.assistReqLines.length}}<div><b>Требования к ассистентам:</b> {{#each r.assistReqLines}}<span>{{this}}</span>{{#unless @last}}, {{/unless}}{{/each}}</div>{{/if}}
            {{#if r.description}}<div>{{r.description}}</div>{{/if}}
            {{#if r.procedure}}<div><b>Ритуал:</b> {{r.procedure}}</div>{{/if}}
            {{#if r.result}}<div><b>Результат:</b> {{r.result}}</div>{{/if}}
            {{#if r.cost}}<div><b>Цена:</b> {{r.cost}}</div>{{/if}}
            {{#if r.failureCost}}<div><b>Цена ошибки:</b> {{r.failureCost}}</div>{{/if}}
            {{#unless r.hasAnyText}}<em>Описание не заполнено — см. книгу</em>{{/unless}}
          </div>
        </td> </tr>
        {{/each}}
      {{else}}
        <tr class="items-empty"> <td colspan="5"><em>Нет ритуалов — перетащите сюда или нажмите ＋</em></td> </tr> {{/if}}
    </tbody> </table> </div>
  </div>{{!-- /tab abilities --}}