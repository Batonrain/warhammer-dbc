{{!-- Обёртка листа — <div>: сама форма теперь корневой элемент окна (ApplicationV2,
     PARTS.body.root=true), поэтому классы wh-*/chaos-heretic/cog-frame и
     переменные темы патрона на реальный DOM не попадают, если написать их прямо
     здесь — их навешивает actor-sheet.mjs (_applyThemeClasses/
     _applyChaosPatronTheme) на this.element после рендера.

     .cog-frame (класс навешан в JS, см. выше) / .cog-rivet/.cog-plate-row/
     .cog-status-row — металлический корпус инфопланшета (wdbc-m6as), сидит
     прямо на корне (обёртку СНАРУЖИ корня добавить нельзя). .cog-screen —
     внутренний wrapper вокруг header/nav/sheet-body, даёт контур-кольцо на
     стыке корпус→экран одним элементом (styles/sheets/actor-housing.css). --}}
<div class="warhammer-dbc character-sheet">
  <div class="cog-rivet tl"></div>
  <div class="cog-rivet tr"></div>
  <div class="cog-rivet bl"></div>
  <div class="cog-rivet br"></div>

  <div class="cog-plate-row">
    <span class="cog-plate">Инфопланшет модели XIL</span>
    <div class="cog-leds">
      <i class="cog-led cog-led-green on"></i>
      <i class="cog-led cog-led-amber {{#if (eq actor.system.wounds.tier "heavy")}}on{{/if}}"></i>
      <i class="cog-led cog-led-red {{#if (eq actor.system.wounds.tier "dying")}}on{{/if}}"></i>
    </div>
  </div>

  <div class="cog-screen"> {{> "systems/warhammer-dbc/templates/actor/parts/header.hbs"}}

  {{#if infamy}}{{> "systems/warhammer-dbc/templates/actor/parts/infamy-strip.hbs" infamy}}{{/if}}

  <nav class="sheet-tabs tabs" data-group="primary"> <a class="item {{#if (eq tab "stats")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="stats">ПОКАЗАТЕЛИ</a> <a class="item {{#if (eq tab "combat")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="combat">БОЙ</a> <a class="item {{#if (eq tab "effects")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="effects">ТЕЛО</a> {{#if possessed}}<a class="item tab-possession-link {{#if (eq tab "possession")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="possession" style="--gc:{{possession.meta.color}}">ОДЕРЖИМОСТЬ</a>{{/if}} {{#if isHaemonculus}}<a class="item tab-haem-link {{#if (eq tab "haemonculus")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="haemonculus">ГЕМУНКУЛ</a>{{/if}} <a class="item {{#if (eq tab "abilities")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="abilities">СПОСОБНОСТИ</a> <a class="item {{#if (eq tab "social")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="social">СОЦИУМ</a>
    <a class="item {{#if (eq tab "psy")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="psy">МИСТИКА</a>
    {{#if (or system.isTechpriest hasMechImplants)}}
    <a class="item {{#if (eq tab "tech")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="tech">ТЕХ</a> {{/if}}
    {{#if (eq system.subrace "navigator")}}
    <a class="item {{#if (eq tab "nav")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="nav">НАВ</a> {{/if}}
    <a class="item {{#if (eq tab "gear")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="gear">СНАРЯЖЕНИЕ</a> <a class="item {{#if (eq tab "advance")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="advance">РАЗВИТИЕ</a> <a class="item {{#if (eq tab "notes")}}active{{/if}}" data-action="tab" data-group="primary" data-tab="notes">ЗАПИСИ</a> </nav> <div class="sheet-body"> {{> "systems/warhammer-dbc/templates/actor/parts/tab-stats.hbs"}}
{{> "systems/warhammer-dbc/templates/actor/parts/tab-combat.hbs"}}
{{> "systems/warhammer-dbc/templates/actor/parts/tab-abilities.hbs"}}
{{> "systems/warhammer-dbc/templates/actor/parts/tab-social.hbs"}}
{{> "systems/warhammer-dbc/templates/actor/parts/tab-psy.hbs"}}
{{#if (or system.isTechpriest hasMechImplants)}}
{{> "systems/warhammer-dbc/templates/actor/parts/tab-tech.hbs"}}
{{/if}}
{{#if (eq system.subrace "navigator")}}
{{> "systems/warhammer-dbc/templates/actor/parts/tab-nav.hbs"}}
{{/if}}
{{> "systems/warhammer-dbc/templates/actor/parts/tab-gear.hbs"}}
{{> "systems/warhammer-dbc/templates/actor/parts/tab-advance.hbs"}}
{{> "systems/warhammer-dbc/templates/actor/parts/tab-notes.hbs"}}
{{> "systems/warhammer-dbc/templates/actor/parts/tab-effects.hbs"}}
{{#if possessed}}{{> "systems/warhammer-dbc/templates/actor/parts/tab-possession.hbs"}}{{/if}}
{{#if isHaemonculus}}{{> "systems/warhammer-dbc/templates/actor/parts/tab-haemonculus.hbs"}}{{/if}}

    <div class="screen-status-line"><i class="cog-status-dot"></i><span>Дух машины пробуждён</span></div>
  </div> </div>

  <div class="cog-status-row"></div>
</div>
