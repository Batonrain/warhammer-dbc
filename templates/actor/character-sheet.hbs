<div class="warhammer-dbc character-sheet{{#if isHeretic}} chaos-heretic chaos-god-{{chaosPatron.key}}{{/if}}"{{#if isHeretic}} style="--gc:{{chaosPatron.color}};--gc2:{{chaosPatron.gc2}};--glow:{{chaosPatron.glow}};--dp-hue:{{chaosPatron.hue}};--dp-sat:{{chaosPatron.sat}};--dp-bright:{{chaosPatron.bright}};--patron-star:{{chaosPatron.star}};--patron-sigil:url('/{{chaosPatron.sigil}}');--patron-sigil-size:{{chaosPatron.sigilSize}}"{{/if}}> {{> "systems/warhammer-dbc/templates/actor/parts/header.hbs"}}

