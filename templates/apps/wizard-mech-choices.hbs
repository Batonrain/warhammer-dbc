{{#if pendingMechChoices.length}}
<div class="wiz-gen">
  <div class="wiz-gen-lbl">Механика предлагает выбор — применится по «Далее»:</div>
  {{#each pendingMechChoices as |r|}}
  {{#if (eq r.type "or")}}
  <div class="atk-dlg-row wtc-row{{#if r.skipped}} wiz-mech-row-skipped{{/if}}"><label class="wtc-lbl">{{r.itemName}}:</label>
    <select class="wtc-sel wiz-mech-or-sel" data-key="{{r.key}}" {{#if r.skipped}}disabled{{/if}}>
      <option value="" disabled {{#unless r.skipped}}selected{{/unless}}>— выбрать —</option>
      {{#each r.options as |o|}}<option value="{{o.idx}}" {{#if o.selected}}selected{{/if}} {{#if o.disabled}}disabled{{/if}}>{{o.label}}{{#if o.disabled}} (занято другой строкой){{/if}}</option>{{/each}}
    </select>
    <button type="button" class="wiz-mini-btn wiz-mech-skip{{#if r.skipped}} active{{/if}}" data-key="{{r.key}}" data-many="0" title="{{#if r.skipped}}Пропущено — нажмите ещё раз, чтобы отменить{{else}}Пропустить{{/if}}">✕</button>
  </div>
  {{else}}
  <div class="atk-dlg-row wtc-row{{#if r.skipped}} wiz-mech-row-skipped{{/if}}">
    <label class="wtc-lbl">{{r.skillLabel}} {{#if r.many}}<span class="wtc-x">×{{r.need}}</span>{{/if}}</label>
    <div class="wtc-inputs">
      {{#each r.choices as |c|}}
      <label class="apt-chip">
        {{#if ../many}}
        <input type="checkbox" class="wiz-mech-spec-check" data-key="{{../key}}" data-idx="{{c.idx}}" {{#if c.picked}}checked{{/if}} {{#if ../r.skipped}}disabled{{/if}}/>
        {{else}}
        <input type="radio" class="wiz-mech-spec-radio" name="mech-spec-{{../key}}" value="{{c.idx}}" data-key="{{../key}}" {{#if c.checked}}checked{{/if}} {{#if ../r.skipped}}disabled{{/if}}/>
        {{/if}}
        {{c.label}}
      </label>
      {{/each}}
    </div>
    {{#if r.many}}
    <button type="button" class="wiz-mini-btn wiz-mech-spec-confirm" data-key="{{r.key}}" {{#unless (eq r.pickedCount r.need)}}disabled{{/unless}}>Готово ({{r.pickedCount}}/{{r.need}})</button>
    {{/if}}
    <button type="button" class="wiz-mini-btn wiz-mech-skip{{#if r.skipped}} active{{/if}}" data-key="{{r.key}}" data-many="{{#if r.many}}1{{else}}0{{/if}}" title="{{#if r.skipped}}Пропущено — нажмите ещё раз, чтобы отменить{{else}}Пропустить{{/if}}">✕</button>
  </div>
  {{/if}}
  {{/each}}
</div>
{{/if}}
