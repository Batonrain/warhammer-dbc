<div class="wh-tarot-app">

  <div class="tr-tabs">
    <button type="button" data-tab="reading" class="tr-tab {{#if isReading}}active{{/if}}">✦ Гадание</button>
    <button type="button" data-tab="guide" class="tr-tab {{#if isGuide}}active{{/if}}">📖 Гайд по картам</button>
  </div>

  <div class="wh-tarot-scroll">

  {{#if isReading}}
    {{#unless isGM}}<div class="tr-playerhint">🎲 Вы можете бросить случайные карты. Ручной выбор карты — только у Мастера.</div>{{/unless}}
    <div class="tr-top">
      <div class="tr-row">
        <label class="tr-lbl">Расклад
          <select name="spread">
            {{#each spreads as |sp|}}<option value="{{sp.key}}" {{#if sp.selected}}selected{{/if}}>{{sp.label}}</option>{{/each}}
          </select>
        </label>
        <div class="tr-actions">
          <button type="button" data-act="randomall" class="tr-btn">🎲 Случайный расклад</button>
          <button type="button" data-act="clear" class="tr-btn">Очистить</button>
        </div>
      </div>
      <div class="tr-note">{{spreadNote}}</div>
      <label class="tr-lbl tr-q">Вопрос (сформулируйте точно и детально)
        <input type="text" name="question" value="{{question}}" placeholder="напр. Что мы найдём в сердце еретического храма под шпилем Альфа?"/>
      </label>
      <div class="tr-row">
        <div class="tr-lbl">Теомант (гадающий)
          <div class="tr-pickrow">
            <input type="text" name="teomant" value="{{teomant}}" placeholder="имя"/>
            <select data-pick="teomant" class="tr-pick"><option value="">🎭 токен…</option>{{#each tokens as |t|}}<option value="{{t}}">{{t}}</option>{{/each}}</select>
          </div>
        </div>
        <div class="tr-lbl">Квирит (вопрошающий)
          <div class="tr-pickrow">
            <input type="text" name="quirit" value="{{quirit}}" placeholder="имя"/>
            <select data-pick="quirit" class="tr-pick"><option value="">🎭 токен…</option>{{#each tokens as |t|}}<option value="{{t}}">{{t}}</option>{{/each}}</select>
          </div>
        </div>
      </div>
    </div>

    <div class="tr-slots">
      {{#each slots as |sl|}}
      <div class="tr-slot {{#if sl.signal}}signal{{/if}} {{#if sl.reversed}}reversed{{/if}}">
        <div class="tr-slot-head">
          <span class="tr-slot-name">{{sl.name}}</span>
          {{#if sl.signal}}<span class="tr-slot-sig">знаковая</span>{{/if}}
        </div>
        <div class="tr-slot-ctl {{#unless ../isGM}}ro{{/unless}}">
          {{#if ../isGM}}
          <select data-cardsel="{{sl.i}}" class="tr-cardsel">
            <option value="">— выбрать карту —</option>
            {{#each ../suitGroups as |g|}}
            <optgroup label="{{g.label}}">
              {{#each g.cards as |c|}}<option value="{{c.n}}" {{#if (eq c.n ../../sl.cardN)}}selected{{/if}}>{{c.label}}</option>{{/each}}
            </optgroup>
            {{/each}}
          </select>
          <select data-orient="{{sl.i}}" class="tr-orient">
            <option value="up"  {{#unless sl.reversed}}selected{{/unless}}>⭯ Прямая</option>
            <option value="rev" {{#if sl.reversed}}selected{{/if}}>⭮ Перевёрнутая</option>
          </select>
          {{else}}
          <div class="tr-cardro">{{#if sl.card}}{{sl.card.title}}{{else}}— бросьте кубик 🎲 —{{/if}}</div>
          {{/if}}
          <button type="button" data-rollslot="{{sl.i}}" class="tr-roll" title="Случайная карта в этот слот">🎲</button>
        </div>
        {{#if sl.card}}
        <div class="tr-preview">
          {{#if sl.card.img}}<div class="tr-pv-frame"><img class="tr-pv-art {{#if sl.reversed}}rev{{/if}}" src="{{sl.card.img}}" data-title="{{sl.card.title}}" alt="" title="Открыть карту"/></div>{{/if}}
          <div class="tr-pv-txt">
            <div class="tr-pv-name">{{sl.card.title}} <span class="tr-pv-suit">({{sl.card.suitLine}})</span> <span class="tr-pv-or">{{#if sl.reversed}}⭮ Перевёрнутая{{else}}⭯ Прямая{{/if}}</span></div>
            <div class="tr-pv-mean">{{sl.card.meaning}}</div>
          </div>
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>

    {{#if readHint}}<div class="tr-hintbox"><b>Толкование:</b> {{readHint}}</div>{{/if}}
  {{/if}}

  {{#if isGuide}}
    <div class="tr-guide">
      <div class="tr-guide-sec">
        <div class="tr-guide-h">Принципы трактовки</div>
        {{#each guide as |g|}}<div class="tr-guide-p"><b>{{g.h}}.</b> {{g.p}}</div>{{/each}}
      </div>
      {{#each guideSuits as |suit|}}
      <div class="tr-guide-sec">
        <div class="tr-guide-h">{{suit.label}} <span class="tr-guide-hint">— {{suit.hint}}</span></div>
        {{#each suit.cards as |c|}}
        <details class="tr-gcard">
          <summary><span class="tr-gc-n">{{c.n}}.</span> {{c.title}}</summary>
          <div class="tr-gc-body">
            {{#if c.img}}<div class="tr-gc-frame"><img class="tr-gc-art" src="{{c.img}}" data-title="{{c.title}}" alt="" title="Открыть карту"/></div>{{/if}}
            <div class="tr-gc-text">
              <div class="tr-gc-line"><span class="tr-gc-lbl up">Прямое:</span> {{c.up}}</div>
              <div class="tr-gc-line"><span class="tr-gc-lbl rev">Перевёрнутое:</span> {{c.rev}}</div>
              <div class="tr-gc-line"><span class="tr-gc-lbl ch">Изменения:</span> {{c.ch}}</div>
            </div>
          </div>
        </details>
        {{/each}}
      </div>
      {{/each}}
    </div>
  {{/if}}

  </div>

  {{#if isReading}}
  <div class="tr-footer">
    <button type="button" data-act="post" class="tr-btn primary">✦ Огласить пророчество (в чат) ✦</button>
  </div>
  {{/if}}
</div>
