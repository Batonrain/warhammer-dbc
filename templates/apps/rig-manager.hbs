<div class="wh-rig-app">
  {{#if missing}}
  <div class="wr-empty">Актор не найден.</div>
  {{else}}
  <div class="wh-rig-scroll">

    {{#unless hasRigs}}
    <div class="wr-empty">Нет разгрузок. Добавьте предмет-разгрузку (Снаряжение → категория «Разгрузка») из библиотеки.</div>
    {{/unless}}

    {{#if backConflict}}
    <div class="wr-warn">Внимание: несколько разгрузок занимают спину — обычно можно носить только одну заплечную разгрузку.</div>
    {{/if}}

    {{#each rigs as |rig|}}
    <div class="wr-rig">
      <div class="wr-rig-head">
        <span class="wr-rig-name">{{rig.name}}</span>
        {{#if rig.backSlot}}<span class="wr-badge">спина</span>{{/if}}
        {{#if rig.container}}<span class="wr-badge bp">рюкзак</span>{{/if}}
        <span class="wr-rig-meta">
          {{#if rig.container}}{{rig.count}} предм.{{else}}{{rig.count}} / {{rig.total}}{{/if}}
          · {{rig.weight}} кг
          · {{#if rig.canQuickDraw}}<span class="wr-qd yes">Quick Draw ✓</span>{{else}}<span class="wr-qd no">без Quick Draw</span>{{/if}}
        </span>
      </div>
      {{#if rig.comfortHint}}<div class="wr-hint">{{rig.comfortHint}}</div>{{/if}}

      {{#if (eq rig.type "armor")}}
      {{!-- Схема силовой брони (стр. 27): своя раскладка, не копия иллюстрации
           книги — те же 12 замков и пояс, отрисованные в стиле этого окна.
           Клик по зоне подсвечивает соответствующие карточки слотов ниже. --}}
      <div class="wr-schema">
        <svg viewBox="0 0 260 400" xmlns="http://www.w3.org/2000/svg">
          <g class="wr-sil">
            <circle cx="130" cy="26" r="20"/>
            <path d="M80,50 L180,50 L170,150 L90,150 Z"/>
            <rect x="48" y="55" width="28" height="55" rx="8"/>
            <rect x="184" y="55" width="28" height="55" rx="8"/>
            <rect x="90" y="190" width="80" height="60" rx="6"/>
            <rect x="88" y="320" width="30" height="30" rx="6"/>
            <rect x="142" y="320" width="30" height="30" rx="6"/>
          </g>
          <rect class="wr-sr" data-slot-region="предплечья" x="42" y="112" width="30" height="55" rx="6"><title>Предплечья — 2×(1×1, может держать щит)</title></rect>
          <rect class="wr-sr" data-slot-region="предплечья" x="188" y="112" width="30" height="55" rx="6"><title>Предплечья — 2×(1×1, может держать щит)</title></rect>
          <rect class="wr-sr" data-slot-region="бока кирасы" x="78" y="60" width="14" height="70" rx="4"><title>Бока кирасы — 2×3×1</title></rect>
          <rect class="wr-sr" data-slot-region="бока кирасы" x="168" y="60" width="14" height="70" rx="4"><title>Бока кирасы — 2×3×1</title></rect>
          <rect class="wr-sr wr-sr-slot" data-slot-region="пояс спереди, слева" x="90" y="155" width="35" height="30" rx="4"><title>Пояс спереди, слева — 4×1×1 (2 меняются на кобуру)</title></rect>
          <rect class="wr-sr wr-sr-slot" data-slot-region="пояс спереди, справа" x="135" y="155" width="35" height="30" rx="4"><title>Пояс спереди, справа — 4×1×1 (2 меняются на кобуру)</title></rect>
          <rect class="wr-sr" data-slot-region="бёдра" x="85" y="255" width="35" height="60" rx="6"><title>Бёдра — 2×4×1</title></rect>
          <rect class="wr-sr" data-slot-region="бёдра" x="140" y="255" width="35" height="60" rx="6"><title>Бёдра — 2×4×1</title></rect>
          <rect class="wr-sr wr-sr-awkward" data-slot-region="голени спереди" x="86" y="325" width="34" height="55" rx="6"><title>Голени спереди — 2×2×1, неудобные</title></rect>
          <rect class="wr-sr wr-sr-awkward" data-slot-region="голени спереди" x="140" y="325" width="34" height="55" rx="6"><title>Голени спереди — 2×2×1, неудобные</title></rect>
          <text class="wr-sl" x="130" y="15" text-anchor="middle">СПЕРЕДИ</text>
        </svg>
        <div class="wr-schema-back">
          <div class="wr-schema-back-h">СЗАДИ</div>
          <div class="wr-sr-chip wr-sr-awkward" data-slot-region="пояс сзади"><title>Пояс сзади — 1×4×1, неудобный</title>пояс сзади</div>
          <div class="wr-sr-chip wr-sr-very" data-slot-region="голени сзади"><title>Голени сзади — 2×2×1, очень неудобные</title>голени сзади</div>
          <div class="wr-sr-chip wr-sr-very" data-slot-region="ранец сзади"><title>Ранец сзади — 1×5×3, очень неудобный</title>ранец сзади</div>
        </div>
        <div class="wr-schema-legend">
          <span class="wr-leg"><i class="wr-sr-swatch"></i>магнитный замок</span>
          <span class="wr-leg"><i class="wr-sr-swatch wr-sr-slot"></i>карман/кобура (не маг.)</span>
          <span class="wr-leg"><i class="wr-sr-swatch wr-sr-awkward"></i>неудобный</span>
          <span class="wr-leg"><i class="wr-sr-swatch wr-sr-very"></i>очень неудобный</span>
        </div>
      </div>
      {{/if}}

      {{#if rig.container}}
      {{!-- Рюкзак-контейнер --}}
      <div class="wr-bp">
        <div class="wr-bp-hint">Доставание из рюкзака — полное действие.</div>
        {{#each rig.contents as |it|}}
        <div class="wr-bp-item"><span class="wr-it-name">{{it.name}}</span> <span class="wr-it-size">{{it.size}}</span> <span class="wr-it-w">{{it.weight}} кг</span>
          <button type="button" class="wr-x" data-item-clear="{{it.id}}" title="Достать">✕</button></div>
        {{else}}
        <div class="wr-bp-empty">Пусто</div>
        {{/each}}
        {{#if rig.addable.length}}
        <select class="wr-add" data-bp-add="{{rig.id}}">
          <option value="">+ положить в рюкзак…</option>
          {{#each rig.addable as |o|}}<option value="{{o.id}}">{{o.name}} ({{o.size}})</option>{{/each}}
        </select>
        {{/if}}
      </div>

      {{else}}
      {{!-- Слоты --}}
      <div class="wr-slots">
        {{#each rig.slots as |sl|}}
        <div class="wr-slot {{#if sl.isMag}}mag{{/if}} {{#if sl.item}}filled{{/if}}">
          <div class="wr-slot-top"><span class="wr-slot-size">{{sl.size}}</span>{{#if sl.isMag}}<span class="wr-badge mag">МАГ</span>{{/if}}{{#if sl.awkward}}<span class="wr-badge">{{#if (eq sl.awkward "veryAwkward")}}очень неудобный{{else}}неудобный{{/if}}</span>{{/if}}</div>
          {{#if sl.note}}<div class="wr-slot-note">{{sl.note}}</div>{{/if}}
          {{#if sl.variants.length}}
          {{!-- Слот с заменами: кобура ↔ ножны ↔ петля. Смена варианта освобождает слот. --}}
          <select class="wr-add wr-variant" data-slot-variant="{{sl.id}}" title="Чем занят слот">
            {{#each sl.variants as |v|}}<option value="{{v.key}}" {{#if v.selected}}selected{{/if}}>{{v.label}} ({{v.size}}){{#if v.awkward}} · неудобно{{/if}}</option>{{/each}}
          </select>
          {{/if}}
          {{#if sl.item}}
          <div class="wr-slot-item"><span class="wr-it-name">{{sl.item.name}}</span>
            <button type="button" class="wr-x" data-slot-clear="{{sl.id}}" title="Убрать">✕</button></div>
          {{/if}}
          {{#if sl.opts.length}}
          <select class="wr-add" data-slot-assign="{{sl.id}}">
            <option value="">{{#if sl.item}}— заменить на…{{else}}— пусто —{{/if}}</option>
            {{#each sl.opts as |o|}}<option value="{{o.id}}">{{o.name}} ({{o.size}})</option>{{/each}}
          </select>
          {{else}}{{#unless sl.item}}<div class="wr-slot-empty">— пусто —</div>{{/unless}}{{/if}}
        </div>
        {{/each}}
      </div>
      {{#if rig.isMagAny}}<div class="wr-magnote">На магнитных замках предметы нельзя забрать в Борьбе/телекинезом; сорвать самому — полудействие, тест S−30.</div>{{/if}}
      {{/if}}
    </div>
    {{/each}}

    <div class="wr-unassigned">
      <div class="wr-unassigned-h">Не размещено (в руках / вне разгрузок) · {{unassignedWeight}} кг</div>
      {{#each unassigned as |it|}}
      <div class="wr-un-item"><span class="wr-it-name">{{it.name}}</span> <span class="wr-it-type">{{it.type}}</span> <span class="wr-it-size">{{it.size}}</span> <span class="wr-it-w">{{it.weight}} кг</span></div>
      {{else}}
      <div class="wr-bp-empty">Всё размещено.</div>
      {{/each}}
    </div>

  </div>
  {{/if}}
</div>
