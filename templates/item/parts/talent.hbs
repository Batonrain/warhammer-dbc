{{!-- Талант --}}
{{#if (eq item.type "talent")}}
<div class="item-section">
  <div class="item-section-title">ПАРАМЕТРЫ ТАЛАНТА</div>
  <div class="weapon-row">
    <label class="wr-label">Источник</label>
    <input type="text" name="system.bookSource" value="{{system.bookSource}}"
           class="wr-input-md" placeholder="напр. Core, стр. 24"/>
  </div>
  <div class="weapon-row">
    <label class="wr-label">Уровень</label>
    <select name="system.tier" class="wr-select-sm">
      <option value="1" {{#if (eqLoose system.tier 1)}}selected{{/if}}>1</option>
      <option value="2" {{#if (eqLoose system.tier 2)}}selected{{/if}}>2</option>
      <option value="3" {{#if (eqLoose system.tier 3)}}selected{{/if}}>3</option>
    </select>
    <label class="wr-label">Бог</label>
    <select name="system.god" class="wr-select-sm">
      <option value=""          {{#if (eq system.god "")}}selected{{/if}}>—</option>
      <option value="Неделимый" {{#if (eq system.god "Неделимый")}}selected{{/if}}>Неделимый</option>
      <option value="Кхорн"     {{#if (eq system.god "Кхорн")}}selected{{/if}}>Кхорн</option>
      <option value="Тзинч"     {{#if (eq system.god "Тзинч")}}selected{{/if}}>Тзинч</option>
      <option value="Нургл"     {{#if (eq system.god "Нургл")}}selected{{/if}}>Нургл</option>
      <option value="Слаанеш"   {{#if (eq system.god "Слаанеш")}}selected{{/if}}>Слаанеш</option>
    </select>
  </div>
  <div class="weapon-row">
    <label class="wr-label">Требование</label>
    <input type="text" name="system.requirement" value="{{system.requirement}}" class="wr-input-special"
           placeholder="напр. T 40, Навык Awareness"/>
  </div>
  <div class="weapon-row">
    <label class="wr-label">Специализации</label>
    {{!-- «Мастерство» владеет конкретным Навыком (стр. 62), и от того, каким,
          зависят его склонности и цена. Поэтому у него подсказка списком — все
          Навыки и специализации групп; поле осталось текстовым, чтобы своё
          вписывалось по-прежнему. --}}
    <input type="text" name="system.specialization" value="{{system.specialization}}" class="wr-input-special"
           {{#if masteryList}}list="mastery-targets"{{/if}}
           placeholder="напр. WS, BS, S… (для специализированных Талантов)"/>
    {{#if masteryList}}
    <datalist id="mastery-targets">
      {{#each masteryList as |t|}}<option value="{{t.label}}"></option>{{/each}}
    </datalist>
    {{/if}}
  </div>

  <div class="weapon-row">
    <label class="drug-fx-cb-label"
           title="Талант, который берут несколько раз: Enemy (Враг) — уровни 1-3, и штраф считается за уровень.">
      <input type="checkbox" name="system.hasRating" {{#if system.hasRating}}checked{{/if}}/>
      Принимает уровень
    </label>
    {{#if system.hasRating}}
    <label class="wr-label">Уровень</label>
    <input type="number" name="system.rating" value="{{system.rating}}" class="wr-input-xs"/>
    {{/if}}
  </div>

  {{!-- Цели: против кого действует талант (Ненависть, Связи, Враг, Репутация) --}}
  <div class="weapon-props-section">
    <div class="weapon-props-head">
      <label class="wr-label"
             title="Против кого талант работает. Правило срабатывает и на любую НИЖЕСТОЯЩУЮ фракцию: цель к Хаосу достаёт роту в его составе, но цель к роте не достаёт весь Хаос.">Цели</label>
      <button type="button" class="talent-target-add">＋ цель…</button>
    </div>
    <div class="trait-fx-hint">
      Поле для Талантов, работающих против кого-то: Hatred, Peer, Enemy, Good
      Reputation. Целей может быть несколько и они разной природы — фракция,
      тип существа (техника) или «Все!». Фракцию можно просто перетащить сюда
      из Обозревателя компендиумов.
    </div>
    <div class="weapon-props-list talent-target-drop">
      {{#each system.targets as |t i|}}
      <div class="wprop-chip">
        {{#if t.img}}<img src="{{t.img}}" class="grant-drop-img"/>{{/if}}
        <span class="wprop-name">{{t.name}}</span>
        <button type="button" class="wprop-remove talent-target-remove" data-index="{{i}}" title="Убрать цель">✕</button>
      </div>
      {{else}}
      <span class="grant-drop-placeholder">Целей нет — перетащите Фракцию сюда или нажмите «＋ цель»</span>
      {{/each}}
    </div>
  </div>

  {{!-- Склонности по характеристикам --}}
  <div class="weapon-props-section">
    <div class="weapon-props-head">
      <label class="wr-label">Склонности</label>
      <select class="apt-add">
        <option value="">＋ добавить склонность…</option>
        {{#each aptitudesAvailable as |a|}}
        <option value="{{a.key}}">{{a.label}}</option>
        {{/each}}
      </select>
    </div>
    {{#if aptitudesActive.length}}
    <div class="weapon-props-list">
      {{#each aptitudesActive as |a|}}
      <div class="wprop-chip">
        <span class="wprop-name">{{a.label}}</span>
        <button type="button" class="wprop-remove apt-remove" data-action="aptRemove" data-key="{{a.key}}" title="Убрать">✕</button>
      </div>
      {{/each}}
    </div>
    {{/if}}
  </div>
</div>

{{!-- Проверяемое требование (в дополнение к текстовому полю «Требование» выше):
      кто вправе взять/купить этот Талант. Для Талантов из дерева Элитного
      архетипа сюда кладут reqArchetype — «взял архетип X», а не только пишут
      это в Специализации. Тот же Конструктор, что у Ритуала (стр. 393-425),
      движок ни к чему ритуальному не привязан. --}}
<div class="item-section">
  <div class="item-section-title">
    ПРОВЕРЯЕМОЕ ТРЕБОВАНИЕ
    {{#if isGM}}<span class="effects-tab-actions">
      <button type="button" class="req-group-add" data-action="reqGroupAdd" data-req="req" data-op="AND" title="Новая группа — нужны ВСЕ условия">➕ И-группа</button>
      <button type="button" class="req-group-add" data-action="reqGroupAdd" data-req="req" data-op="OR" title="Новая группа — достаточно ОДНОГО условия">➕ ИЛИ-группа</button>
    </span>{{/if}}
  </div>
  <div class="trait-fx-hint">Кто может взять этот Талант: Навык нужного ранга, Талант/Черта нужного рейтинга, Раса, Элитный архетип или Покровительство Бога. Пусто — берёт кто угодно (текстовое поле «Требование» выше по-прежнему читает ГМ глазами).</div>
  <div class="req-groups" data-req="req">{{{talentReqHtml}}}</div>
</div>

<div class="item-section">
  <div class="item-section-title">АВТО-ЭФФЕКТЫ</div>
  <div class="trait-fx-hint">Числовые авто-эффекты (бонус характеристики, Инициатива, Рейтинг Страха) переехали на вкладку «Эффекты» — добавьте их там как Active Effect. Старые значения этого предмета уже перенесены автоматически.</div>
</div>

<div class="item-section">
  <div class="item-section-title">ЧТО ДАЁТ (преимущество)</div>
  <textarea name="system.benefit" class="item-textarea"
            placeholder="Что даёт талант...">{{system.benefit}}</textarea>
</div>

{{#if kingsPlateHtml}}
<div class="item-section">
  <div class="item-section-title">ЛАТЫ КОРОЛЯ</div>
  {{{kingsPlateHtml}}}
</div>
{{/if}}

{{#if bloodShieldHtml}}
<div class="item-section">
  <div class="item-section-title">КРОВАВЫЙ ЩИТ</div>
  {{{bloodShieldHtml}}}
</div>
{{/if}}

{{#if eternalWarHtml}}
<div class="item-section">
  <div class="item-section-title">ВЕЧНАЯ ВОЙНА</div>
  {{{eternalWarHtml}}}
</div>
{{/if}}
{{/if}}

{{!-- Способность --}}
{{#if (eq item.type "ability")}}
<div class="item-section">
  <div class="item-section-title">ПРЕИМУЩЕСТВО</div>
  <textarea name="system.benefit" class="item-textarea"
            placeholder="Что даёт способность...">{{system.benefit}}</textarea>
</div>
{{/if}}

{{!-- Мутация --}}
{{#if (eq item.type "mutation")}}
<div class="item-section">
  <div class="item-section-title">ЧТО ДАЁТ (описание)</div>
  <textarea name="system.benefit" class="item-textarea"
            placeholder="Что даёт мутация...">{{system.benefit}}</textarea>
</div>

{{!-- Субмутация (стр. 440): таблица берётся из текста выше, бросок d10 со
      сдвигом на ⅓Inf.b записывает одну строку в предмет. --}}
{{#if submutation}}
<div class="item-section pa-history">
  <div class="item-section-title">СУБМУТАЦИЯ</div>
  <div class="pa-hist-bar">
    <select class="sub-entry-select" title="Выбрать субмутацию вручную">
      <option value="">— субмутация —</option>
      {{#each submutation.entries as |e|}}
      <option value="{{e.key}}" {{#if e.selected}}selected{{/if}}>{{e.label}}{{#if e.blocked}} ✖{{/if}}</option>
      {{/each}}
    </select>
    <button type="button" class="pa-btn" data-action="subPick" title="Записать выбранную строку">Записать</button>
    {{#if submutation.rollable}}
    <button type="button" class="pa-btn" data-action="subRoll"
            title="Бросок d{{submutation.die}} по таблице субмутаций; сдвиг до ⅓Inf.b (окр.▼) вверх или вниз, если мутация не от Порчи за Провал"><i class="fas fa-dice-d10"></i> к{{submutation.die}} субмутация</button>
    {{else}}
    <button type="button" class="pa-btn" data-action="subRoll"
            title="Строка этой таблицы определяется покровителем персонажа">Определить по покровителю</button>
    {{/if}}
    {{#if submutation.name}}<button type="button" class="pa-btn pa-clear" data-action="subClear" title="Снять субмутацию"><i class="fas fa-times"></i></button>{{/if}}
  </div>

  {{#if submutation.name}}
  <div class="pa-hist-card">
    <div class="pa-hist-name">{{submutation.label}} — {{submutation.name}}{{#if submutation.godLabel}} ({{submutation.godLabel}}){{/if}}
      {{#if submutation.rollLine}}<span class="pa-hist-roll">{{submutation.rollLine}}</span>{{/if}}</div>
    <div class="pa-hist-desc">{{submutation.text}}</div>
  </div>
  {{else}}
  <div class="trait-fx-hint">Субмутация не определена. ✖ в списке — строка цвета враждебного Бога (Кхорн — Слаанеш, Тзинч — Нургл): по правилу книги её брать нельзя.</div>
  {{/if}}
</div>
{{/if}}
{{/if}}

{{!-- Ментальное расстройство --}}
{{#if (eq item.type "mentalDisorder")}}
<div class="item-section">
  <div class="item-section-title">ПАРАМЕТРЫ РАССТРОЙСТВА</div>
  <div class="weapon-row">
    <label class="wr-label">Тест</label>
    <select name="system.testChar" class="wr-select-sm">
      <option value="wp"  {{#if (eq system.testChar "wp")}}selected{{/if}}>W (Воля)</option>
      <option value="int" {{#if (eq system.testChar "int")}}selected{{/if}}>I (Интеллект)</option>
      <option value="per" {{#if (eq system.testChar "per")}}selected{{/if}}>P (Восприятие)</option>
      <option value="fel" {{#if (eq system.testChar "fel")}}selected{{/if}}>F (Товарищество)</option>
    </select>
    <label class="wr-label">Тест-мод</label>
    <input type="number" name="system.testMod" value="{{system.testMod}}" class="wr-input-xs"
           title="Модификатор к тесту расстройства (напр. +0, +10, −20)"/>
  </div>
  <div class="drug-stat-hint">Описание расстройства — в поле «Описание» ниже. Кнопка теста — на вкладке «Эффекты».</div>
</div>
{{/if}}

{{!-- Психосила --}}
{{#if (eq item.type "psychicPower")}}
<div class="item-section">
  <div class="item-section-title">СТАТЫ</div>
  <div class="weapon-row">
    <label class="wr-label">Цена</label>
    <input type="number" name="system.cost" value="{{system.cost}}" min="0" class="wr-input-xs"/>
  </div>
</div>
{{/if}}