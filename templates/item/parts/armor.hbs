{{> "systems/warhammer-dbc/templates/item/parts/infoguard.hbs"}}
{{#if armourHistory}}
<div class="item-section pa-history">
  <div class="item-section-title">ОСОБЕННОСТЬ КОМПЛЕКТА</div>
  <div class="pa-hist-bar">
    <select class="pa-table-select" title="Таблица особенностей">
      <option value="">— таблица —</option>
      {{#each armourHistory.tables as |t|}}<option value="{{t.key}}" {{#if t.selected}}selected{{/if}}>{{t.label}}</option>{{/each}}
    </select>
    <select class="pa-entry-select" title="Выбрать особенность вручную">
      <option value="">— особенность —</option>
      {{#each armourHistory.tables as |t|}}{{#if t.selected}}{{#each t.entries as |e|}}<option value="{{e.key}}" {{#if e.selected}}selected{{/if}}>{{e.label}}</option>{{/each}}{{/if}}{{/each}}
    </select>
    <button type="button" class="pa-btn pa-roll-table" data-action="paRollTable" title="1к5 — какая таблица используется"><i class="fas fa-dice-d6"></i> к5 таблица</button>
    <button type="button" class="pa-btn pa-roll-entry" data-action="paRollEntry" title="1к10 по выбранной таблице"><i class="fas fa-dice-d10"></i> к10 особенность</button>
    {{#if armourHistory.name}}<button type="button" class="pa-btn pa-clear" data-action="paClear" title="Снять особенность"><i class="fas fa-times"></i></button>{{/if}}
  </div>

  {{#if armourHistory.name}}
  <div class="pa-hist-card">
    <div class="pa-hist-name">{{armourHistory.name}}{{#if armourHistory.roll}} <span class="pa-hist-roll">к10 = {{armourHistory.roll}}</span>{{/if}}</div>
    <div class="pa-hist-desc">{{armourHistory.desc}}</div>
    <div class="pa-hist-effect">{{armourHistory.effect}}</div>
    {{#if armourHistory.needsChoice}}
    <div class="pa-hist-choice">
      <label>{{armourHistory.choiceLabel}}</label>
      <input type="text" class="pa-hist-choice-input" value="{{armourHistory.choice}}" placeholder="{{armourHistory.choicePlaceholder}}"/>
    </div>
    {{/if}}
    {{#if armourHistory.zoneRoll}}
    <div class="pa-hist-zones">
      <button type="button" class="pa-btn pa-roll-zones" data-action="paRollZones"><i class="fas fa-dice-d10"></i> Бросить к10 по зонам</button>
      {{#if armourHistory.hasZones}}
      <div class="pa-zone-list">
        {{#each armourHistory.zones as |z|}}<span class="pa-zone{{#if z.value}} pa-zone-set{{/if}}">{{z.label}}: {{#if z.value}}{{signedNum z.value}}{{else}}0{{/if}}</span>{{/each}}
      </div>
      {{/if}}
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{#if armourHistory.second}}
  <div class="pa-hist-card pa-hist-second">
    <div class="pa-hist-name">{{armourHistory.second.tableLabel}}: {{armourHistory.second.name}}</div>
    <div class="pa-hist-desc">{{armourHistory.second.desc}}</div>
    <div class="pa-hist-effect">{{armourHistory.second.effect}}</div>
  </div>
  {{/if}}

  <div class="pa-hist-rule">{{armourHistory.shiftRule}}</div>
</div>
{{/if}}
