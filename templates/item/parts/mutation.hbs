{{!-- ══════════════════════════════════════════════════════════════════════ --}}
{{!--  МУТАЦИЯ — только «Рука Смерти» (wdbc-hftn): выбор своего оружия для     --}}
{{!--  слияния, у остальных Мутаций пусто (isHandOfDeathItem проверяет имя).  --}}
{{!-- ══════════════════════════════════════════════════════════════════════ --}}
{{#if (eq item.type "mutation")}}

<div class="item-section">
  <div class="item-section-title">ПАРАМЕТРЫ МУТАЦИИ</div>
  <div class="weapon-row">
    <label class="wr-label">Книга</label>
    <input type="text" name="system.bookSource" value="{{system.bookSource}}"
           class="wr-input-md" placeholder="напр. Core, стр. 24"/>
  </div>
</div>

{{#if handOfDeathHtml}}
<div class="item-section">
  <div class="item-section-title">РУКА СМЕРТИ</div>
  {{{handOfDeathHtml}}}
</div>
{{/if}}

{{#if addictionHtml}}
<div class="item-section">
  <div class="item-section-title">ЗАВИСИМОСТЬ</div>
  {{{addictionHtml}}}
</div>
{{/if}}

{{#if vampiricHtml}}
<div class="item-section">
  <div class="item-section-title">ВАМПИРИЧЕСКАЯ ЗАВИСИМОСТЬ</div>
  {{{vampiricHtml}}}
</div>
{{/if}}

{{#if cancerousHealingHtml}}
<div class="item-section">
  <div class="item-section-title">РАКОВОЕ ИСЦЕЛЕНИЕ</div>
  {{{cancerousHealingHtml}}}
</div>
{{/if}}

{{#if flayedHtml}}
<div class="item-section">
  <div class="item-section-title">ОСВЕЖЁВАННЫЙ</div>
  {{{flayedHtml}}}
</div>
{{/if}}
{{/if}}{{!-- /mutation --}}
