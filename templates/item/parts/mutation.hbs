{{!-- ══════════════════════════════════════════════════════════════════════ --}}
{{!--  МУТАЦИЯ — «Рука Смерти» (wdbc-hftn) и «Щупальце»/субмутация 9         --}}
{{!--  (wdbc-2ynk) — выбор своего оружия/форма руки, у остальных Мутаций     --}}
{{!--  пусто (isHandOfDeathItem/isTentacleShiftItem проверяют имя+строку).   --}}
{{!-- ══════════════════════════════════════════════════════════════════════ --}}
{{#if (eq item.type "mutation")}}

<div class="item-section">
  <div class="item-section-title">ПАРАМЕТРЫ МУТАЦИИ</div>
  <div class="weapon-row">
    <label class="wr-label">Книга</label>
    <input type="text" name="system.bookSource" value="{{system.bookSource}}"
           class="wr-input-md" placeholder="напр. Core, стр. 24"/>
  </div>
</div>

{{#if handOfDeathHtml}}
<div class="item-section">
  <div class="item-section-title">РУКА СМЕРТИ</div>
  {{{handOfDeathHtml}}}
</div>
{{/if}}

{{#if tentacleHandFormHtml}}
<div class="item-section">
  <div class="item-section-title">ЩУПАЛЬЦЕ: ФОРМА</div>
  {{{tentacleHandFormHtml}}}
</div>
{{/if}}
{{/if}}{{!-- /mutation --}}
