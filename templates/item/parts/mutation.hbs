{{!-- ══════════════════════════════════════════════════════════════════════ --}}
{{!--  МУТАЦИЯ — блоки ниже показываются только у конкретных Мутаций по имени --}}
{{!--  (isHandOfDeathItem/isIllusionOfNormalityItem/isTentacleShiftItem),    --}}
{{!--  у остальных пусто:                                                    --}}
{{!--   • «Рука Смерти» (wdbc-hftn) — выбор своего оружия для слияния;        --}}
{{!--   • «Иллюзия Нормальности» (wdbc-zbc0) — обнаружение/раскрытие;         --}}
{{!--   • «Икона Богохульства» (wdbc-zbc0) — раз за бой/сцену проявление;     --}}
{{!--   • «Щупальце», субмутация 9 (wdbc-2ynk) — форма руки;                 --}}
{{!--   • «Зависимость»/«Вампирическая Зависимость» (wdbc-1rno) — состояние    --}}
{{!--     утоления по игровому времени, кнопка «Утолить».                     --}}
{{!-- ══════════════════════════════════════════════════════════════════════ --}}
{{#if (eq item.type "mutation")}}

<div class="item-section">
  <div class="item-section-title">ПАРАМЕТРЫ МУТАЦИИ</div>
  <div class="weapon-row">
    <label class="wr-label">Книга</label>
    <input type="text" name="system.bookSource" value="{{system.bookSource}}"
           class="wr-input-md" placeholder="напр. Core, стр. 24"/>
  </div>
</div>

{{#if handOfDeathHtml}}
<div class="item-section">
  <div class="item-section-title">РУКА СМЕРТИ</div>
  {{{handOfDeathHtml}}}
</div>
{{/if}}

{{#if illusionOfNormalityHtml}}
<div class="item-section">
  <div class="item-section-title">ИЛЛЮЗИЯ НОРМАЛЬНОСТИ</div>
  {{{illusionOfNormalityHtml}}}
</div>
{{/if}}

{{#if iconOfBlasphemyHtml}}
<div class="item-section">
  <div class="item-section-title">ИКОНА БОГОХУЛЬСТВА</div>
  {{{iconOfBlasphemyHtml}}}
</div>
{{/if}}

{{#if cancerousHealingHtml}}
<div class="item-section">
  <div class="item-section-title">РАКОВОЕ ИСЦЕЛЕНИЕ</div>
  {{{cancerousHealingHtml}}}
</div>
{{/if}}

{{#if flayedHtml}}
<div class="item-section">
  <div class="item-section-title">ОСВЕЖЁВАННЫЙ</div>
  {{{flayedHtml}}}
</div>
{{/if}}

{{#if tentacleHandFormHtml}}
<div class="item-section">
  <div class="item-section-title">ЩУПАЛЬЦЕ: ФОРМА</div>
  {{{tentacleHandFormHtml}}}
</div>
{{/if}}

{{#if addictionHtml}}
<div class="item-section">
  <div class="item-section-title">ЗАВИСИМОСТЬ</div>
  {{{addictionHtml}}}
</div>
{{/if}}

{{#if vampiricHtml}}
<div class="item-section">
  <div class="item-section-title">ВАМПИРИЧЕСКАЯ ЗАВИСИМОСТЬ</div>
  {{{vampiricHtml}}}
</div>
{{/if}}
{{/if}}{{!-- /mutation --}}
