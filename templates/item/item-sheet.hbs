<form class="warhammer-dbc item-sheet {{item.type}}-sheet" autocomplete="off">

  <header class="item-sheet-header">
    <img class="profile-img item-img" src="{{item.img}}"
         data-edit="img" title="{{item.name}}"/>
    <div class="item-header-info">
      <label class="item-name-label">Название</label>
      <input name="name" type="text" value="{{item.name}}"
             placeholder="Название предмета" class="item-name-input"/>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="item-primary">
    <a class="item active" data-tab="info">ИНФО</a>
    <a class="item" data-tab="effects">ЭФФЕКТЫ{{#if itemEffects.length}} <span class="effects-tab-count">{{itemEffects.length}}</span>{{/if}}</a>
    <a class="item" data-tab="mechanics">МЕХАНИКА{{#if itemMechGroups.length}} <span class="effects-tab-count">{{itemMechGroups.length}}</span>{{/if}}</a>
    <a class="item" data-tab="notes">ЗАПИСИ</a>
  </nav>

  <div class="sheet-body">

    <div class="tab active" data-tab="info" data-group="item-primary">

{{#if (eq item.type "weapon")}}
{{> "systems/warhammer-dbc/templates/item/parts/weapon.hbs"}}
{{/if}}
{{#if (eq item.type "weaponMod")}}
{{> "systems/warhammer-dbc/templates/item/parts/weapon.hbs"}}
{{/if}}
{{#if (eq item.type "ammo")}}
{{> "systems/warhammer-dbc/templates/item/parts/ammo.hbs"}}
{{/if}}
{{#if (eq item.type "armor")}}
{{> "systems/warhammer-dbc/templates/item/parts/armor.hbs"}}
{{/if}}
{{#if (eq item.type "armorMod")}}
{{> "systems/warhammer-dbc/templates/item/parts/armor.hbs"}}
{{/if}}
{{#if (eq item.type "forcefield")}}
{{> "systems/warhammer-dbc/templates/item/parts/shield.hbs"}}
{{/if}}
{{#if (eq item.type "drug")}}
{{> "systems/warhammer-dbc/templates/item/parts/drug.hbs"}}
{{/if}}
{{#if (eq item.type "gear")}}
{{> "systems/warhammer-dbc/templates/item/parts/gear.hbs"}}
{{/if}}
{{#if (eq item.type "tool")}}
{{> "systems/warhammer-dbc/templates/item/parts/gear.hbs"}}
{{/if}}
{{#if (eq item.type "cybernetic")}}
{{> "systems/warhammer-dbc/templates/item/parts/gear.hbs"}}
{{/if}}
{{#if (eq item.type "talent")}}
{{> "systems/warhammer-dbc/templates/item/parts/talent.hbs"}}
{{/if}}
{{#if (eq item.type "ritual")}}
{{> "systems/warhammer-dbc/templates/item/parts/ritual.hbs"}}
{{/if}}
{{#if (eq item.type "ability")}}
{{> "systems/warhammer-dbc/templates/item/parts/talent.hbs"}}
{{/if}}
{{#if (eq item.type "mutation")}}
{{> "systems/warhammer-dbc/templates/item/parts/talent.hbs"}}
{{/if}}
{{#if (eq item.type "mentalDisorder")}}
{{> "systems/warhammer-dbc/templates/item/parts/talent.hbs"}}
{{/if}}
{{#if (eq item.type "trait")}}
{{> "systems/warhammer-dbc/templates/item/parts/trait.hbs"}}
{{/if}}
{{#if (eq item.type "implant")}}
{{> "systems/warhammer-dbc/templates/item/parts/implant.hbs"}}
{{/if}}
{{#if (eq item.type "psychicPower")}}
{{> "systems/warhammer-dbc/templates/item/parts/psychic-power.hbs"}}
{{/if}}
{{#if (eq item.type "techPower")}}
{{> "systems/warhammer-dbc/templates/item/parts/tech-power.hbs"}}
{{/if}}
{{#if (eq item.type "navigatorPower")}}
{{> "systems/warhammer-dbc/templates/item/parts/navigator-power.hbs"}}
{{/if}}
{{#if (eq item.type "component")}}
{{> "systems/warhammer-dbc/templates/item/parts/component.hbs"}}
{{/if}}
{{#if (eq item.type "cargo")}}
