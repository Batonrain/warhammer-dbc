
<header class="item-sheet-header">
  {{!-- Картинку меняет штатное действие ApplicationV2: одного data-edit мало,
        у V2 клик разбирается по data-action, и без него аватар не открывался. --}}
  <img class="profile-img item-img" src="{{item.img}}"
       data-action="editImage" data-edit="img" title="Сменить картинку: {{item.name}}"/>
  <div class="item-header-info">
    <label class="item-name-label">Название</label>
    <input name="name" type="text" value="{{item.name}}"
           placeholder="Название предмета" class="item-name-input"/>
  </div>
</header>

{{!-- Навигация не собирается циклом по TABS: у двух вкладок в подписи счётчик. --}}
<nav class="sheet-tabs tabs" data-group="item-primary">
  <a class="item {{#if (eq tab "info")}}active{{/if}}" data-action="tab" data-group="item-primary" data-tab="info">ИНФО</a>
  <a class="item {{#if (eq tab "effects")}}active{{/if}}" data-action="tab" data-group="item-primary" data-tab="effects">ЭФФЕКТЫ{{#if itemEffects.length}} <span class="effects-tab-count">{{itemEffects.length}}</span>{{/if}}</a>
  <a class="item {{#if (eq tab "mechanics")}}active{{/if}}" data-action="tab" data-group="item-primary" data-tab="mechanics">МЕХАНИКА{{#if itemMechGroups.length}} <span class="effects-tab-count">{{itemMechGroups.length}}</span>{{/if}}</a>
  {{#if (eq item.type "faction")}}<a class="item {{#if (eq tab "roster")}}active{{/if}}" data-action="tab" data-group="item-primary" data-tab="roster">СОСТАВ</a>{{/if}}
  <a class="item {{#if (eq tab "notes")}}active{{/if}}" data-action="tab" data-group="item-primary" data-tab="notes">ЗАПИСИ</a>
</nav>

